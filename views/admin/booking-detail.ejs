<div class="admin-header">
  <div>
    <a href="/admin/bookings" style="font-size: 12px; color: var(--smoke); display: inline-flex; align-items: center; gap: 6px; margin-bottom: 8px;">← Quay lại</a>
    <h1><%= booking.booking_code %></h1>
  </div>
  <span class="badge badge-<%= booking.status %>" style="font-size: 12px; padding: 6px 16px;"><%= booking.status %></span>
</div>

<div style="display: grid; grid-template-columns: 1fr 380px; gap: 24px; align-items: start;">

  <!-- Detail -->
  <div>
    <div class="admin-card">
      <h2>Thông tin đặt lịch</h2>
      <table>
        <tr><td style="color: var(--smoke); width: 160px;">Khách hàng</td><td><strong><%= booking.customer_name %></strong></td></tr>
        <tr><td style="color: var(--smoke);">Điện thoại</td><td><a href="tel:<%= booking.customer_phone %>"><%= booking.customer_phone %></a></td></tr>
        <tr><td style="color: var(--smoke);">Email</td><td><%= booking.customer_email || '—' %></td></tr>
        <tr><td style="color: var(--smoke);">Dịch vụ</td><td><%= booking.service_name || '—' %></td></tr>
        <tr><td style="color: var(--smoke);">Ngày mong muốn</td><td><strong><%= new Date(booking.preferred_date).toLocaleDateString('vi-VN', {weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'}) %></strong></td></tr>
        <tr><td style="color: var(--smoke);">Ngày dự phòng</td><td><%= booking.backup_date ? new Date(booking.backup_date).toLocaleDateString('vi-VN') : '—' %></td></tr>
        <tr><td style="color: var(--smoke);">Khung giờ</td><td><%= booking.preferred_time || '—' %></td></tr>
        <tr><td style="color: var(--smoke);">Hình thức</td><td><%= booking.location_type === 'studio' ? 'Studio' : booking.location_type === 'outdoor' ? 'Ngoại cảnh' : 'Cả hai' %></td></tr>
        <% if (booking.location_note) { %>
        <tr><td style="color: var(--smoke);">Địa điểm</td><td><%= booking.location_note %></td></tr>
        <% } %>
        <tr><td style="color: var(--smoke);">Đặt lúc</td><td><%= new Date(booking.created_at).toLocaleString('vi-VN') %></td></tr>
      </table>

      <% if (booking.message) { %>
        <div style="margin-top: 24px; padding-top: 24px; border-top: 0.5px solid var(--bone);">
          <p class="form-label" style="margin-bottom: 8px;">Lời nhắn</p>
          <p style="font-size: 14px; font-weight: 300; color: var(--smoke); line-height: 1.7;"><%= booking.message %></p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Update status -->
  <div>
    <div class="admin-card">
      <h2>Cập nhật trạng thái</h2>
      <form method="POST" action="/admin/bookings/<%= booking.id %>/update">
        <div class="form-group-admin">
          <label class="form-label">Trạng thái</label>
          <select name="status" class="form-control">
            <option value="pending" <%= booking.status === 'pending' ? 'selected' : '' %>>Chờ xác nhận</option>
            <option value="confirmed" <%= booking.status === 'confirmed' ? 'selected' : '' %>>Đã xác nhận</option>
            <option value="completed" <%= booking.status === 'completed' ? 'selected' : '' %>>Hoàn thành</option>
            <option value="cancelled" <%= booking.status === 'cancelled' ? 'selected' : '' %>>Đã huỷ</option>
          </select>
        </div>
        <div class="form-group-admin">
          <label class="form-label">Ghi chú admin</label>
          <textarea name="admin_note" class="form-control" rows="4" style="resize: vertical; border: 1px solid var(--bone); padding: 10px; width: 100%;"><%= booking.admin_note || '' %></textarea>
        </div>
        <button type="submit" class="btn-sm btn-sm-dark" style="width: 100%; padding: 12px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; border: none;">Lưu thay đổi</button>
      </form>
    </div>
  </div>

</div>
