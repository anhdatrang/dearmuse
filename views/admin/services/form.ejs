<!-- views/admin/services/form.ejs -->
<style>
  .form-container {
    max-width: 900px;
    margin: 0 auto;
  }
  .form-header {
    margin-bottom: 32px;
  }
  .form-header a {
    color: var(--smoke);
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
  }
  .form-header h2 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
  }
  
  .editor-section-title {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--smoke);
    border-bottom: 0.5px solid var(--bone);
    padding-bottom: 8px;
    margin-top: 40px;
    margin-bottom: 20px;
  }
  
  /* Gallery Styles */
  .gallery-thumbnails {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
    margin-bottom: 16px;
  }
  .gallery-thumb-item {
    position: relative;
    width: 100px;
    height: 100px;
    border: 0.5px solid var(--bone);
    background: #e2e8f0;
  }
  .gallery-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .btn-remove-thumb {
    position: absolute;
    top: 4px;
    right: 4px;
    background: rgba(220, 38, 38, 0.85);
    color: white;
    border: none;
    width: 18px;
    height: 18px;
    font-size: 10px;
    line-height: 18px;
    text-align: center;
    cursor: pointer;
    border-radius: 2px;
    padding: 0;
  }
  .btn-remove-thumb:hover {
    background: rgb(220, 38, 38);
  }
  
  /* Pricing Package Styles */
  .package-editor-card {
    background: var(--vanilla);
    border: 0.5px solid var(--bone);
    padding: 24px;
    margin-bottom: 20px;
    position: relative;
  }
  .btn-remove-package {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: #dc2626;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }
  
  /* Addons Styles */
  .addon-editor-row {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 12px;
  }
  .addon-editor-row .form-control {
    margin-bottom: 0;
  }
  .btn-remove-addon {
    background: none;
    border: none;
    color: #dc2626;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .btn-add-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--mocha);
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 0;
    margin-bottom: 16px;
  }
  .btn-add-more:hover {
    color: var(--ink);
  }
</style>

<div class="form-container">
  <div class="form-header">
    <a href="/admin/services">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></polyline><polyline points="12 19 5 12 12 5"></polyline></svg>
      Quay lại danh sách
    </a>
    <h2><%= isEdit ? 'Chỉnh Sửa Concept / Gói Dịch Vụ' : 'Thêm Concept Mới' %></h2>
  </div>

  <div class="admin-card">
    <form action="<%= isEdit ? `/admin/services/${service.id}/edit` : '/admin/services/create' %>" method="POST" enctype="multipart/form-data">
      
      <h3 class="editor-section-title" style="margin-top: 0;">Thông tin cơ bản</h3>
      
      <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div class="form-group-admin">
          <label class="form-label" for="nameInput">Tên Concept *</label>
          <input type="text" class="form-control" name="name" id="nameInput" value="<%= service.name || '' %>" placeholder="Ví dụ: Event Basic" required>
        </div>
        
        <div class="form-group-admin">
          <label class="form-label" for="slugInput">Slug (URL) *</label>
          <input type="text" class="form-control" name="slug" id="slugInput" value="<%= service.slug || '' %>" placeholder="Ví dụ: event-basic" required>
        </div>
      </div>

      <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div class="form-group-admin">
          <label class="form-label" for="categorySelect">Danh Mục Dịch Vụ *</label>
          <select class="form-control" name="category" id="categorySelect" required>
            <option value="ca-nhan" <%= service.category === 'ca-nhan' ? 'selected' : '' %>>Cá Nhân (Personal)</option>
            <option value="doanh-nghiep" <%= service.category === 'doanh-nghiep' ? 'selected' : '' %>>Doanh Nghiệp (Business)</option>
            <option value="mo-rong" <%= service.category === 'mo-rong' ? 'selected' : '' %>>Mở Rộng (Expansion)</option>
          </select>
          <input type="hidden" name="category_label" id="categoryLabelInput" value="<%= service.category_label || 'Cá Nhân' %>">
        </div>
        
        <div class="form-group-admin">
          <label class="form-label" for="subtitleInput">Phụ Đề / Mô Tả Ngắn</label>
          <input type="text" class="form-control" name="subtitle" id="subtitleInput" value="<%= service.subtitle || service.short_desc || '' %>" placeholder="Ví dụ: Nâng tầm thương hiệu & sự kiện chuyên nghiệp">
        </div>
      </div>

      <div class="form-group-admin">
        <label class="form-label" for="descriptionInput">Mô Tả Chi Tiết Concept</label>
        <textarea class="form-control" name="description" id="descriptionInput" rows="4" placeholder="Nhập mô tả chi tiết giới thiệu về ý tưởng, phong cách của concept..." style="resize: vertical; min-height: 100px;"><%= service.description || '' %></textarea>
      </div>

      <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
        <div class="form-group-admin">
          <label class="form-label" for="priceFromInput">Giá Hiển Thị Từ (VNĐ) *</label>
          <input type="number" class="form-control" name="price_from" id="priceFromInput" value="<%= service.price_from || 0 %>" placeholder="Ví dụ: 1500000" required>
        </div>
        
        <div class="form-group-admin">
          <label class="form-label" for="durationInput">Thời Lượng Chụp (Phút)</label>
          <input type="number" class="form-control" name="duration_minutes" id="durationInput" value="<%= service.duration_minutes || 90 %>" placeholder="Ví dụ: 90">
        </div>

        <div class="form-group-admin">
          <label class="form-label" for="sortOrderInput">Thứ Tự Sắp Xếp</label>
          <input type="number" class="form-control" name="sort_order" id="sortOrderInput" value="<%= service.sort_order || 0 %>" placeholder="Ví dụ: 1">
        </div>
      </div>

      <div class="form-group-admin" style="margin-top: 10px;">
        <label class="form-label" style="display: inline-flex; align-items: center; gap: 8px; cursor: pointer; text-transform: none;">
          <input type="checkbox" name="is_featured" value="1" <%= service.is_featured ? 'checked' : '' %> style="width: 16px; height: 16px; accent-color: var(--ink);">
          <span>Hiển thị nổi bật trên trang chủ / trang giá</span>
        </label>
      </div>

      <h3 class="editor-section-title">Hình ảnh Concept</h3>

      <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div class="form-group-admin">
          <label class="form-label">Ảnh Bìa Concept (Cover Image)</label>
          <input type="file" class="form-control" name="cover_image" accept="image/*">
          <% if (service.cover_image) { %>
            <div style="margin-top: 12px;">
              <p class="form-label" style="font-size: 9px; margin-bottom: 4px;">Ảnh hiện tại:</p>
              <img src="<%= service.cover_image %>" alt="Cover" style="height: 100px; object-fit: cover; border: 0.5px solid var(--bone);">
            </div>
          <% } %>
        </div>

        <div class="form-group-admin">
          <label class="form-label">Tải Lên Thêm Ảnh Gallery (Chọn nhiều)</label>
          <input type="file" class="form-control" name="gallery_images" multiple accept="image/*">
          <div class="form-text" style="font-size: 11px; color: var(--smoke); margin-top: 4px;">Chọn một hoặc nhiều ảnh thực tế của concept để hiển thị trên slider album chi tiết.</div>
        </div>
      </div>

      <!-- Existing Gallery Manager -->
      <% if (service.gallery && service.gallery.length > 0) { %>
        <div class="form-group-admin">
          <label class="form-label">Bộ Sưu Tập Hiện Tại (Gallery - <%= service.gallery.length %> ảnh)</label>
          <p class="form-text" style="font-size: 11px; color: var(--smoke); margin-top: -4px; margin-bottom: 12px;">Nhấp vào nút "Xóa" trên từng ảnh để gỡ ảnh đó khỏi gallery. Đừng quên bấm "Lưu Dữ Liệu" ở dưới để áp dụng thay đổi.</p>
          <div class="gallery-thumbnails">
            <% service.gallery.forEach(img => { %>
              <div class="gallery-thumb-item">
                <img src="<%= img %>" alt="Gallery photo">
                <input type="hidden" name="keep_gallery[]" value="<%= img %>">
                <button type="button" class="btn-remove-thumb" onclick="this.parentElement.remove()" title="Xóa khỏi gallery">&times;</button>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <h3 class="editor-section-title">Các Gói Giá Dịch Vụ (Pricing Packages)</h3>
      <p class="form-text" style="font-size: 12px; color: var(--smoke); margin-top: -12px; margin-bottom: 20px;">
        Các gói chụp chi tiết trong concept này. Nội dung dịch vụ ghi mỗi dòng tương ứng với một gạch đầu dòng.
      </p>

      <div id="packagesContainer">
        <% if (service.pricing && service.pricing.length > 0) { %>
          <% service.pricing.forEach((pkg, index) => { %>
            <div class="package-editor-card" id="pkg-card-<%= index %>">
              <button type="button" class="btn-remove-package" onclick="document.getElementById('pkg-card-<%= index %>').remove()">Xóa gói chụp</button>
              
              <input type="hidden" name="pricing_id[]" value="pkg_<%= index %>">
              <input type="hidden" name="pricing_gallery_json[]" value="<%= JSON.stringify(pkg.gallery || []) %>" class="pkg-gallery-json">

              <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 16px;">
                <div>
                  <label class="form-label">Tên gói chụp *</label>
                  <input type="text" class="form-control" name="pricing_name[]" value="<%= pkg.packageName %>" placeholder="Ví dụ: Gói Gold (Nửa Ngày)" style="margin-bottom: 0;" required>
                </div>
                <div>
                  <label class="form-label">Giá gói hiển thị *</label>
                  <input type="text" class="form-control" name="pricing_price[]" value="<%= pkg.price %>" placeholder="Ví dụ: 6.000.000đ" style="margin-bottom: 0;" required>
                </div>
              </div>
              
              <div style="margin-bottom: 16px;">
                <label class="form-label">Nội dung dịch vụ bao gồm (Mỗi gạch đầu dòng một dòng riêng)</label>
                <textarea class="form-control" name="pricing_inclusions[]" rows="5" placeholder="Ví dụ:&#10;2 Nhiếp ảnh gia chuyên nghiệp&#10;Hệ thống đèn studio chiếu sáng&#10;Bàn giao toàn bộ file ảnh gốc&#10;Retouch nghệ thuật 60 ảnh chân dung" style="margin-bottom: 0;"><%= pkg.inclusions ? pkg.inclusions.join('\n') : '' %></textarea>
              </div>

              <div>
                <label class="form-label">Bộ sưu tập ảnh mẫu riêng của gói này (Gallery)</label>
                <div class="gallery-thumbnails package-gallery-thumbnails" style="margin-top: 8px;">
                  <% if (pkg.gallery && pkg.gallery.length > 0) { %>
                    <% pkg.gallery.forEach(img => { %>
                      <div class="gallery-thumb-item" style="width: 80px; height: 80px;">
                        <img src="<%= img %>" alt="Package Photo">
                        <button type="button" class="btn-remove-thumb" onclick="removePkgImage(this, '<%= img %>')" title="Xóa khỏi gallery">&times;</button>
                      </div>
                    <% }) %>
                  <% } %>
                </div>
                <div style="margin-top: 8px;">
                  <input type="file" class="form-control" name="package_files_pkg_<%= index %>" multiple accept="image/*">
                  <div class="form-text" style="font-size: 11px; color: var(--smoke); margin-top: 4px;">Tải lên thêm ảnh mẫu cho gói này. Ảnh đầu tiên của gói sẽ làm ảnh bìa gói.</div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <!-- Default empty package if new -->
          <div class="package-editor-card" id="pkg-card-0">
            <button type="button" class="btn-remove-package" onclick="this.parentElement.remove()">Xóa gói chụp</button>
            
            <input type="hidden" name="pricing_id[]" value="pkg_0">
            <input type="hidden" name="pricing_gallery_json[]" value="[]" class="pkg-gallery-json">

            <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 16px;">
              <div>
                <label class="form-label">Tên gói chụp *</label>
                <input type="text" class="form-control" name="pricing_name[]" placeholder="Ví dụ: Gói Basic (90 Phút)" style="margin-bottom: 0;" required>
              </div>
              <div>
                <label class="form-label">Giá gói hiển thị *</label>
                <input type="text" class="form-control" name="pricing_price[]" placeholder="Ví dụ: 1.800.000đ" style="margin-bottom: 0;" required>
              </div>
            </div>
            
            <div style="margin-bottom: 16px;">
              <label class="form-label">Nội dung dịch vụ bao gồm (Mỗi gạch đầu dòng một dòng riêng)</label>
              <textarea class="form-control" name="pricing_inclusions[]" rows="5" placeholder="Ví dụ:&#10;90 phút chụp chuyên nghiệp&#10;Tư vấn concept & trang phục&#10;Retouch nghệ thuật 15 hình&#10;Bàn giao toàn bộ file ảnh gốc" style="margin-bottom: 0;"></textarea>
            </div>

            <div>
              <label class="form-label">Bộ sưu tập ảnh mẫu riêng của gói này (Gallery)</label>
              <div class="gallery-thumbnails package-gallery-thumbnails" style="margin-top: 8px;"></div>
              <div style="margin-top: 8px;">
                <input type="file" class="form-control" name="package_files_pkg_0" multiple accept="image/*">
                <div class="form-text" style="font-size: 11px; color: var(--smoke); margin-top: 4px;">Tải lên ảnh mẫu cho gói này. Ảnh đầu tiên của gói sẽ làm ảnh bìa gói.</div>
              </div>
            </div>
          </div>
        <% } %>
      </div>

      <button type="button" class="btn-add-more" onclick="addPackage()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Thêm Gói Chụp Mới
      </button>

      <h3 class="editor-section-title">Tiện ích đi kèm (Addons - Tùy chọn)</h3>
      
      <div id="addonsContainer" style="margin-bottom: 8px;">
        <% if (service.addons && service.addons.length > 0) { %>
          <% service.addons.forEach((addon, index) => { %>
            <div class="addon-editor-row" id="addon-row-<%= index %>">
              <input type="text" class="form-control" name="addon_name[]" value="<%= addon.name %>" placeholder="Tên tiện ích (Ví dụ: Chụp thêm giờ ngoài gói)" required>
              <input type="text" class="form-control" name="addon_price[]" value="<%= addon.price %>" placeholder="Giá (Ví dụ: 600.000đ / giờ)" style="max-width: 250px;" required>
              <button type="button" class="btn-remove-addon" onclick="document.getElementById('addon-row-<%= index %>').remove()" title="Xóa tiện ích">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
            </div>
          <% }) %>
        <% } %>
      </div>

      <button type="button" class="btn-add-more" onclick="addAddon()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Thêm Tiện Ích Mới
      </button>

      <hr style="border: none; border-top: 0.5px solid var(--bone); margin: 32px 0;">

      <div class="form-actions" style="display: flex; justify-content: flex-end; gap: 16px;">
        <a href="/admin/services" class="btn-sm" style="display: inline-flex; align-items: center; justify-content: center; height: 38px; line-height: 24px;">Hủy bỏ</a>
        <button type="submit" class="btn-sm btn-sm-dark" style="height: 38px; padding: 0 28px;">Lưu Dữ Liệu</button>
      </div>

    </form>
  </div>
</div>

<script>
  // Tự động đồng bộ category label khi đổi category select
  document.getElementById('categorySelect').addEventListener('change', function() {
    const val = this.value;
    const labelInput = document.getElementById('categoryLabelInput');
    if (val === 'ca-nhan') labelInput.value = 'Cá Nhân';
    else if (val === 'doanh-nghiep') labelInput.value = 'Doanh Nghiệp';
    else if (val === 'mo-rong') labelInput.value = 'Mở Rộng';
  });

  // Tự động gợi ý slug từ tên concept khi tạo mới
  <% if (!isEdit) { %>
    document.getElementById('nameInput').addEventListener('input', function () {
      let name = this.value;
      let slug = name.toLowerCase()
        .replace(/á|à|ả|ạ|ã|ă|ắ|ằ|ẳ|ẵ|ặ|â|ấ|ầ|ẩ|ẫ|ậ/gi, 'a')
        .replace(/é|è|ẻ|ẽ|ẹ|ê|ế|ề|ể|ễ|ệ/gi, 'e')
        .replace(/i|í|ì|ỉ|ĩ|ị/gi, 'i')
        .replace(/ó|ò|ỏ|õ|ọ|ô|ố|ồ|ổ|ỗ|ộ|ơ|ớ|ờ|ở|ỡ|ợ/gi, 'o')
        .replace(/ú|ù|ủ|ũ|ụ|ư|ứ|ừ|ử|ữ|ự/gi, 'u')
        .replace(/ý|ỳ|ỷ|ỹ|ỵ/gi, 'y')
        .replace(/đ/gi, 'd')
        .replace(/\s+/g, '-')
        .replace(/[^a-z0-9\-]/g, '')
        .replace(/\-+/g, '-')
        .replace(/^-+|-+$/g, '');
      
      document.getElementById('slugInput').value = slug;
    });
  <% } %>

  // Hàm xóa ảnh mẫu của gói chụp con khỏi JSON và giao diện
  function removePkgImage(btn, imgPath) {
    const card = btn.closest('.package-editor-card');
    const jsonInput = card.querySelector('.pkg-gallery-json');
    let gallery = [];
    try {
      gallery = JSON.parse(jsonInput.value);
    } catch (e) {
      gallery = [];
    }
    gallery = gallery.filter(img => img !== imgPath);
    jsonInput.value = JSON.stringify(gallery);
    btn.parentElement.remove();
  }

  // Hàm thêm gói chụp mới động
  let pkgCounter = <%= (service.pricing ? service.pricing.length : 1) %>;
  function addPackage() {
    const container = document.getElementById('packagesContainer');
    const pkgId = `pkg_new_${Date.now()}_${Math.floor(Math.random() * 1000)}`;
    const newId = `pkg-card-${pkgCounter++}`;
    
    const card = document.createElement('div');
    card.className = 'package-editor-card';
    card.id = newId;
    card.innerHTML = `
      <button type="button" class="btn-remove-package" onclick="document.getElementById('${newId}').remove()">Xóa gói chụp</button>
      
      <input type="hidden" name="pricing_id[]" value="${pkgId}">
      <input type="hidden" name="pricing_gallery_json[]" value="[]" class="pkg-gallery-json">

      <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 16px;">
        <div>
          <label class="form-label">Tên gói chụp *</label>
          <input type="text" class="form-control" name="pricing_name[]" placeholder="Ví dụ: Gói Premium" style="margin-bottom: 0;" required>
        </div>
        <div>
          <label class="form-label">Giá gói hiển thị *</label>
          <input type="text" class="form-control" name="pricing_price[]" placeholder="Ví dụ: 3.500.000đ" style="margin-bottom: 0;" required>
        </div>
      </div>
      
      <div style="margin-bottom: 16px;">
        <label class="form-label">Nội dung dịch vụ bao gồm (Mỗi gạch đầu dòng một dòng riêng)</label>
        <textarea class="form-control" name="pricing_inclusions[]" rows="5" placeholder="Nhập các quyền lợi, mỗi gạch đầu dòng viết một dòng mới..." style="margin-bottom: 0;"></textarea>
      </div>

      <div>
        <label class="form-label">Bộ sưu tập ảnh mẫu riêng của gói này (Gallery)</label>
        <div class="gallery-thumbnails package-gallery-thumbnails" style="margin-top: 8px;"></div>
        <div style="margin-top: 8px;">
          <input type="file" class="form-control" name="package_files_${pkgId}" multiple accept="image/*">
          <div class="form-text" style="font-size: 11px; color: var(--smoke); margin-top: 4px;">Tải lên ảnh mẫu cho gói này. Ảnh đầu tiên của gói sẽ làm ảnh bìa gói.</div>
        </div>
      </div>
    `;
    container.appendChild(card);
  }

  // Hàm thêm tiện ích addon mới động
  let addonCounter = <%= (service.addons ? service.addons.length : 0) %>;
  function addAddon() {
    const container = document.getElementById('addonsContainer');
    const newId = `addon-row-${addonCounter++}`;
    
    const row = document.createElement('div');
    row.className = 'addon-editor-row';
    row.id = newId;
