<div class="admin-header">
  <h1>Lịch sử Email</h1>
</div>

<% if (typeof success !== 'undefined' && success.length > 0) { %>
  <div style="background: #dcfce7; color: #166534; padding: 16px; border-radius: 4px; margin-bottom: 24px; font-size: 14px;">
    <%= success %>
  </div>
<% } %>

<div class="admin-card" style="padding: 0;">
  <% if (history && history.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Người nhận</th>
          <th>Tiêu đề</th>
          <th>Trạng thái</th>
          <th>Ngày gửi</th>
        </tr>
      </thead>
      <tbody>
        <% history.forEach(item => { %>
          <tr>
            <td>
              <div style="font-weight: 400"><%= item.recipient %></div>
            </td>
            <td style="font-size: 13px; max-width: 300px;"><%= item.subject %></td>
            <td>
              <% if (item.status === 'sent') { %>
                <span class="badge badge-confirmed">Thành công</span>
              <% } else { %>
                <span class="badge badge-cancelled">Thất bại</span>
              <% } %>
            </td>
            <td style="font-size: 12px; color: var(--smoke); white-space: nowrap;"><%= new Date(item.sent_at).toLocaleString('vi-VN') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="empty-state">Chưa có lịch sử gửi email nào.</div>
  <% } %>
</div>
