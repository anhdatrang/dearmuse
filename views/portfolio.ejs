<% pageCss='portfolio.css' ; %>

  <!-- Editorial Hero -->
  <section class="portfolio-hero">
    <div class="portfolio-hero-bg">
      <img src="/cdn/image?w=1920&src=%2Fsource%2FC%C3%81%20NH%C3%82N%2FCONCEPT%2FSU207836(1).webp"
        alt="Portfolio Background" fetchpriority="high" decoding="async">
    </div>
    <div class="portfolio-hero-content reveal">
      <h1>Portfolio</h1>
      <p>Khám phá các tác phẩm</p>
    </div>
  </section>

  <!-- Portfolio Content -->
  <section style="padding: 80px 0 var(--section-gap); background: var(--bone);">
    <div class="container portfolio-container-wide">

      <!-- Luxury Filters -->
      <div class="portfolio-filters reveal" data-delay="1">
        <a href="/portfolio" class="filter-btn <%= activeCategory === 'all' ? 'active' : '' %>">Tất cả</a>
        <a href="/portfolio?category=ca-nhan" class="filter-btn <%= activeCategory === 'ca-nhan' ? 'active' : '' %>">Cá
          Nhân</a>
        <a href="/portfolio?category=doanh-nghiep"
          class="filter-btn <%= activeCategory === 'doanh-nghiep' ? 'active' : '' %>">Doanh Nghiệp</a>
        <a href="/portfolio?category=mo-rong" class="filter-btn <%= activeCategory === 'mo-rong' ? 'active' : '' %>">Mở
          Rộng</a>
      </div>

      <!-- Magazine Editorial Container -->
      <div class="magazine-container">
        <% var globalIssueCount = 0; %>
        <% magazineGroups.forEach(function(group, groupIndex) { %>
          <% 
            // Group images into chunks of 6
            var chunks=[]; 
            var chunkSize=10; 
            for (var i=0; i < group.images.length; i+=chunkSize) { 
              chunks.push(group.images.slice(i, i + chunkSize)); 
            } 
          %>

            <% chunks.forEach(function(chunk, chunkIndex) { %>
              <% var textData = editorialContents[globalIssueCount % editorialContents.length]; %>
              <!-- Magazine Issue Block (6-Page Spread Set) -->
              <div class="magazine-issue reveal" data-delay="1">
                <div class="magazine-book-wrap">

                  <!-- ROW 1: COVER (1 page) + EDITORIAL I (2 pages) -->
                  <div class="magazine-row-1">
                    <!-- SPREAD 1: COVER (Left) -->
                    <div class="magazine-grid cover-grid">
                      <!-- PAGE 1: COVER (FULL-BLEED PHOTO) -->
                      <div class="magazine-page m-page-cover">
                        <!-- Cover Full Background Image -->
                        <div class="cover-full-bg">
                          <img src="<%= chunk[0].src %>" alt="<%= chunk[0].alt %>" loading="lazy" decoding="async">
                        </div>

                        <!-- Cover Content Overlay -->
                        <div class="cover-overlay-content">
                          <div class="cover-header">
                            <span class="cover-subtitle" style="letter-spacing: 0.25em; color: #000000 !important; font-weight: 900 !important;">FINE ART & EDITORIAL
                              EXCELLENCE</span>
                            <h2 class="cover-title">DEAR MUSÉ</h2>
                            <div class="cover-meta">
                              <% var metaColor = (globalIssueCount === 2 || globalIssueCount === 4 || group.id === 'doanh-nghiep') ? '#FFFFFF' : '#000000'; %>
                              <span style="font-weight:700; color:<%= metaColor %>;">THE BEST PORTRAIT
                                STUDIO</span>
                              <span style="font-weight:700; color:<%= metaColor %>;">dearmuse.vn</span>
                            </div>
                          </div>

                          <div class="cover-body">
                            <div class="cover-center-content">
                              <div class="sunken-title-wrapper">
                                <div class="sunken-bg-text">
                                  <%= group.englishTitle %>
                                </div>
                              </div>
                            </div>
                          </div>

                          <div class="cover-footer">
                            <% var labelColor = (group.id === 'mo-rong') ? '#FFFFFF' : '#000000'; %>
                            <span class="concept-label" style="color: <%= labelColor %> !important; font-weight: 900 !important;">MASTERPIECE COLLECTION</span>
                            <h3 class="concept-name" style="color: var(--logo-mocha, #8B7355) !important; font-weight: 900 !important; text-shadow: 2px 2px 5px rgba(0,0,0,0.4), -1px -1px 2px rgba(255,255,255,0.7) !important;">
                              <%= group.title %>
                            </h3>
                          </div>
                        </div>
                      </div>
                    </div><!-- /.cover-grid -->

                    <!-- SPREAD 2: EDITORIAL CONTENT I (Right - Page 2 & Page 3 Side-by-Side) -->
                    <div class="magazine-grid content-grid">
                      <!-- PAGE 2: INSIDE SPREAD 1 (EDITORIAL 1) -->
                      <div class="magazine-page m-page-content-1">
                        <div class="editorial-header">
                          <span class="page-num">
                             <%= globalIssueCount * 6 + 2 %>
                           </span>
                          <span class="editorial-cat">
                            <%= group.title %> — DEAR MUSÉ STUDIO
                          </span>
                        </div>

                        <div class="editorial-body editorial-layout-elle">
                          <!-- Left Main Column (ELLE style layout) -->
                          <div class="editorial-main-col">
                            <h3 class="editorial-title"><%= textData.ed1Title %> <span><%= textData.ed1TitleSpan %></span></h3>
                            <div class="editorial-sub-banner"><%= textData.ed1SubBanner %></div>

                            <div class="main-portrait-wrap">
                              <% var img1=chunk[1] || group.images[1 % group.images.length]; %>
                                <% if (img1) { %>
                                  <img src="<%= img1.src %>" alt="<%= img1.alt %>" loading="lazy" decoding="async">
                                  <% } else { %>
                                    <div class="typo-placeholder">
                                      <p class="typo-quote">"Nhiếp ảnh là cách giữ lại khoảnh khắc mà không cần lời
                                        nói."</p>
                                    </div>
                                    <% } %>
                            </div>

                            <div class="editorial-two-cols">
                              <p class="editorial-paragraph">
                                <span class="drop-cap">
                                  <%= textData.ed1Para1.charAt(0) %>
                                </span>
                                <%= textData.ed1Para1.slice(1) %>
                              </p>
                              <p class="editorial-paragraph">
                                <%= textData.ed1Para2 %>
                              </p>
                            </div>
                          </div>

                          <!-- Right Side Column -->
                          <div class="editorial-side-col">
                            <div class="side-text-block">
                              <p><%= textData.ed1Side %></p>
                            </div>
                            
                            <div class="side-filler-img" style="margin: 40px 0;">
                              <% var fillerImg1 = chunk[2] || group.images[2 % group.images.length]; %>
                              <% if (fillerImg1) { %>
                                <img src="<%= fillerImg1.src %>" alt="Filler" loading="lazy" style="width: 100%; height: auto; object-fit: contain; border-radius: 2px;">
                              <% } %>
                            </div>

                            <div class="side-decor-box">
                              <span class="side-decor-title"><%= textData.ed1DecorTitle || 'AWARD WINNING' %></span>
                              <p class="side-decor-quote"><%= textData.ed1Decor %></p>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- PAGE 3: INSIDE SPREAD 2 (EDITORIAL 2 - NEW ELLE PAGE 45) -->
                      <div class="magazine-page m-page-content-2-elle">
                        <div class="editorial-header">
                          <span class="editorial-cat">
                            <%= group.title %> — EDITORIAL II
                          </span>
                          <span class="page-num">
                             <%= globalIssueCount * 6 + 3 %>
                           </span>
                        </div>

                        <div class="editorial-body editorial-2-layout-elle">
                          <!-- Left Column: Main Image & Drop cap Paragraph -->
                          <div class="editorial-2-main-col">
                            <div class="editorial-2-sub-banner"><%= textData.ed2SubBanner %></div>

                            <div class="editorial-2-portrait-wrap">
                              <% var img2=chunk[3] || group.images[3 % group.images.length]; %>
                                <% if (img2) { %>
                                  <img src="<%= img2.src %>" alt="<%= img2.alt %>" loading="lazy" decoding="async">
                                  <% } else { %>
                                    <div class="typo-placeholder">
                                      <p class="typo-quote">“Nghệ thuật là sự đơn giản hóa các chi tiết dư thừa.”</p>
                                    </div>
                                    <% } %>
                            </div>

                            <p class="editorial-2-paragraph">
                              <span class="drop-cap-large"><%= textData.ed2Para.charAt(0) %></span><%= textData.ed2Para.slice(1) %>
                            </p>
                          </div>

                          <!-- Right Column: Banner & Content Text -->
                          <div class="editorial-2-side-col">
                            <div class="editorial-2-side-banner"><%= textData.ed2SideBanner %></div>

                            <p class="editorial-2-side-text">
                              <%= textData.ed2SideText %>
                            </p>
                            
                            <div class="side-filler-img" style="margin: 40px 0;">
                              <% var fillerImg2 = chunk[4] || group.images[4 % group.images.length]; %>
                              <% if (fillerImg2) { %>
                                <img src="<%= fillerImg2.src %>" alt="Filler" loading="lazy" style="width: 100%; height: auto; object-fit: contain; border-radius: 2px;">
                              <% } %>
                            </div>

                            <div class="side-brand-quote">
                              <p class="brand-quote-title">DEAR MUSÉ</p>
                              <p class="brand-quote-text"><%= textData.brandQuoteText || 'Vẻ đẹp chân thực trường tồn.' %></p>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div><!-- /.content-grid -->
                  </div><!-- /.magazine-row-1 -->

                  <!-- ROW 2: EDITORIAL II (2 pages - Left) vs BACK COVER (1 page - Right) -->
                  <div class="magazine-row-2">
                    <!-- SPREAD 3: EDITORIAL II (Left - 2 pages side-by-side) -->
                    <div class="magazine-grid content-grid">
                      <!-- PAGE 4: NEW EDITORIAL 3 -->
                      <div class="magazine-page m-page-content-3-elle">
                        <div class="editorial-header">
                          <span class="page-num">
                             <%= globalIssueCount * 6 + 4 %>
                           </span>
                          <span class="editorial-cat">
                            <%= group.title %> — EDITORIAL III
                          </span>
                        </div>

                        <div class="editorial-body editorial-layout-elle">
                          <!-- Left Main Column -->
                          <div class="editorial-main-col">
                            <h3 class="editorial-title"><%= textData.ed3Title %> <span><%= textData.ed3TitleSpan %></span></h3>
                            <div class="editorial-sub-banner"><%= textData.ed3SubBanner %></div>

                            <div class="main-portrait-wrap">
                              <% var img3=chunk[5] || group.images[5 % group.images.length]; %>
                                <% if (img3) { %>
                                  <img src="<%= img3.src %>" alt="<%= img3.alt %>" loading="lazy" decoding="async">
                                  <% } else { %>
                                    <div class="typo-placeholder">
                                      <p class="typo-quote">"Phong cách là một cách đơn giản để nói những điều phức
                                        tạp."</p>
                                    </div>
                                    <% } %>
                            </div>

                            <div class="editorial-two-cols">
                              <p class="editorial-paragraph">
                                <%= textData.ed3Para1 %>
                              </p>
                              <p class="editorial-paragraph">
                                <%= textData.ed3Para2 %>
                              </p>
                            </div>
                          </div>

                          <!-- Right Side Column -->
                          <div class="editorial-side-col">
                            <div class="side-text-block">
                              <p><%= textData.ed3Side %></p>
                            </div>
                            
                            <div class="side-filler-img" style="margin: 40px 0;">
                              <% var fillerImg3 = chunk[6] || group.images[6 % group.images.length]; %>
                              <% if (fillerImg3) { %>
                                <img src="<%= fillerImg3.src %>" alt="Filler" loading="lazy" style="width: 100%; height: auto; object-fit: contain; border-radius: 2px;">
                              <% } %>
                            </div>

                            <div class="side-decor-box">
                              <span class="side-decor-title"><%= textData.ed3DecorTitle || 'STYLE GUIDE' %></span>
                              <p class="side-decor-quote"><%= textData.ed3Decor %></p>
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- PAGE 5: CREDITS & LETTERS (ELLE Style) -->
                      <div class="magazine-page m-page-credits-new">
                        <div class="editorial-header">
                          <span class="page-num">
                             <%= globalIssueCount * 6 + 5 %>
                           </span>
                          <span class="editorial-cat">DEAR MUSÉ EDITORIAL</span>
                        </div>

                        <div class="editorial-body credits-layout-elle">
                          <!-- Column 1: Editorial Info & Manifesto -->
                          <div class="credits-column-new">
                            <h2 class="credits-logo-text">DEAR MUSÉ</h2>

                            <div class="credits-section" style="margin-top: 12px;">
                              <h5 class="credits-sec-title"><%= textData.creditTitle1 || 'TRIẾT LÝ SÁNG TẠO' %></h5>
                              <p class="credits-sec-desc" style="font-size: 9.5px; line-height: 1.6; color: var(--smoke);">
                                <%= textData.creditDesc1 || 'Dear Musé tin rằng mỗi cá nhân là một tác phẩm nghệ thuật độc bản. Chúng tôi không chỉ ghi lại hình ảnh, mà còn khơi gợi và tôn vinh vẻ đẹp sâu thẳm, thần thái tự nhiên và câu chuyện riêng biệt của bạn qua lăng kính nhiếp ảnh cao cấp.' %>
                              </p>
                            </div>

                            <div class="credits-section" style="margin-top: 12px;">
                              <h5 class="credits-sec-title"><%= textData.creditTitle2 || 'DỊCH VỤ NỔI BẬT' %></h5>
                              <p class="credits-sec-desc" style="font-size: 9.5px; line-height: 1.6; color: var(--smoke);">
                                <%- textData.creditDesc2 || '• Chân dung Nghệ thuật & Ý niệm<br>• Chân dung Doanh nhân cao cấp<br>• Lookbook Thời trang & Sản phẩm' %>
                              </p>
                            </div>
                          </div>

                          <!-- Column 2: Letter -->
                          <div class="letter-column-new" style="border-right: 1px solid rgba(26, 25, 22, 0.12); padding-right: 16px;">
                            <h3 class="letter-title-new" style="font-size: 24px; margin-bottom: 8px;">Thư Ngỏ</h3>
                            <span class="letter-recipient-new" style="font-size: 13px; margin-bottom: 8px; font-weight: 600; display: block; color: var(--logo-mocha);">
                              <%= textData.letterRecipient || 'Độc giả thân mến,' %>
                            </span>
                            <p class="letter-text-new" style="font-size: 12.5px; line-height: 1.6; color: var(--smoke);">
                              <%= textData.letterText %>
                            </p>
                          </div>

                          <!-- Column 3: Aesthetic Metaphor Image & Quote -->
                          <div class="third-column-new" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
                            <div class="side-filler-img-col3" style="margin-bottom: 12px;">
                              <% var imgCol3 = chunk[7] || group.images[7 % group.images.length]; %>
                              <% if (imgCol3) { %>
                                <img src="<%= imgCol3.src %>" alt="Aesthetic" loading="lazy" style="width: 100%; height: auto; object-fit: contain; border-radius: 2px;">
                              <% } %>
                            </div>
                            <div class="decor-quote-wrap" style="border-top: 1px solid rgba(26, 25, 22, 0.1); padding-top: 12px;">
                              <p style="font-family: var(--font-display); font-size: 12px; font-style: italic; color: var(--logo-mocha); line-height: 1.5; margin: 0;">
                                "Nghệ thuật là ngôn ngữ của tâm hồn."
                              </p>
                            </div>
                          </div>
                        </div>

                        <!-- New Bottom Section to fill empty space -->
                        <div class="credits-bottom-section">
                          <div class="credits-bottom-images" <% if (group.id === 'mo-rong' || group.id === 'doanh-nghiep') { %>style="grid-template-columns: 1fr; max-width: 75%;"<% } %>>
                            <% var img4=chunk[8] || group.images[8 % group.images.length]; %>
                                <div class="bottom-img-wrap" <% if (group.id === 'mo-rong' || group.id === 'doanh-nghiep') { %>style="aspect-ratio: auto; box-shadow: none;"<% } %>>
                                  <% var bottomImgStyle = (group.id === 'mo-rong' || group.id === 'doanh-nghiep') ? 'width: 100%; height: auto; aspect-ratio: auto; object-fit: contain; border-radius: 4px;' : ''; %>
                                  <% if (img4) { %><img src="<%= img4.src %>" alt="<%= img4.alt %>" loading="lazy"
                                      decoding="async" style="<%= bottomImgStyle %>">
                                    <% } %>
                                </div>
                          </div>
                          <div class="credits-bottom-text">
                            <p><%= textData.creditsBottomText %></p>
                          </div>
                        </div>
                      </div>
                    </div><!-- /.content-grid -->

                    <!-- SPREAD 4: BACK COVER / BRAND ADVERTISEMENT (Right - 1 page) -->
                    <div class="magazine-grid ad-grid">
                      <div class="magazine-page m-page-ad">
                        <div class="ad-full-bg">
                          <% if (chunk[9]) { %>
                            <img src="<%= chunk[9].src %>" alt="<%= chunk[9].alt %>" loading="lazy" decoding="async">
                            <% } else if (group.images[0]) { %>
                              <img src="<%= group.images[0].src %>" alt="<%= group.images[0].alt %>" loading="lazy"
                                decoding="async">
                              <% } %>
                        </div>

                        <div class="ad-overlay-content ad-minimal">
                          <h2 class="ad-brand-title">
                            <%= group.englishTitle %>
                          </h2>
                          <% var adSubtitleColor = (group.id === 'doanh-nghiep') ? '#FFFFFF' : 'var(--logo-mocha, #8B7355)'; %>
                          <p class="ad-brand-subtitle" style="color: <%= adSubtitleColor %> !important; font-weight: 900 !important;">EDITORIAL BY DEAR MUSÉ</p>
                        </div>
                      </div>
                    </div><!-- /.ad-grid -->
                  </div><!-- /.magazine-row-2 -->
                </div><!-- /.magazine-book-wrap -->
              </div>
              <% globalIssueCount++; %>
              <% }) %>
                <% }) %>
      </div>
      <% if (magazineGroups.length===0 || magazineGroups[0].images.length===0) { %>
        <div class="text-center" style="padding: 120px 0;">
          <p class="body-text" style="font-style: italic;">Chưa có tác phẩm trong danh mục này.</p>
        </div>
        <% } %>

    </div>
  </section>

  <!-- Booking CTA -->
  <section
    style="background: var(--parchment); color: var(--ink); padding: 120px 0; text-align: center; border-top: 0.5px solid var(--bone);">
    <div class="container">
      <h2 class="section-heading reveal"
        style="color: var(--ink); margin-bottom: 24px; font-size: clamp(36px, 5vw, 56px);">Thích những gì bạn thấy?</h2>
      <p class="body-text reveal" style="color: var(--smoke); margin-bottom: 48px; font-size: 16px;">Hãy để chúng tôi
        tạo nên bộ ảnh tiếp theo dành riêng cho bạn.</p>
      <a href="/booking" class="btn btn-outline-dark portfolio-cta-btn reveal"><span>Bắt đầu câu chuyện của
          bạn</span></a>
    </div>
  </section>