<% pageCss='home.css?v=7' ; pageJs='home.js' ; %>

  <!-- ═══════════════════════════════════════════
     HERO — Fullscreen Cinematic Slideshow
═══════════════════════════════════════════ -->
  <section class="hero" id="hero" aria-label="Hero">
    <!-- Film-grain texture -->
    <div class="hero-noise"></div>

    <!-- Animated Gallery Background -->
    <div class="hero-gallery-bg">
      <% /* Split heroImages into 5 columns */ const colCount=5; const columns=Array.from({length: colCount}, ()=> []);
        heroImages.forEach((img, index) => {
        columns[index % colCount].push(img);
        });
        %>
        <% columns.forEach((col, cIdx)=> { %>
          <div class="hero-col hero-col-<%= cIdx + 1 %>">
            <div class="hero-col-track">
              <% [...col, ...col].forEach(img=> { %>
                <div class="hero-img-wrap">
                  <img src="<%= img %>" alt="Dear Musé" fetchpriority="high" decoding="async">
                </div>
                <% }) %>
            </div>
          </div>
          <% }) %>
    </div>

    <div class="hero-frame-overlay"></div>



    <!-- Centered Text Content -->
    <div class="hero-content-center">
      <p class="hero-eyebrow" style="color: var(--blush-petal, #F8C8D2); white-space: nowrap; font-size: clamp(18px, 4vw, 42px);">Est. 2026 &nbsp;·&nbsp; Dear Musé</p>
      <h1 class="hero-title">
        <span class="hero-title-line">Lưu giữ</span>
        <span class="hero-title-line italic" style="color: #D4DB74;">khoảnh khắc</span>
        <span class="hero-title-line">của bạn</span>
      </h1>
      <div class="hero-actions">
        <a href="/booking" class="btn-hero-primary">
          <span>Đặt lịch chụp</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        <a href="/portfolio" class="btn-hero-ghost">Xem portfolio</a>
      </div>
    </div>

    <!-- Badge -->
    <div class="hero-badge">
      <span class="hero-badge-dot"></span>
      Studio nhiếp ảnh nghệ thuật Hà Nội
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
     TICKER MARQUEE
═══════════════════════════════════════════ -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <% for(let i=0; i < 3; i++) { %>
        <span class="ticker-item">Dear Musé</span>
        <span class="ticker-sep">◆</span>
        <span class="ticker-item">Nhiếp ảnh nghệ thuật</span>
        <span class="ticker-sep">◆</span>
        <span class="ticker-item" style="font-size: 13.5px; font-weight: 600; text-transform: none; font-style: italic; font-family: var(--font-display);">Gửi cho nàng phiên bản rực rỡ nhất của chính mình.</span>
        <span class="ticker-sep">◆</span>
        <span class="ticker-item">Portrait · Sự kiện · Thương hiệu</span>
        <span class="ticker-sep">◆</span>
        <span class="ticker-item">Hà Nội 2026</span>
        <span class="ticker-sep">◆</span>
        <% } %>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
     INTRO — Collage Editorial
═══════════════════════════════════════════ -->
  <section class="intro-section" aria-label="Giới thiệu">
    <div class="intro-grid">
      <!-- Left: Collage visual -->
      <div class="intro-visual collage-visual reveal-left">
        <div class="collage-layer collage-bg">
          <img src="/cdn/image?src=%2Fsource%2FC%C3%81%20NH%C3%82N%2F%C3%81O%20D%C3%80I%2FIMG_6368.webp"
            alt="Dear Musé - Áo dài" loading="lazy" decoding="async">
        </div>
        <div class="collage-layer collage-fg">
          <img src="/source/C%C3%81%20NH%C3%82N/CONCEPT/SU209534.webp" alt="Dear Musé — Portrait nghệ thuật"
            loading="lazy" decoding="async">
          <div class="intro-img-label">
            <span>Concept & Áo Dài</span>
            <span class="intro-img-num">Bộ sưu tập kép</span>
          </div>
        </div>
      </div>

      <!-- Right: quote + meta -->
      <div class="intro-text reveal-right">
        <span class="section-tag">Triết lý · Philosophy</span>
        <blockquote class="intro-quote">
          "Ảnh đẹp nhất<br>không phải ảnh hoàn hảo<br>
          mà là ảnh <em>thật nhất</em>."
        </blockquote>
        <div class="intro-rule"></div>
        <p class="intro-body">
          Tại Dear Musé, mỗi buổi chụp là một cuộc đối thoại nhẹ nhàng. Chúng tôi tạo ra không gian để cảm xúc thật của
          bạn tự xuất hiện rồi ghi lại khoảnh khắc đó bằng ánh sáng tự nhiên và góc nhìn nghệ thuật.
        </p>
        <a href="/about" class="link-arrow">
          Câu chuyện của chúng tôi
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
     FEATURED GALLERY — Dark Cinema
═══════════════════════════════════════════ -->
  <section class="gallery-section" aria-label="Tác phẩm nổi bật">
    <div class="gallery-header container">
      <div>
        <span class="section-tag" style="white-space: nowrap;">Tác phẩm chọn lọc</span>
        <h2 class="gallery-heading">Những<br><em style="font-size: 1.3em;">khoảnh khắc</em></h2>
      </div>
      <a href="/portfolio" class="link-arrow" style="white-space: nowrap;">
        Xem toàn bộ portfolio
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="gallery-mosaic container">
      <% const gColCount=3; const gColumns=Array.from({length: gColCount}, ()=> []);
        featuredImages.forEach((img, index) => {
        gColumns[index % gColCount].push({img, originalIndex: index});
        });
        %>
        <% gColumns.forEach((col, cIdx)=> { %>
          <div class="gallery-col">
            <% col.forEach(({img, originalIndex})=> { %>
              <div class="gallery-item reveal" data-delay="<%= (originalIndex % 3) + 1 %>">
                <img src="<%= img.src %>" alt="<%= img.alt %>" loading="lazy" decoding="async">
                <div class="gallery-item-overlay">
                  <div class="gallery-item-meta">
                    <span class="gallery-cat">
                      <%= img.category %>
                    </span>
                    <span class="gallery-num">
                      <%= String(originalIndex+1).padStart(2,'0') %>
                    </span>
                  </div>
                </div>
              </div>
              <% }) %>
          </div>
          <% }) %>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
     NUMBERS — Credibility Stats
═══════════════════════════════════════════ -->
  <section class="numbers-section" aria-label="Thành tích">
    <div class="container">
      <div class="numbers-top">
        <span class="section-tag">Hành trình · Numbers</span>
        <h2 class="numbers-heading">Nghệ thuật được kiểm chứng</h2>
      </div>
      <div class="numbers-grid">
        <div class="number-item reveal" data-delay="1">
          <span class="number-big">500<sup>+</sup></span>
          <div class="number-body">
            <strong>Khách hàng hài lòng</strong>
            <p>Chân dung, sự kiện và doanh nghiệp trên khắp Hà Nội</p>
          </div>
        </div>
        <div class="number-item reveal" data-delay="2">
          <span class="number-big">1.2k<sup>+</sup></span>
          <div class="number-body">
            <strong>Bộ ảnh hoàn thành</strong>
            <p>Được xử lý màu sắc và hậu kỳ tỉ mỉ từng khung hình</p>
          </div>
        </div>
        <div class="number-item reveal" data-delay="3">
          <span class="number-big">10k<sup>+</sup></span>
          <div class="number-body">
            <strong>Giờ chụp ảnh</strong>
            <p>Dày dặn kinh nghiệm chụp ảnh, xử lý ánh sáng và bắt trọn cảm xúc</p>
          </div>
        </div>
        <div class="number-item reveal" data-delay="4">
          <span class="number-big">98<sup>%</sup></span>
          <div class="number-body">
            <strong>Khách hàng giới thiệu lại</strong>
            <p>Niềm tin từ khách hàng là tài sản quý giá nhất của chúng tôi</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
     SERVICES — Hover Film
═══════════════════════════════════════════ -->
  <section class="services-section" aria-label="Dịch vụ">
    <div class="container">
      <div class="services-intro">
        <div>
          <span class="section-tag">Dịch vụ · Services</span>
          <h2 class="services-heading">Chúng tôi<br><em style="font-size: 1.3em;">làm được gì?</em></h2>
        </div>
        <div class="services-intro-text">
          <p>Từ buổi chụp chân dung cá nhân đến sự kiện lớn, mỗi dịch vụ mang một cách tiếp cận riêng, một cảm xúc
            riêng.</p>
          <a href="/services" class="link-arrow">Xem tất cả gói chụp <svg width="14" height="14" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg></a>
        </div>
      </div>

      <div class="services-marquee-wrapper">
        <div class="services-marquee-track">
          <% const customServices=[ { num: '01' , name: 'Concept' ,
            desc: 'Thiết kế concept riêng biệt, phá cách và mang đậm dấu ấn cá nhân.' , price: '2.500.000' ,
            slug: 'portrait-concept' , img: '/cdn/image?w=600&src=' +
            encodeURIComponent('/source/C%C3%81%20NH%C3%82N/CONCEPT/SU207942(1).webp') }, { num: '02' , name: 'Áo Dài' ,
            desc: 'Lưu giữ nét đẹp truyền thống, thanh lịch và đằm thắm của người phụ nữ Việt.' , price: '1.800.000' ,
            slug: 'portrait-ao-dai' , img: '/cdn/image?w=600&src=' +
            encodeURIComponent('/source/C%C3%81%20NH%C3%82N/%C3%81O%20D%C3%80I/IMG_6368.webp') }, { num: '03' ,
            name: 'Chân Dung' , desc: 'Bắt trọn vẻ đẹp nguyên bản và cảm xúc tự nhiên nhất của chính bạn.' ,
            price: '1.500.000' , slug: 'portrait-profile' , img: '/cdn/image?w=600&src=' +
            encodeURIComponent('/source/C%C3%81%20NH%C3%82N/PROFILE/IMG_4928.webp') }, { num: '04' , name: 'Kỷ Yếu' ,
            desc: 'Ghi lại cột mốc thanh xuân rực rỡ và những kỷ niệm đáng nhớ.' , price: '1.800.000' ,
            slug: 'portrait-ky-yeu' , img: '/cdn/image?w=600&src=' + encodeURIComponent('/source/CÁ NHÂN/KỶ YẾU/IMG6799.jpg') }, { num: '05' , name: 'Sản phẩm' ,
            desc: 'Nâng tầm giá trị thương hiệu qua những khung hình sản phẩm sắc nét và chuyên nghiệp.' , price: '2.000.000' ,
            slug: 'concept-khac' , img: '/cdn/image?w=600&src=' +
            encodeURIComponent('/source/M%E1%BB%9E%20R%E1%BB%98NG/S%E1%BA%A2N%20PH%E1%BA%A8M/IMG_5582.webp') }, {
            num: '06' , name: 'Sự Kiện' ,
            desc: 'Ghi lại những khoảnh khắc chuyên nghiệp, đẳng cấp của sự kiện doanh nghiệp.' , price: '3.000.000' ,
            slug: 'event-premium' , img: '/cdn/image?w=600&src=' +
            encodeURIComponent('/source/DOANH%20NGHI%E1%BB%86P/PREMIUM/IMG_8785.webp') } ]; %>
            <% [...customServices, ...customServices].forEach((s, i)=> { %>
              <a href="/services/<%= s.slug %>" class="svc-card">
                <div class="svc-card-bg">
                  <img src="<%= s.img %>" alt="<%= s.name %>" loading="lazy" decoding="async">
                </div>
                <div class="svc-card-overlay">
                  <span class="svc-num">
                    <%= s.num %>
                  </span>
                  <div class="svc-info">
                    <h3>
                      <%= s.name %>
                    </h3>
                    <p>
                      <%= s.desc %>
                    </p>
                  </div>
                  <div class="svc-footer">
                    <div class="svc-price">Từ <strong>
                        <%= s.price %>đ
                      </strong></div>
                    <div class="svc-arrow">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.5">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </div>
                  </div>
                </div>
              </a>
              <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
     TESTIMONIALS — Premium Cards
═══════════════════════════════════════════ -->
  <section class="reviews-section" aria-label="Đánh giá khách hàng">
    <div class="container">
      <div class="reviews-header">
        <span class="section-tag">Đánh giá · Reviews</span>
        <h2 class="reviews-heading">Khách hàng nói về<br> <em>Dear Musé</em></h2>
        <p class="reviews-sub">Mỗi lần bấm máy là một câu chuyện, đây là những gì khách hàng chia sẻ sau mỗi buổi chụp.
        </p>
      </div>

      <div class="reviews-grid">
        <!-- Review 1 -->
        <div class="review-card review-card--featured reveal" data-delay="1">
          <div class="review-top">
            <div class="review-avatar">
              <img src="/cdn/image?w=400&src=%2Fsource%2FN%C3%A0ng%20th%C6%A1%2FQu%E1%BA%A3%20chanh%20001.webp"
                alt="Khánh Linh" loading="lazy" decoding="async">
            </div>
            <div class="review-stars">★★★★★</div>
          </div>
          <blockquote class="review-text">
            "Mình chưa bao giờ nghĩ mình sẽ tự tin trước ống kính đến vậy. Nhiếp ảnh gia cực kỳ kiên nhẫn, vui tính và
            biết cách tạo sự thoải mái ngay từ những phút đầu. Ảnh nhận về đẹp đến nỗi mình không tin đó là mình!"
          </blockquote>
          <div class="review-footer">
            <div class="review-meta">
              <strong class="review-name">Khánh Linh</strong>
              <span class="review-package">Portrait Nàng Thơ · Tháng 3/2026</span>
            </div>
            <a href="/feedback" class="review-badge review-link">
              Xem thêm
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Review 2 -->
        <div class="review-card reveal" data-delay="2">
          <div class="review-top">
            <div class="review-avatar">
              <img src="/cdn/image?w=400&src=%2Fsource%2FDOANH%20NGHI%E1%BB%86P%2FPREMIUM%2FIMG_8778.webp"
                alt="Hoàng Nam" loading="lazy" decoding="async">
            </div>
            <div class="review-stars">★★★★★</div>
          </div>
          <blockquote class="review-text">
            "Bộ ảnh sự kiện doanh nghiệp của chúng tôi rất chuyên nghiệp và đẳng cấp. Ê-kíp có phong cách làm việc
            chuyên nghiệp, bàn giao ảnh nhanh đúng tiến độ."
          </blockquote>
          <div class="review-footer">
            <div class="review-meta">
              <strong class="review-name">Hoàng Nam (CEO TechVibe)</strong>
              <span class="review-package">Gói Doanh Nghiệp · Tháng 4/2026</span>
            </div>
            <a href="/feedback" class="review-badge review-link">
              Xem thêm
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Review 3 -->
        <div class="review-card reveal" data-delay="3">
          <div class="review-top">
            <div class="review-avatar">
              <img src="/cdn/image?w=400&src=%2Fsource%2FN%C3%A0ng%20th%C6%A1%2FXanh%20Xanh%20002.webp" alt="Hà Vy"
                loading="lazy" decoding="async">
            </div>
            <div class="review-stars">★★★★★</div>
          </div>
          <blockquote class="review-text">
            "Ảnh thương hiệu của shop mình sau khi chụp tại Dear Musé đẹp hơn hẳn, doanh số tăng rõ rệt luôn! Họ hiểu
            sản phẩm, biết cách đặt ánh sáng và màu sắc cực kỳ có gu."
          </blockquote>
          <div class="review-footer">
            <div class="review-meta">
              <strong class="review-name">Hà Vy</strong>
              <span class="review-package">Chụp Thương Hiệu · Tháng 5/2026</span>
            </div>
            <a href="/feedback" class="review-badge review-link">
              Xem thêm
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Review 4 -->
        <div class="review-card reveal" data-delay="4">
          <div class="review-top">
            <div class="review-avatar">
              <img
                src="/cdn/image?w=400&src=%2Fsource%2FN%C3%A0ng%20th%C6%A1%2FH%C6%B0%E1%BB%9Bng%20d%C6%B0%C6%A1ng%20004.webp"
                alt="Bảo Ngọc" loading="lazy" decoding="async">
            </div>
            <div class="review-stars">★★★★★</div>
          </div>
          <blockquote class="review-text">
            "Ảnh sinh nhật 25 tuổi của mình được chụp ở đây và mình không thể hạnh phúc hơn với kết quả. Concept Hướng
            Dương rất độc đáo, màu sắc đẹp mê hồn. Chắc chắn sẽ quay lại!"
          </blockquote>
          <div class="review-footer">
            <div class="review-meta">
              <strong class="review-name">Bảo Ngọc</strong>
              <span class="review-package">Portrait Sinh Nhật · Tháng 5/2026</span>
            </div>
            <a href="/feedback" class="review-badge review-link">
              Xem thêm
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Review 5 -->
        <div class="review-card reveal" data-delay="5">
          <div class="review-top">
            <div class="review-avatar">
              <img src="/cdn/image?w=400&src=%2Fsource%2FC%C3%81%20NH%C3%82N%2F%C3%81O%20D%C3%80I%2FIMG_6415.webp"
                alt="Thu Phương" loading="lazy" decoding="async">
            </div>
            <div class="review-stars">★★★★★</div>
          </div>
          <blockquote class="review-text">
            "Chụp ảnh áo dài tại Dear Musé thực sự là một trải nghiệm tuyệt vời. Từng góc máy đều tôn lên nét dịu dàng,
            truyền thống nhưng vẫn rất hiện đại. Đội ngũ nhiệt tình và chụp cực kỳ có tâm!"
          </blockquote>
          <div class="review-footer">
            <div class="review-meta">
              <strong class="review-name">Thu Phương</strong>
              <span class="review-package">Portrait Áo Dài · Tháng 6/2026</span>
            </div>
            <a href="/feedback" class="review-badge review-link">
              Xem thêm
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Overall rating bar -->
      <div class="reviews-summary reveal">
        <div class="reviews-rating">
          <span class="reviews-score">4.6</span>
          <div>
            <div class="reviews-stars-big">★★★★★</div>
            <p>Dựa trên 127 đánh giá thực tế</p>
          </div>
        </div>
        <div class="reviews-platforms">
          <span>Được đánh giá 4.6⭐ trên</span>
          <span class="platform-tag">Google Reviews</span>
          <span class="platform-tag">Facebook</span>
          <span class="platform-tag">Instagram</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
     ABOUT SNIPPET
═══════════════════════════════════════════ -->
  <section class="about-snap" aria-label="Về chúng tôi">
    <div class="container">
      <div class="about-snap-grid">
        <div class="about-snap-img reveal-left">
          <div class="about-snap-frame">
