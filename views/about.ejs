  <!-- ─── ABOUT PAGE STYLES ─── -->
  <style>
    /* ══════════════════════════════════════════════
   ABOUT — Design System (Beige World Edition)
   All backgrounds: vanilla-cream / parchment / bone
   No grays used anywhere.
   ══════════════════════════════════════════════ */

    /* ── Shared utilities ── */
    .ab-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-body);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--logo-mocha);
      /* Đổi sang màu Mocha đậm cho dễ đọc */
      white-space: nowrap;
      /* Đảm bảo hiển thị trên 1 hàng không bị rớt dòng */
    }

    .ab-eyebrow::before,
    .ab-eyebrow::after {
      content: '';
      display: block;
      width: 28px;
      height: 0.5px;
      background: var(--logo-mocha);
      /* Màu gạch ngang đậm màu hơn */
      opacity: 0.95;
      /* Rõ ràng hơn */
    }

    .ab-eyebrow--center {
      display: flex;
      justify-content: center;
    }

    .ab-eyebrow--vert {
      writing-mode: vertical-rl;
      text-orientation: mixed;
      transform: rotate(180deg);
      gap: 14px;
    }

    .ab-eyebrow--vert::before,
    .ab-eyebrow--vert::after {
      width: 0.5px;
      height: 28px;
      background: var(--logo-mocha);
    }

    .ab-display {
      font-family: var(--font-display);
      font-size: clamp(36px, 5vw, 64px);
      font-weight: 400;
      line-height: 1.1;
      color: var(--ink);
      margin: 16px 0 32px;
    }

    .ab-display em {
      font-style: italic;
      color: var(--logo-mocha);
      /* Đổi sang màu Mocha đậm rõ ràng hơn */
    }

    .ab-display--center {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    /* ── HERO ── */
    .ab-hero {
      position: relative;
      height: 60vh;
      min-height: 450px;
      overflow: hidden;
      background: var(--vanilla-cream);
      /* Đổi sang màu be sáng */
    }

    .ab-hero__img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      transform: scale(1.03);
      transition: transform 8s ease;
    }

    .ab-hero:hover .ab-hero__img {
      transform: scale(1);
    }

    .ab-hero__veil {
      position: absolute;
      inset: 0;
      background: linear-gradient(170deg,
          rgba(26, 25, 22, 0.55) 0%,
          rgba(26, 25, 22, 0.20) 50%,
          rgba(26, 25, 22, 0.65) 100%);
    }

    .ab-hero__body {
      position: absolute;
      bottom: 8vh;
      left: 0;
      right: 0;
      padding: 0 clamp(24px, 8vw, 120px);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .ab-hero__eyebrow {
      font-family: var(--font-body);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(255, 247, 230, 0.75);
    }

    .ab-hero__title {
      font-family: var(--font-display);
      font-size: clamp(52px, 10vw, 120px);
      font-weight: 400;
      font-style: italic;
      line-height: 1;
      color: var(--vanilla-cream);
      letter-spacing: -0.01em;
    }

    .ab-hero__rule {
      width: 48px;
      height: 1px;
      background: rgba(255, 247, 230, 0.5);
      margin: 4px 0;
    }

    .ab-hero__slogan {
      font-family: var(--font-display);
      font-size: clamp(14px, 1.6vw, 20px);
      font-style: italic;
      color: rgba(255, 247, 230, 0.9);
      letter-spacing: 0.03em;
      max-width: 500px;
      line-height: 1.5;
    }

    .ab-hero__scroll {
      position: absolute;
      bottom: 40px;
      right: clamp(24px, 5vw, 80px);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .ab-hero__scroll span {
      font-family: var(--font-body);
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255, 247, 230, 0.55);
      writing-mode: vertical-rl;
    }

    .ab-hero__scroll-line {
      width: 1px;
      height: 48px;
      background: rgba(255, 247, 230, 0.35);
      position: relative;
      overflow: hidden;
    }

    .ab-hero__scroll-line::after {
      content: '';
      position: absolute;
      top: -100%;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 247, 230, 0.8);
      animation: scrollDrop 2s ease-in-out infinite;
    }

    @keyframes scrollDrop {
      0% {
        top: -100%;
      }

      100% {
        top: 200%;
      }
    }

    /* ── MEANING ── */
    .ab-meaning {
      background: var(--vanilla-cream);
      padding: clamp(80px, 12vw, 160px) 0;
    }

    .ab-meaning__inner {
      display: grid;
      grid-template-columns: 80px 1fr 380px;
      gap: 64px;
      align-items: start;
    }

    .ab-meaning__label-col {
      padding-top: 24px;
      display: flex;
      justify-content: center;
    }

    .ab-meaning__text-col {
      max-width: 560px;
    }

    .ab-meaning__body p {
      font-family: var(--font-body);
      font-size: 15px;
      /* Đồng nhất 15px với trang Home */
      font-weight: 300;
      line-height: 1.85;
      color: var(--ink);
      margin-bottom: 20px;
      opacity: 0.95;
    }

    .ab-meaning__body p:last-child {
      margin-bottom: 0;
    }

    .ab-meaning__body strong {
      font-weight: 600;
      color: var(--logo-mocha);
    }

    .ab-meaning__img-col {}

    .ab-meaning__img-frame {
      position: relative;
      border-radius: 4px;
      overflow: hidden;
    }

    .ab-meaning__img-frame img {
      width: 100%;
      aspect-ratio: 3/4;
      object-fit: cover;
      display: block;
      transition: transform 0.8s var(--ease-silk);
    }

    .ab-meaning__img-frame:hover img {
      transform: scale(1.03);
    }

    .ab-meaning__img-caption {
      position: absolute;
      bottom: 20px;
      left: 20px;
      font-family: var(--font-display);
      font-size: 11px;
      font-style: italic;
      letter-spacing: 0.1em;
      color: rgba(255, 247, 230, 0.8);
    }

    /* ── BRAND STORY ── */
    .ab-story {
