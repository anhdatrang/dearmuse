<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title || 'Dear Musé — Studio Nhiếp Ảnh Nghệ Thuật' %>
  </title>
  <meta name="description"
    content="Dear Musé — Studio nhiếp ảnh nghệ thuật. Chụp chân dung, sự kiện và ảnh thương hiệu. Lưu giữ khoảnh khắc bằng ánh sáng và cảm xúc.">

  <!-- Favicon -->
  <link rel="icon" href="/logo/logo.ico" type="image/x-icon">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
    rel="stylesheet">

  <!-- GLightbox -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">

  <!-- CSS -->
  <link rel="stylesheet" href="/css/main.css?v=20">
  <link rel="stylesheet" href="/css/effects.css?v=25">
  <% if (typeof pageCss !=='undefined' ) { %>
    <link rel="stylesheet" href="/css/<%= pageCss %>?v=3">
    <% } %>
</head>

<body class="page-entering">

  <!-- Loading Screen -->
  <div id="loading-screen">
    <p class="loading-wordmark">dear musé</p>
    <div class="loading-bar-wrap">
      <div class="loading-bar"></div>
    </div>
  </div>

  <!-- Page Transition Overlay -->
  <div id="page-transition-overlay" aria-hidden="true">
    <span class="pto-text">Dear Musé</span>
  </div>

  <!-- Custom Cursor -->
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursor-ring"></div>
  <div class="cursor-label" id="cursor-label">view</div>

  <!-- Header / Nav -->
  <%- include('../partials/nav') %>

    <!-- Mobile Menu -->
    <%- include('../partials/mobile-menu') %>

      <!-- Flash Messages -->
      <% if (typeof success !=='undefined' && success.length> 0) { %>
        <div class="flash-success container mt-s">
          <%= success[0] %>
        </div>
        <% } %>
          <% if (typeof error !=='undefined' && error.length> 0) { %>
            <div class="flash-error container mt-s">
              <%= error[0] %>
            </div>
            <% } %>

              <!-- Page Content -->
              <main>
                <%- body %>
              </main>

              <!-- Footer -->
              <%- include('../partials/footer') %>

                <!-- Chatbot Window -->
                <div class="chatbot-window" id="chatbot-window">
                  <div class="chatbot-header">
                    <div class="chatbot-header-info">
                      <div class="chatbot-avatar-status"></div>
                      <div>
                        <h4>Musé Assistant</h4>
                        <span>Đang hoạt động</span>
                      </div>
                    </div>
                    <button class="chatbot-close-btn" id="chatbot-close-btn" aria-label="Đóng Chatbot">✕</button>
                  </div>
                  <div class="chatbot-messages" id="chatbot-messages">
                    <div class="chatbot-msg bot">
                      <div class="chatbot-bubble-text">Chào bạn! Mình là trợ lý ảo của Dear Musé. Mình có thể giúp gì cho bạn hôm nay? ✨</div>
                    </div>
                  </div>
                  <div class="chatbot-suggestions" id="chatbot-suggestions">
                    <button class="chatbot-suggest-btn" data-action="pricing">Bảng giá chụp</button>
                    <button class="chatbot-suggest-btn" data-action="concept">Tư vấn Concept</button>
                    <button class="chatbot-suggest-btn" data-action="booking">Đặt lịch chụp</button>
                    <button class="chatbot-suggest-btn" data-action="contact">Liên hệ trực tiếp</button>
                  </div>
                  <form class="chatbot-input-area" id="chatbot-form">
                    <input type="text" id="chatbot-input" placeholder="Nhập tin nhắn..." autocomplete="off">
                    <button type="submit" class="chatbot-send-btn" aria-label="Gửi">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                      </svg>
                    </button>
                  </form>
                </div>

                <!-- Mascot Widget -->
                <div class="mascot-widget" id="mascot-widget">
                  <!-- Mascot Menu (appears on hover) -->
                  <div class="mascot-menu" id="mascot-menu">
                    <!-- Decorative stickers -->
                    <span class="menu-sticker sticker-tl">✨</span>
                    <span class="menu-sticker sticker-tr">🌸</span>
                    <a href="/pricing" class="mascot-menu-item">✦ Bảng giá</a>
                    <button type="button" id="mascot-btn-chatbot" class="mascot-menu-item">🤖 Chat bot</button>
                    <a href="/services" class="mascot-menu-item">✧ Concept</a>
                    <a href="/about" class="mascot-menu-item">📜 Câu chuyện</a>
                    <a href="/contact" class="mascot-menu-item">✉️ Liên hệ</a>
                  </div>

                  <div class="mascot-bubble" id="mascot-bubble">
                    <span>Xin chào! 👋</span>
                  </div>
                  <div class="mascot-clouds-container">
                    <!-- Mascot Video (Hidden) -->
                    <video id="mascot-video" src="/audio/Mascot_sits_on_cloud_waves_202606161657.mp4" muted autoplay loop playsinline crossorigin="anonymous" style="display: none;"></video>
                    
                    <!-- Mascot Canvas (Chroma keyed output) -->
                    <div class="mascot-image-wrap">
                      <canvas class="mascot-img" id="mascot-canvas"></canvas>
                    </div>
                  </div>
                </div>

                <!-- Ambient Music Player -->
                <div class="music-player-widget" id="music-player-widget">
                  <button class="music-toggle" id="music-toggle" aria-label="Toggle music">
                    <div class="music-waves" id="music-waves">
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                    <svg class="music-icon-play" width="20" height="20" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </button>
                  <span class="music-tooltip">Âm thanh nhẹ</span>
                  <audio id="bg-audio" loop preload="auto">
                    <source src="/audio/3.mp3" type="audio/mp3">
                    Trình duyệt của bạn không hỗ trợ phát nhạc.
                  </audio>
                </div>

                <!-- Google Translate Hidden Widget -->
                <div id="google_translate_element" style="display:none;"></div>
                <script type="text/javascript">
                  function googleTranslateElementInit() {
                    new google.translate.TranslateElement({
                      pageLanguage: 'vi',
                      includedLanguages: 'en,vi',
                      autoDisplay: false
                    }, 'google_translate_element');
                  }
                </script>
                <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" defer></script>

                <!-- GLightbox -->
                <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js" defer></script>

                <!-- Lenis smooth scroll -->
                <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/bundled/lenis.min.js" defer></script>

                <!-- Main JS -->
                <script src="/js/main.js?v=20" defer></script>
                <script src="/js/effects.js?v=25" defer></script>
                <% if (typeof pageJs !=='undefined' ) { %>
                  <script src="/js/<%= pageJs %>" defer></script>
                  <% } %>

                    <!-- Hero mode nav -->
                    <script>
                      (function () {
                        const header = document.getElementById('site-header');
                        if (!header) return;
                        const hero = document.getElementById('hero');
                        if (!hero) { header.classList.add('scrolled'); return; }
                        const updateNav = () => {
                          const past = window.scrollY > hero.offsetHeight - 120;
                          header.classList.toggle('scrolled', past);
                          header.classList.toggle('hero-mode', !past);
                        };
                        window.addEventListener('scroll', updateNav, { passive: true });
                        updateNav();
                      })();
                    </script>

</body>

</html>