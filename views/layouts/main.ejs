<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title || 'Dear Musé — Studio Nhiếp Ảnh Nghệ Thuật' %>
  </title>
  <meta name="description"
    content="Dear Musé — Studio nhiếp ảnh nghệ thuật. Chụp chân dung, sự kiện và ảnh thương hiệu. Lưu giữ khoảnh khắc bằng ánh sáng và cảm xúc.">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap"
    rel="stylesheet">

  <!-- GLightbox -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">

  <!-- CSS -->
  <link rel="stylesheet" href="/css/main.css?v=6">
  <link rel="stylesheet" href="/css/effects.css?v=1">
  <% if (typeof pageCss !=='undefined' ) { %>
    <link rel="stylesheet" href="/css/<%= pageCss %>">
    <% } %>
</head>

<body class="page-entering">

  <!-- Loading Screen -->
  <div id="loading-screen">
    <p class="loading-wordmark">dear musé</p>
    <div class="loading-bar-wrap">
      <div class="loading-bar"></div>
    </div>
  </div>

  <!-- Page Transition Overlay -->
  <div id="page-transition-overlay" aria-hidden="true">
    <span class="pto-text">Dear Musé</span>
  </div>

  <!-- Custom Cursor -->
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursor-ring"></div>
  <div class="cursor-label" id="cursor-label">view</div>

  <!-- Header / Nav -->
  <%- include('../partials/nav') %>

    <!-- Mobile Menu -->
    <%- include('../partials/mobile-menu') %>

      <!-- Flash Messages -->
      <% if (typeof success !=='undefined' && success.length> 0) { %>
        <div class="flash-success container mt-s">
          <%= success[0] %>
        </div>
        <% } %>
          <% if (typeof error !=='undefined' && error.length> 0) { %>
            <div class="flash-error container mt-s">
              <%= error[0] %>
            </div>
            <% } %>

              <!-- Page Content -->
              <main>
                <%- body %>
              </main>

              <!-- Footer -->
              <%- include('../partials/footer') %>

                <!-- Floating Action Button (FAB) -->
                <div class="fab-wrapper" id="fab-wrapper">
                  <div class="fab-menu">
                    <a href="/booking" class="fab-item" style="--i: 4" aria-label="Đặt lịch">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                      <span class="fab-tooltip">Đặt lịch chụp</span>
                    </a>
                    <a href="/contact" class="fab-item" style="--i: 3" aria-label="Liên hệ">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                      </svg>
                      <span class="fab-tooltip">Liên hệ</span>
                    </a>
                    <a href="https://instagram.com" target="_blank" class="fab-item" style="--i: 2"
                      aria-label="Instagram">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                      </svg>
                      <span class="fab-tooltip">Instagram</span>
                    </a>
                    <a href="https://facebook.com" target="_blank" class="fab-item" style="--i: 1"
                      aria-label="Facebook">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                      </svg>
                      <span class="fab-tooltip">Facebook</span>
                    </a>
                  </div>
                  <button class="fab-toggle" id="fab-toggle" aria-label="Quick Menu">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="round" stroke-linejoin="round" class="fab-icon-camera">
                      <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z">
                      </path>
                      <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="round" stroke-linejoin="round" class="fab-icon-close">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                  </button>
                </div>

                <!-- Ambient Music Player -->
                <div class="music-player-widget" id="music-player-widget">
                  <button class="music-toggle" id="music-toggle" aria-label="Toggle music">
                    <div class="music-waves" id="music-waves">
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                    <svg class="music-icon-play" width="20" height="20" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </button>
                  <span class="music-tooltip">Âm thanh nhẹ</span>
                  <audio id="bg-audio" loop preload="none">
                    <source src="/audio/3.mp3" type="audio/mp3">
                    Trình duyệt của bạn không hỗ trợ phát nhạc.
                  </audio>
                </div>

                <!-- Google Translate Hidden Widget -->
                <div id="google_translate_element" style="display:none;"></div>
                <script type="text/javascript">
                  function googleTranslateElementInit() {
                    new google.translate.TranslateElement({
                      pageLanguage: 'vi',
                      includedLanguages: 'en,vi',
                      autoDisplay: false
                    }, 'google_translate_element');
                  }
                </script>
                <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" defer></script>

                <!-- GLightbox -->
                <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js" defer></script>

                <!-- Lenis smooth scroll -->
                <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/bundled/lenis.min.js" defer></script>

                <!-- Main JS -->
                <script src="/js/main.js?v=8" defer></script>
                <script src="/js/effects.js?v=1" defer></script>
                <% if (typeof pageJs !=='undefined' ) { %>
                  <script src="/js/<%= pageJs %>" defer></script>
                  <% } %>

                    <!-- Hero mode nav -->
                    <script>
                      (function () {
                        const header = document.getElementById('site-header');
                        if (!header) return;
                        const hero = document.getElementById('hero');
                        if (!hero) { header.classList.add('scrolled'); return; }
                        const updateNav = () => {
                          const past = window.scrollY > hero.offsetHeight - 120;
                          header.classList.toggle('scrolled', past);
                          header.classList.toggle('hero-mode', !past);
                        };
                        window.addEventListener('scroll', updateNav, { passive: true });
                        updateNav();
                      })();
                    </script>

</body>

</html>