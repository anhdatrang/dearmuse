<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <% const defaultTitle='Dear Musé — Studio Nhiếp Ảnh Nghệ Thuật tại Hà Nội' ; const
    defaultDesc='Dear Musé là studio nhiếp ảnh nghệ thuật chuyên nghiệp tại Hà Nội. Chuyên chụp ảnh chân dung nghệ thuật (Portrait), chụp ảnh sự kiện (Event), chụp ảnh thương hiệu & kỷ yếu cá nhân. Lưu giữ khoảnh khắc bằng ánh sáng tự nhiên và góc nhìn điện ảnh.'
    ; const finalTitle=typeof title !=='undefined' ? title : defaultTitle; const finalDesc=typeof metaDescription
    !=='undefined' ? metaDescription : defaultDesc; const shareImage=typeof ogImage !=='undefined' ?
    (ogImage.startsWith('http') ? ogImage : baseUrl + ogImage) : baseUrl + '/logo/logo.png' ; %>

    <title>
      <%= finalTitle %>
    </title>
    <meta name="description" content="<%= finalDesc %>">

    <!-- SEO Canonical Link -->
    <link rel="canonical" href="<%= baseUrl %><%= currentPath %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
    <meta property="og:title" content="<%= finalTitle %>">
    <meta property="og:description" content="<%= finalDesc %>">
    <meta property="og:image" content="<%= shareImage %>">
    <meta property="og:url" content="<%= baseUrl %><%= currentPath %>">
    <meta property="og:site_name" content="Dear Musé">
    <meta property="og:locale" content="vi_VN">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= finalTitle %>">
    <meta name="twitter:description" content="<%= finalDesc %>">
    <meta name="twitter:image" content="<%= shareImage %>">

    <!-- Favicon -->
    <link rel="icon" href="/logo/logo.ico" type="image/x-icon">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Nunito:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap"
      rel="stylesheet">

    <!-- GLightbox -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/main.css?v=38">
    <link rel="stylesheet" href="/css/effects.css?v=44">
    <% if (typeof pageCss !=='undefined' ) { %>
      <link class="page-css" rel="stylesheet" href="/css/<%= pageCss %>?v=1010">
      <% } %>

        <!-- Dữ liệu cấu trúc JSON-LD -->
        <% if (currentPath==='/' ) { %>
          <!-- Local Business Schema cho Trang chủ -->
          <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "PhotographyStore",
      "name": "Dear Musé",
      "image": "<%= baseUrl %>/logo/logo.png",
      "@id": "<%= baseUrl %>/#organization",
      "url": "<%= baseUrl %>/",
      "telephone": "+84912345678",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Hà Nội",
        "addressLocality": "Hà Nội",
        "addressCountry": "VN"
      },
      "sameAs": [
        "https://www.facebook.com/dearmuse",
        "https://www.instagram.com/dearmuse.studio"
      ]
    }
    </script>
          <% } %>

            <% if (currentPath !=='/' ) { const paths=currentPath.split('/').filter(Boolean); const breadcrumbs=[ {
              name: 'Trang chủ' , url: baseUrl + '/' } ]; let accumulatedPath='' ; paths.forEach((p, idx)=> {
              accumulatedPath += '/' + p;
              let label = p;
              if (p === 'portfolio') label = 'Portfolio';
              else if (p === 'services') label = 'Dịch vụ';
              else if (p === 'pricing') label = 'Bảng giá';
              else if (p === 'about') label = 'Về chúng tôi';
              else if (p === 'contact') label = 'Liên hệ';
              else if (p === 'booking') label = 'Đặt lịch';
              else if (p === 'blog') label = 'Tin tức';
              else {
              label = p.charAt(0).toUpperCase() + p.slice(1);
              }
              breadcrumbs.push({ name: label, url: baseUrl + accumulatedPath });
              });
              %>
              <!-- Breadcrumb Schema cho các trang con -->
              <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        <% breadcrumbs.forEach((bc, idx) => { %>
          {
            "@type": "ListItem",
            "position": <%= idx + 1 %>,
            "name": "<%= bc.name %>",
            "item": "<%= bc.url %>"
          }<%= idx < breadcrumbs.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    }
    </script>
              <% } %>
</head>

<body class="page-entering">

  <!-- Loading Screen -->
  <div id="loading-screen">
    <p class="loading-wordmark">Dear Musé</p>
    <div class="loading-bar-wrap">
      <div class="loading-bar"></div>
    </div>
  </div>

  <!-- Page Transition Overlay -->
  <div id="page-transition-overlay" aria-hidden="true">
    <span class="pto-text">Dear Musé</span>
  </div>

  <!-- Custom Cursor -->
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursor-ring"></div>
  <div class="cursor-label" id="cursor-label">view</div>

  <!-- Header / Nav -->
  <%- include('../partials/nav') %>

    <!-- Mobile Menu -->
    <%- include('../partials/mobile-menu') %>

      <!-- Flash Messages -->
      <% if (!currentPath.startsWith('/auth')) { %>
        <% if (typeof success !=='undefined' && success.length> 0) { %>
          <div class="flash-success container mt-s">
            <%= success[0] %>
          </div>
        <% } %>
        <% if (typeof error !=='undefined' && error.length> 0) { %>
          <div class="flash-error container mt-s">
            <%= error[0] %>
          </div>
        <% } %>
      <% } %>

              <!-- Page Content -->
              <main>
                <%- body %>
              </main>

              <!-- Footer -->
              <%- include('../partials/footer') %>

                <!-- Chatbot Window -->
                <div class="chatbot-window" id="chatbot-window">
                  <div class="chatbot-header">
                    <div class="chatbot-header-info">
                      <div class="chatbot-avatar-status"></div>
                      <div>
                        <h4>Dear Musé</h4>
                        <span>Đang hoạt động</span>
                      </div>
                    </div>
                    <div class="chatbot-header-actions" style="display: flex; align-items: center; gap: 10px;">
                      <button type="button" class="chatbot-zoom-btn" id="chatbot-zoom-btn" aria-label="Phóng to/Thu nhỏ"
                        onclick="var cw=document.getElementById('chatbot-window');cw.style.width='';cw.style.height='';cw.classList.toggle('zoomed');var cm=document.getElementById('chatbot-messages');if(cm)setTimeout(function(){cm.scrollTop=cm.scrollHeight;},300);">
                        <svg class="zoom-in-icon" width="14" height="14" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                        </svg>
                        <svg class="zoom-out-icon" width="14" height="14" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                          style="display: none;">
                          <path d="M4 14h6v6M20 10h-6V4M14 10l7-7M10 14l-7 7" />
                        </svg>
                      </button>
                      <button type="button" class="chatbot-close-btn" id="chatbot-close-btn"
                        aria-label="Đóng Chatbot">✕</button>
                    </div>
                  </div>
                  <div class="chatbot-messages" id="chatbot-messages">
                    <div class="chatbot-msg bot">
                      <div class="chatbot-bubble-text">Chào bạn! Mình là Dear Musé. Mình có thể giúp gì cho bạn hôm nay?
                      </div>
                    </div>
                  </div>
                  <div class="chatbot-suggestions" id="chatbot-suggestions">
                    <button class="chatbot-suggest-btn" data-action="pricing">Bảng giá</button>
                    <button class="chatbot-suggest-btn" data-action="concept">Tư vấn</button>
                    <button class="chatbot-suggest-btn" data-action="booking">Đặt lịch</button>
                    <button class="chatbot-suggest-btn" data-action="contact">Liên hệ</button>
                  </div>
                  <form class="chatbot-input-area" id="chatbot-form">
                    <input type="text" id="chatbot-input" placeholder="Nhập tin nhắn..." autocomplete="off">
                    <button type="submit" class="chatbot-send-btn" aria-label="Gửi">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                      </svg>
                    </button>
                  </form>
                </div>

                <!-- Mascot Widget -->
                <div class="mascot-widget" id="mascot-widget">
                  <!-- Mascot Menu (appears on hover) -->
                  <div class="mascot-menu" id="mascot-menu">
                    <div class="mascot-menu-card">
                      <a href="/pricing" class="mascot-menu-item">🏷️ &nbsp; Bảng giá</a>
                      <button type="button" id="mascot-btn-chatbot" class="mascot-menu-item">💬 &nbsp; Chat bot</button>
                      <a href="/services" class="mascot-menu-item">🎨 &nbsp; Concept</a>
                      <a href="/about" class="mascot-menu-item">📖 &nbsp; Câu chuyện</a>
                      <a href="/contact" class="mascot-menu-item">📞 &nbsp; Liên hệ</a>
                    </div>
                  </div>

                  <div class="mascot-bubble" id="mascot-bubble">
                    <span>Xin chào! 👋</span>
                  </div>
                  <div class="mascot-clouds-container">
                    <!-- Mascot Video (Hidden offscreen to prevent browser playback suspends) -->
                    <video id="mascot-video" src="/audio/Mascot_sits_on_cloud_waves_202606161657.mp4" muted autoplay
                      loop playsinline crossorigin="anonymous"
                      style="position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none;"></video>

                    <!-- Mascot Canvas (Chroma keyed output) -->
                    <div class="mascot-image-wrap">
                      <canvas class="mascot-img" id="mascot-canvas"></canvas>
                    </div>
                  </div>
                </div>

                <!-- Fixed Language Switcher Widget (directly above music player) -->
                <div class="lang-player-widget notranslate" id="lang-player-widget">
                  <button class="lang-toggle" id="lang-toggle" aria-label="Toggle language">
                    <span class="lang-label">VI</span>
                  </button>
                  <span class="lang-tooltip">Ngôn ngữ / Language</span>
                </div>

                <!-- Ambient Music Player -->
                <div class="music-player-widget" id="music-player-widget">
                  <button class="music-toggle" id="music-toggle" aria-label="Toggle music">
                    <div class="music-waves" id="music-waves">
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                    <svg class="music-icon-play" width="20" height="20" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </button>
                  <span class="music-tooltip">Âm thanh nhẹ</span>
                  <audio id="bg-audio" loop preload="auto">
                    <source src="/audio/3.mp3" type="audio/mp3">
                    Trình duyệt của bạn không hỗ trợ phát nhạc.
                  </audio>
                </div>

                <!-- Google Translate Hidden Widget -->
                <div id="google_translate_element" style="display:none;"></div>
                <script type="text/javascript">
                  function googleTranslateElementInit() {
                    new google.translate.TranslateElement({
                      pageLanguage: 'vi',
                      includedLanguages: 'en,vi',
                      autoDisplay: false
                    }, 'google_translate_element');
                  }
                </script>
                <script type="text/javascript"
                  src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" defer></script>

                <!-- GLightbox -->
                <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js" defer></script>

                <!-- Lenis smooth scroll -->
                <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/bundled/lenis.min.js"
                  defer></script>

                <!-- Main JS -->
                <script src="/js/main.js?v=22" defer></script>
                <script src="/js/effects.js?v=37" defer></script>
                <% if (typeof pageJs !=='undefined' ) { %>
                  <script src="/js/<%= pageJs %>" defer></script>
                  <% } %>

                    <!-- Hero mode nav -->
                    <script>
                      (function () {
                        const header = document.getElementById('site-header');
                        if (!header) return;
                        const hero = document.getElementById('hero');
                        if (!hero) { header.classList.add('scrolled'); return; }
                        const updateNav = () => {
                          const past = window.scrollY > hero.offsetHeight - 120;
                          header.classList.toggle('scrolled', past);
                          header.classList.toggle('hero-mode', !past);
                        };
                        window.addEventListener('scroll', updateNav, { passive: true });
                        updateNav();
                      })();
                    </script>


                    <!-- Custom Elegant Modal Alert -->
                    <div id="custom-alert-modal" class="custom-alert-overlay" style="display: none;">
                      <div class="custom-alert-card">
                        <div class="custom-alert-header">DEAR MUSÉ</div>
                        <div class="custom-alert-message" id="custom-alert-message"></div>
                        <div class="custom-alert-footer">
                          <button class="custom-alert-btn" id="custom-alert-ok-btn">Đồng ý</button>
                        </div>
                      </div>
                    </div>

                    <!-- Custom Elegant Modal Confirm -->
                    <div id="custom-confirm-modal" class="custom-alert-overlay" style="display: none;">
                      <div class="custom-alert-card">
                        <div class="custom-alert-header">DEAR MUSÉ</div>
                        <div class="custom-alert-message" id="custom-confirm-message"></div>
                        <div class="custom-alert-footer"
                          style="display: flex; gap: 12px; justify-content: center; width: 100%;">
                          <button class="custom-alert-btn secondary" id="custom-confirm-cancel-btn"
                            style="flex: 1;">Hủy</button>
                          <button class="custom-alert-btn" id="custom-confirm-ok-btn" style="flex: 1;">Đồng ý</button>
                        </div>
                      </div>
                    </div>

                    <style>
                      .custom-alert-overlay {
                        position: fixed;
                        inset: 0;
                        background: rgba(26, 25, 22, 0.45);
                        backdrop-filter: blur(8px);
                        -webkit-backdrop-filter: blur(8px);
                        z-index: 999999;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        animation: fadeInModal 0.25s ease forwards;
                      }

                      .custom-alert-card {
                        background: var(--vanilla-cream, #fffdf8);
                        border: 1px solid var(--bone, #ede8df);
                        border-radius: 12px;
                        width: 90%;
                        max-width: 400px;
                        padding: 32px 28px;
                        box-shadow: 0 20px 50px rgba(26, 25, 22, 0.12);
                        transform: translateY(20px);
                        animation: slideUpModal 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        box-sizing: border-box;
                      }

                      .custom-alert-header {
                        font-family: var(--font-display, "Playfair Display", serif);
                        font-size: 18px;
                        font-weight: 600;
                        letter-spacing: 0.15em;
                        color: var(--ink, #1a1916);
                        text-align: center;
                        margin-bottom: 16px;
                        border-bottom: 0.5px solid var(--bone, #ede8df);
                        padding-bottom: 12px;
                        width: 100%;
                      }

                      .custom-alert-message {
                        font-family: var(--font-body, "Montserrat", sans-serif);
                        font-size: 14px;
                        line-height: 1.6;
                        color: var(--smoke, #555);
                        text-align: center;
                        margin-bottom: 24px;
                        width: 100%;
                        word-break: break-word;
                      }

                      .custom-alert-footer {
                        display: flex;
                        justify-content: center;
                        width: 100%;
                      }

                      .custom-alert-btn {
                        font-family: var(--font-body, "Montserrat", sans-serif);
                        font-size: 12px;
                        font-weight: 500;
                        letter-spacing: 0.1em;
                        text-transform: uppercase;
                        background: var(--ink, #1a1916);
                        color: #fff;
                        border: none;
                        padding: 12px 24px;
                        border-radius: 50px;
                        cursor: pointer;
                        transition: all 0.2s ease;
                        min-width: 120px;
                        text-align: center;
                        box-sizing: border-box;
                      }

                      .custom-alert-btn:hover {
                        background: var(--mocha, #7a5c4a);
                        transform: translateY(-1px);
                        box-shadow: 0 4px 12px rgba(122, 92, 74, 0.2);
                      }

                      .custom-alert-btn.secondary {
                        background: transparent;
                        color: var(--smoke, #555);
                        border: 1px solid var(--bone, #ede8df);
                      }

                      .custom-alert-btn.secondary:hover {
                        background: rgba(0, 0, 0, 0.03);
                        color: var(--ink, #1a1916);
                        box-shadow: none;
                        transform: none;
                      }

                      @keyframes fadeInModal {
                        from {
                          opacity: 0;
                        }

                        to {
                          opacity: 1;
                        }
                      }

                      @keyframes slideUpModal {
                        from {
                          transform: translateY(30px);
                          opacity: 0;
                        }

                        to {
                          transform: translateY(0);
                          opacity: 1;
                        }
                      }
                    </style>

                    <script>
                      window.showAlert = function (message, callback) {
                        const overlay = document.getElementById('custom-alert-modal');
                        const messageEl = document.getElementById('custom-alert-message');
                        const okBtn = document.getElementById('custom-alert-ok-btn');

                        messageEl.innerHTML = message;
                        overlay.style.display = 'flex';

                        const newOkBtn = okBtn.cloneNode(true);
                        okBtn.parentNode.replaceChild(newOkBtn, okBtn);

                        newOkBtn.addEventListener('click', () => {
                          overlay.style.display = 'none';
                          if (typeof callback === 'function') {
                            callback();
                          }
                        });
                      };

                      window.showConfirm = function (message, callback) {
                        const overlay = document.getElementById('custom-confirm-modal');
                        const messageEl = document.getElementById('custom-confirm-message');
                        const okBtn = document.getElementById('custom-confirm-ok-btn');
                        const cancelBtn = document.getElementById('custom-confirm-cancel-btn');

                        messageEl.innerHTML = message;
                        overlay.style.display = 'flex';

                        const newOkBtn = okBtn.cloneNode(true);
                        okBtn.parentNode.replaceChild(newOkBtn, okBtn);

                        const newCancelBtn = cancelBtn.cloneNode(true);
                        cancelBtn.parentNode.replaceChild(newCancelBtn, cancelBtn);

                        newOkBtn.addEventListener('click', () => {
                          overlay.style.display = 'none';
                          if (typeof callback === 'function') callback(true);
                        });

                        newCancelBtn.addEventListener('click', () => {
                          overlay.style.display = 'none';
                          if (typeof callback === 'function') callback(false);
                        });
                      };

                      // Overwrite window.alert so default calls automatically use this styled popup
                      window.alert = function (message) {
                        window.showAlert(message);
                      };
                    </script>
</body>

</html>