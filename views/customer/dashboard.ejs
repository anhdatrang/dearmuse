<%
  pageCss = 'customer-portal.css';
%>

<div class="cust-portal">
  <%- include('../partials/customer-nav') %>

  <main class="cust-main">
    <div class="cust-page-header">
      <h1>Xin chào, <%= sessionUser ? sessionUser.name.split(' ').pop() : 'bạn' %> ✦</h1>
      <p>Đây là không gian riêng của bạn tại Dear Musé — nơi lưu giữ mọi khoảnh khắc đẹp.</p>
    </div>

    <!-- Quick Stats -->
    <div class="cust-stats">
      <div class="cust-stat-card">
        <div class="cust-stat-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 9 4-4 4 4 4-4 4 4"/><path d="M3 15h18"/></svg>
        </div>
        <div class="cust-stat-value"><%= albums.length %></div>
        <div class="cust-stat-label">Bộ ảnh</div>
      </div>
      <div class="cust-stat-card" style="cursor:pointer;" onclick="window.location='/customer/my-bookings'">
        <div class="cust-stat-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        </div>
        <div class="cust-stat-value"><%= albums.length %></div>
        <div class="cust-stat-label">Lần đặt lịch</div>
      </div>

    </div>

    <!-- Albums Grid -->
    <div class="cust-panel" style="padding: 0; overflow: hidden; background: transparent; border: none;">
      <% if (albums && albums.length > 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
          <% albums.forEach(a => { %>
            <%
              let stat = (a.status || 'booked').toLowerCase();
              let statusText = 'Đã đặt lịch';
              let statusClass = 'badge-amber';
              if (stat === 'shooting') { statusText = 'Đang chụp'; statusClass = 'badge-blue'; }
              else if (stat === 'editing') { statusText = 'Đang hậu kỳ'; statusClass = 'badge-mocha'; }
              else if (stat === 'completed') { statusText = 'Hoàn thành'; statusClass = 'badge-green'; }
              else { stat = 'booked'; }
            %>
            <a href="/customer/my-albums/<%= a.id %>" class="album-card-new">
              <div class="album-card-img">
                <% if (a.cover_thumb) { %>
                  <img src="<%= a.cover_thumb %>" alt="<%= a.title %>">
                <% } else { %>
                  <div style="width:100%;height:100%;background:var(--bone);display:flex;align-items:center;justify-content:center;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--smoke)" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg>
                  </div>
                <% } %>
                <div class="album-card-overlay">
                  <span class="badge <%= statusClass %>"><%= statusText %></span>
                </div>
              </div>
              <div class="album-card-info">
                <div class="album-card-title"><%= a.title %></div>
                <div class="album-card-meta">
                  <span><%= a.shoot_date ? new Date(a.shoot_date).toLocaleDateString('vi-VN') : 'TBA' %></span>
                  <span><%= a.photo_count || 0 %> ảnh</span>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="cust-empty">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg>
          <h3>Chưa có bộ ảnh nào</h3>
          <p>Những khoảnh khắc tuyệt đẹp của bạn sẽ xuất hiện tại đây sau khi chụp.</p>
          <a href="/booking" class="btn btn-dark" style="display:inline-block; margin-top:8px;">Đặt lịch ngay</a>
        </div>
      <% } %>
    </div>
  </main>
</div>

<style>
.album-card-new {
  background: var(--parchment, #F2EDE4);
  border: 1px solid var(--bone, #EDE8DF);
  border-radius: 16px;
  overflow: hidden;
  text-decoration: none;
  display: block;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.album-card-new:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.1);
}

.album-card-img {
  aspect-ratio: 4/3;
  overflow: hidden;
  position: relative;
  background: var(--bone, #EDE8DF);
}

.album-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s ease;
}

.album-card-new:hover .album-card-img img {
  transform: scale(1.06);
}

.album-card-overlay {
  position: absolute;
  top: 12px;
  left: 12px;
}

.album-card-info {
  padding: 18px 20px;
}

.album-card-title {
  font-family: var(--font-display, serif);
  font-size: 1.05rem;
  color: var(--ink, #1A1916);
  margin-bottom: 8px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.album-card-meta {
  display: flex;
  justify-content: space-between;
  font-size: 0.78rem;
  color: var(--smoke, #6B6860);
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
</style>
