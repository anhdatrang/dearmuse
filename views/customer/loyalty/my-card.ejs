<%
  pageCss = 'customer-portal.css';
%>
<link rel="stylesheet" href="/css/loyalty.css?v=13">

<div class="cust-portal">
  <%- include('../../partials/customer-nav') %>

  <main class="cust-main">
    <div class="cust-page-header">
      <h1>Thẻ Musé Của Tôi</h1>
      <p>Trải nghiệm đặc quyền dành riêng cho Nàng Thơ của Dear Musé.</p>
    </div>

    <% if (!member.is_card_active) { %>
      <!-- Card not activated yet -->
      <div class="cust-panel" style="text-align:center; padding: 64px 32px;">
        <div style="width:72px;height:72px;background:rgba(122,92,74,0.08);border-radius:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--mocha)" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M7 15h2M12 15h5"/></svg>
        </div>
        <h2 style="font-family:var(--font-display,serif);font-size:1.6rem;font-weight:500;margin-bottom:12px;color:var(--ink);">Bạn chưa có thẻ thành viên</h2>
        <p style="color:var(--smoke);max-width:420px;margin:0 auto 32px;">Mở thẻ ngay để bắt đầu tích lũy Mảnh Sáng và nhận những đặc quyền cao cấp.</p>
        <a href="/loyalty" class="btn btn-dark" style="padding: 14px 36px; border-radius: 8px; font-weight: 600;">Khám phá & Mở Thẻ</a>
      </div>
    <% } else { %>

    <!-- Stats Bar -->
    <div class="cust-stats">
      <div class="cust-stat-card">
        <div class="cust-stat-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div class="cust-stat-value"><%= member.manh_sang_balance.toLocaleString('vi-VN') %></div>
        <div class="cust-stat-label">Số dư Mảnh Sáng</div>
      </div>
      <div class="cust-stat-card">
        <div class="cust-stat-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        </div>
        <div class="cust-stat-value"><%= member.manh_sang_total.toLocaleString('vi-VN') %></div>
        <div class="cust-stat-label">Tổng tích lũy</div>
      </div>
      <div class="cust-stat-card">
        <div class="cust-stat-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="cust-stat-value"><%= member.referral_count || 0 %></div>
        <div class="cust-stat-label">Đã giới thiệu</div>
      </div>
      <div class="cust-stat-card">
        <div class="cust-stat-icon" style="background:rgba(180,140,20,0.1);color:#b48c14;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
        </div>
        <div class="cust-stat-value" style="text-transform:capitalize;font-size:1.4rem;"><%= member.card_tier %></div>
        <div class="cust-stat-label">Hạng thẻ</div>
      </div>
    </div>

    <!-- Virtual Card -->
    <div class="cust-panel">
      <div class="cust-panel-header">
        <p class="cust-panel-title">Thẻ Ảo Của Bạn</p>
        <p class="cust-panel-sub">Đây là thẻ thành viên digital của bạn tại Dear Musé.</p>
      </div>
      <div style="max-width:420px;">
        <div class="v-card tier-<%= member.card_tier %>">
          <div class="v-card-content">
            <div class="v-card-header">
              <div class="v-card-brand">
                <div class="v-card-brand-name">Dear Musé</div>
                <div class="v-card-brand-sub">Studio · Member Card</div>
              </div>
              <div class="v-card-tier-badge">
                <div class="v-card-tier-name"><%= member.card_tier %></div>
                <div class="v-card-tier-dots"><span></span><span></span><span></span></div>
              </div>
            </div>
            <div class="v-card-middle">
              <div class="v-card-chip"></div>
            </div>
            <div class="v-card-footer">
              <div class="v-card-number">
                <%= member.id_card ? member.id_card.replace(/(.{4})/g, '$1 ').trim() : 'DM26 •••• ••••' %>
              </div>
              <div class="v-card-footer-row">
                <div>
                  <div class="v-card-holder-label">Chủ thẻ</div>
                  <div class="v-card-name"><%= member.full_name || (sessionUser ? sessionUser.name : '') %></div>
                </div>
                <div class="v-card-tier-range">
                  <div class="v-card-tier-range-label">Mảnh Sáng</div>
                  <div class="v-card-tier-range-value"><%= member.manh_sang_total %></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Referral -->
    <div class="cust-panel">
      <div class="cust-panel-header">
        <p class="cust-panel-title">Mã giới thiệu của bạn</p>
        <p class="cust-panel-sub">Chia sẻ mã này để cùng nhận ưu đãi khi bạn bè đặt lịch thành công.</p>
      </div>
      <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:12px;background:var(--parchment);border:1px dashed var(--mocha);border-radius:12px;padding:16px 22px;">
          <span style="font-family:var(--font-display,serif);font-size:1.5rem;font-weight:600;letter-spacing:3px;color:var(--ink);" id="refCode"><%= member.referral_code %></span>
          <button class="btn btn-dark" onclick="copyRefCode()" style="padding:8px 16px;border-radius:6px;cursor:pointer;font-size:0.8rem;font-weight:600;transition:opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">Sao chép</button>
        </div>
        <div style="color:var(--smoke);font-size:0.875rem;">
          Đã giới thiệu thành công <strong style="color:var(--ink);"><%= member.referral_count || 0 %></strong> người
        </div>
      </div>
    </div>

    <% } %>
  </main>
</div>

<script>
function copyRefCode() {
  const code = document.getElementById('refCode')?.innerText;
  if (!code) return;
  navigator.clipboard.writeText(code).then(() => {
    const btn = event.target;
    btn.innerText = 'Đã sao chép!';
    setTimeout(() => btn.innerText = 'Sao chép', 2000);
  });
}
</script>
