<div class="loyalty-container">
  <div class="loyalty-sidebar">
    <nav class="loyalty-nav">
      <a href="/customer/my-card" class="<%= activeTab === 'my-card' ? 'active' : '' %>">
        <i class="fas fa-id-card"></i> Thẻ Của Tôi
      </a>
      <a href="/customer/redeem" class="<%= activeTab === 'redeem' ? 'active' : '' %>">
        <i class="fas fa-gift"></i> Đổi Quà
      </a>
      <a href="/customer/loyalty-history" class="<%= activeTab === 'history' ? 'active' : '' %>">
        <i class="fas fa-history"></i> Lịch Sử
      </a>
    </nav>
  </div>

  <div class="loyalty-content">
    <div class="loyalty-header">
      <h2>Lịch Sử Mảnh Sáng</h2>
      <p>Theo dõi mọi biến động tích lũy và sử dụng Mảnh Sáng của bạn.</p>
    </div>

    <div class="history-timeline">
      <% if (transactions.length === 0) { %>
        <p class="empty-state">Chưa có giao dịch nào.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="loyalty-table">
            <thead>
              <tr>
                <th>Thời gian</th>
                <th>Phân loại</th>
                <th>Mô tả chi tiết</th>
                <th>Số lượng</th>
                <th>Số dư sau</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach(t => { %>
                <tr>
                  <td><%= new Date(t.created_at).toLocaleString('vi-VN') %></td>
                  <td>
                    <% 
                      let typeLabel = '';
                      let typeClass = '';
                      if (t.type === 'spend' || t.type === 'first_booking' || t.type.includes('bonus') || t.type.includes('reward')) {
                        typeLabel = 'Tích lũy';
                        typeClass = 'text-success';
                      } else if (t.type === 'voucher_redeem') {
                        typeLabel = 'Đổi quà';
                        typeClass = 'text-danger';
                      } else {
                        typeLabel = 'Khác';
                        typeClass = 'text-muted';
                      }
                    %>
                    <span class="<%= typeClass %>"><%= typeLabel %></span>
                  </td>
                  <td><%= t.description %></td>
                  <td class="<%= t.amount > 0 ? 'text-success font-weight-bold' : 'text-danger font-weight-bold' %>">
                    <%= t.amount > 0 ? '+' : '' %><%= t.amount %>
                  </td>
                  <td><%= t.balance_after %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Styles -->
<style>
.loyalty-container { display: flex; max-width: 1200px; margin: 40px auto; gap: 30px; padding: 0 20px; }
.loyalty-sidebar { width: 250px; flex-shrink: 0; }
.loyalty-nav { display: flex; flex-direction: column; background: #fff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
.loyalty-nav a { padding: 15px 20px; color: #555; text-decoration: none; font-weight: 500; border-left: 3px solid transparent; }
.loyalty-nav a.active { background: #fdfaf6; color: #D4A847; border-left-color: #D4A847; }
.loyalty-content { flex-grow: 1; }
.loyalty-header h2 { font-size: 28px; margin-bottom: 5px; }
.loyalty-header p { color: #777; margin-bottom: 30px; }

.history-timeline {
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  overflow: hidden;
}

.loyalty-table { width: 100%; border-collapse: collapse; }
.loyalty-table th { background: #f9f9f9; padding: 15px; text-align: left; color: #555; font-weight: 600; border-bottom: 1px solid #eee; }
.loyalty-table td { padding: 15px; border-bottom: 1px solid #eee; color: #333; }
.text-success { color: #28a745; }
.text-danger { color: #dc3545; }
.text-muted { color: #6c757d; }
.font-weight-bold { font-weight: 700; }
.empty-state { padding: 30px; text-align: center; color: #888; }
</style>
