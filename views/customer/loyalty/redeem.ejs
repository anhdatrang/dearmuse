<%
  pageCss = 'customer-portal.css';
%>

<div class="cust-portal">
  <%- include('../../partials/customer-nav') %>

  <main class="cust-main">
    <div class="cust-page-header">
      <h1>Đổi Quà & Voucher</h1>
      <p>Dùng Mảnh Sáng để đổi lấy các ưu đãi hấp dẫn cho lần chụp tiếp theo.</p>
    </div>

    <!-- Balance Banner -->
    <div style="background:linear-gradient(135deg,var(--ink,#1A1916) 0%,#3a2e26 100%);border-radius:20px;padding:28px 36px;margin-bottom:32px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
      <div>
        <div style="font-size:0.75rem;text-transform:uppercase;letter-spacing:1.5px;color:rgba(255,255,255,0.5);margin-bottom:6px;">Số dư hiện tại</div>
        <div style="font-family:var(--font-display,serif);font-size:2.6rem;font-weight:600;color:#e8c86a;letter-spacing:-1px;line-height:1;"><%= member.manh_sang_balance.toLocaleString('vi-VN') %></div>
        <div style="font-size:0.8rem;color:rgba(255,255,255,0.5);margin-top:4px;letter-spacing:1px;">MẢNH SÁNG</div>
      </div>
      <a href="/customer/loyalty-history" style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.8);padding:10px 20px;border-radius:8px;text-decoration:none;font-size:0.85rem;font-weight:500;transition:all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.08)'">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Lịch sử điểm
      </a>
    </div>

    <!-- Voucher Grid -->
    <div class="cust-panel">
      <div class="cust-panel-header">
        <p class="cust-panel-title">Đổi Mảnh Sáng</p>
        <p class="cust-panel-sub">Chọn voucher phù hợp và xác nhận để nhận ngay mã ưu đãi.</p>
      </div>

      <% if (vouchers && vouchers.length > 0) { %>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;">
          <% vouchers.forEach(v => { %>
            <%
              const canRedeem = member.manh_sang_balance >= v.manh_sang_cost;
              const discountText = v.discount_type === 'fixed'
                ? 'Giảm ' + v.discount_value.toLocaleString('vi-VN') + 'đ'
                : 'Giảm ' + v.discount_value + '%';
            %>
            <div class="voucher-item <%= !canRedeem ? 'voucher-disabled' : '' %>">
              <div class="voucher-item-top">
                <div class="voucher-cost"><%= v.manh_sang_cost.toLocaleString() %> <span>MS</span></div>
                <div class="voucher-discount"><%= discountText %></div>
                <div class="voucher-name"><%= v.name %></div>
                <% if (v.min_order_value > 0) { %>
                  <div class="voucher-condition">Đơn tối thiểu <%= v.min_order_value.toLocaleString('vi-VN') %>đ</div>
                <% } %>
              </div>
              <button class="voucher-btn"
                onclick="redeemVoucher(<%= v.id %>, '<%= v.name %>', <%= v.manh_sang_cost %>)"
                <%= !canRedeem ? 'disabled' : '' %>>
                <%= !canRedeem ? 'Chưa đủ điểm' : 'Đổi Ngay →' %>
              </button>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="cust-empty">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/></svg>
          <h3>Chưa có voucher nào</h3>
          <p>Hãy quay lại sau — các voucher mới sẽ sớm được thêm vào.</p>
        </div>
      <% } %>
    </div>

    <!-- My Vouchers -->
    <div class="cust-panel">
      <div class="cust-panel-header">
        <p class="cust-panel-title">Voucher Của Tôi</p>
        <p class="cust-panel-sub">Các mã ưu đãi bạn đã đổi — dùng khi đặt lịch để được giảm giá.</p>
      </div>

      <% if (myVouchers && myVouchers.length > 0) { %>
        <table class="cust-table">
          <thead>
            <tr>
              <th>Mã Code</th>
              <th>Tên Voucher</th>
              <th>Trạng thái</th>
              <th>Hết hạn</th>
            </tr>
          </thead>
          <tbody>
            <% myVouchers.forEach(mv => { %>
              <tr>
                <td>
                  <code style="font-family:monospace;background:var(--parchment);padding:4px 10px;border-radius:6px;font-weight:700;font-size:0.9rem;color:var(--ink);letter-spacing:1px;"><%= mv.code %></code>
                </td>
                <td style="font-weight:500;"><%= mv.name %></td>
                <td>
                  <% if (mv.status === 'active') { %>
                    <span class="badge badge-green">Khả dụng</span>
                  <% } else if (mv.status === 'used') { %>
                    <span class="badge badge-gray">Đã dùng</span>
                  <% } else { %>
                    <span class="badge badge-red">Hết hạn</span>
                  <% } %>
                </td>
                <td style="color:var(--smoke);font-size:0.875rem;"><%= new Date(mv.expires_at).toLocaleDateString('vi-VN') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="cust-empty" style="padding:40px 20px;">
          <p style="color:var(--smoke);font-size:0.9rem;">Bạn chưa đổi voucher nào. Hãy dùng Mảnh Sáng bên trên!</p>
        </div>
      <% } %>
    </div>
  </main>
</div>

<style>
.voucher-item {
  background: #fff;
  border: 1px solid var(--bone,#EDE8DF);
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.25s, box-shadow 0.25s;
}

.voucher-item:not(.voucher-disabled):hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.08);
}

.voucher-disabled { opacity: 0.55; }

.voucher-item-top {
  padding: 24px 22px 20px;
  flex: 1;
}

.voucher-cost {
  font-size: 0.75rem;
  color: var(--mocha,#7A5C4A);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 10px;
}

.voucher-cost span { opacity: 0.7; }

.voucher-discount {
  font-family: var(--font-display,serif);
  font-size: 1.6rem;
  font-weight: 500;
  color: var(--ink,#1A1916);
  margin-bottom: 6px;
}

.voucher-name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--ink,#1A1916);
  margin-bottom: 4px;
}

.voucher-condition {
  font-size: 0.775rem;
  color: var(--smoke,#6B6860);
}

.voucher-btn {
  display: block;
  width: 100%;
  padding: 14px;
  background: var(--ink,#1A1916);
  color: var(--vanilla,#FFF7E6);
  border: none;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  letter-spacing: 0.5px;
  transition: background 0.2s;
}

.voucher-btn:hover:not([disabled]) { background: var(--mocha,#7A5C4A); }
.voucher-btn[disabled] { background: #ccc; cursor: not-allowed; color: #888; }
</style>

<script>
async function redeemVoucher(id, name, cost) {
  if (!confirm(`Xác nhận đổi ${cost.toLocaleString()} Mảnh Sáng lấy "${name}"?`)) return;
  try {
    const res = await fetch('/api/loyalty/vouchers/redeem', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ voucher_id: id })
    });
    const data = await res.json();
    if (data.success) {
      alert('Đổi thành công! Mã của bạn: ' + data.data.code);
      location.reload();
    } else {
      alert('Lỗi: ' + data.message);
    }
  } catch {
    alert('Lỗi kết nối, thử lại sau.');
  }
}
</script>
