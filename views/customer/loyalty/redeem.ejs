<div class="loyalty-container">
  <div class="loyalty-sidebar">
    <nav class="loyalty-nav">
      <a href="/customer/my-card" class="<%= activeTab === 'my-card' ? 'active' : '' %>">
        <i class="fas fa-id-card"></i> Thẻ Của Tôi
      </a>
      <a href="/customer/redeem" class="<%= activeTab === 'redeem' ? 'active' : '' %>">
        <i class="fas fa-gift"></i> Đổi Quà
      </a>
      <a href="/customer/loyalty-history" class="<%= activeTab === 'history' ? 'active' : '' %>">
        <i class="fas fa-history"></i> Lịch Sử
      </a>
    </nav>
  </div>

  <div class="loyalty-content">
    <div class="loyalty-header">
      <h2>Voucher & Đặc Quyền</h2>
      <p>Sử dụng Mảnh Sáng để đổi lấy các ưu đãi hấp dẫn</p>
    </div>

    <div class="balance-banner">
      <div class="balance-info">
        <span>Số dư Mảnh Sáng hiện tại</span>
        <strong><%= member.manh_sang_balance %></strong>
      </div>
    </div>

    <h3 class="section-title">Đổi Voucher</h3>
    <div class="voucher-grid">
      <% vouchers.forEach(v => { %>
        <div class="voucher-card">
          <div class="v-header <%= v.code_prefix.toLowerCase() %>">
            <h4><%= v.name %></h4>
            <div class="v-cost"><%= v.manh_sang_cost %> MS</div>
          </div>
          <div class="v-body">
            <p><%= v.discount_type === 'fixed' ? 'Giảm ' + v.discount_value.toLocaleString() + 'đ' : 'Giảm ' + v.discount_value + '%' %></p>
            <small>Điều kiện: <%= v.min_order_value > 0 ? 'Đơn tối thiểu ' + v.min_order_value.toLocaleString() + 'đ' : 'Không có' %></small>
          </div>
          <div class="v-footer">
            <button class="btn-redeem" onclick="redeemVoucher(<%= v.id %>, '<%= v.name %>', <%= v.manh_sang_cost %>)" 
              <%= member.manh_sang_balance < v.manh_sang_cost ? 'disabled' : '' %>>
              <%= member.manh_sang_balance < v.manh_sang_cost ? 'Không đủ điểm' : 'Đổi Ngay' %>
            </button>
          </div>
        </div>
      <% }) %>
    </div>

    <h3 class="section-title mt-5">Voucher Của Tôi</h3>
    <div class="my-vouchers">
      <% if (myVouchers.length === 0) { %>
        <p class="empty-state">Bạn chưa có voucher nào.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="loyalty-table">
            <thead>
              <tr>
                <th>Mã Code</th>
                <th>Voucher</th>
                <th>Trạng thái</th>
                <th>Hết hạn</th>
              </tr>
            </thead>
            <tbody>
              <% myVouchers.forEach(mv => { %>
                <tr>
                  <td><span class="code-badge"><%= mv.code %></span></td>
                  <td><%= mv.name %></td>
                  <td>
                    <% if (mv.status === 'active') { %>
                      <span class="status active">Khả dụng</span>
                    <% } else if (mv.status === 'used') { %>
                      <span class="status used">Đã dùng</span>
                    <% } else { %>
                      <span class="status expired">Hết hạn</span>
                    <% } %>
                  </td>
                  <td><%= new Date(mv.expires_at).toLocaleDateString('vi-VN') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>
</div>

<!-- (Copy styles from my-card.ejs and add specific ones) -->
<style>
.loyalty-container { display: flex; max-width: 1200px; margin: 40px auto; gap: 30px; padding: 0 20px; }
.loyalty-sidebar { width: 250px; flex-shrink: 0; }
.loyalty-nav { display: flex; flex-direction: column; background: #fff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
.loyalty-nav a { padding: 15px 20px; color: #555; text-decoration: none; font-weight: 500; border-left: 3px solid transparent; }
.loyalty-nav a.active { background: #fdfaf6; color: #D4A847; border-left-color: #D4A847; }
.loyalty-content { flex-grow: 1; }
.loyalty-header h2 { font-size: 28px; margin-bottom: 5px; }
.loyalty-header p { color: #777; margin-bottom: 30px; }

.balance-banner {
  background: linear-gradient(135deg, #111 0%, #333 100%);
  color: #D4A847;
  padding: 20px 30px;
  border-radius: 12px;
  margin-bottom: 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.balance-info span { font-size: 16px; opacity: 0.8; display: block; margin-bottom: 5px; }
.balance-info strong { font-size: 32px; font-weight: 700; }

.section-title { font-size: 20px; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px; }
.mt-5 { margin-top: 40px; }

.voucher-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 20px;
}

.voucher-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  border: 1px solid #f0f0f0;
  transition: transform 0.3s;
}
.voucher-card:hover { transform: translateY(-5px); }

.v-header {
  padding: 20px;
  color: #fff;
  text-align: center;
}
.v-header.glow { background: #E8A0A0; }
.v-header.rose { background: #e08282; }
.v-header.gold { background: #D4A847; }
.v-header.sign { background: #2D1B4E; }

.v-header h4 { font-size: 18px; margin: 0 0 10px 0; font-family: 'Cinzel', serif; }
.v-cost { background: rgba(0,0,0,0.2); display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 14px; }

.v-body { padding: 20px; text-align: center; }
.v-body p { font-size: 20px; font-weight: 600; color: #333; margin-bottom: 5px; }
.v-body small { color: #888; }

.v-footer { padding: 15px; border-top: 1px solid #eee; }
.btn-redeem {
  width: 100%;
  padding: 10px;
  background: #333;
  color: #fff;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  transition: background 0.3s;
}
.btn-redeem:hover:not([disabled]) { background: #D4A847; }
.btn-redeem[disabled] { background: #ccc; cursor: not-allowed; }

.loyalty-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
.loyalty-table th { background: #f9f9f9; padding: 15px; text-align: left; color: #555; font-weight: 600; border-bottom: 1px solid #eee; }
.loyalty-table td { padding: 15px; border-bottom: 1px solid #eee; color: #333; }
.code-badge { font-family: monospace; background: #f0f0f0; padding: 4px 8px; border-radius: 4px; font-weight: 600; }

.status { padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; }
.status.active { background: #e6f7eb; color: #28a745; }
.status.used { background: #f8f9fa; color: #6c757d; }
.status.expired { background: #ffebee; color: #dc3545; }
</style>

<script>
async function redeemVoucher(id, name, cost) {
  if (!confirm(`Xác nhận đổi ${cost} Mảnh Sáng lấy ${name}?`)) return;
  
  try {
    const res = await fetch('/api/loyalty/vouchers/redeem', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ voucher_id: id })
    });
    
    const data = await res.json();
    if (data.success) {
      alert('Đổi voucher thành công! Mã code của bạn là: ' + data.data.code);
      location.reload();
    } else {
      alert('Lỗi: ' + data.message);
    }
  } catch (err) {
    alert('Đã xảy ra lỗi kết nối');
  }
}
</script>
