<%
  pageCss = 'customer-portal.css';
%>

<!-- Dùng thư viện GLightbox cho ảnh popup mượt mà nếu chưa có ở layout -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
<script src="https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js"></script>

<div class="cust-portal">
  <%- include('../partials/customer-nav') %>

  <main class="cust-main">
    <div class="cust-page-header">
      <a href="/customer/my-albums" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--smoke); margin-bottom: 16px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Quay lại danh sách
      </a>
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px;">
        <div>
          <h1 style="font-size: 2rem; margin-bottom: 8px;"><%= album.title %></h1>
          <p style="color: var(--smoke); font-size: 0.95rem; margin: 0;">
            <%= photos.length %> ảnh &nbsp;•&nbsp; Ngày chụp: <%= album.shoot_date ? new Date(album.shoot_date).toLocaleDateString('vi-VN') : '—' %>
          </p>
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <label class="btn btn-dark" style="padding: 10px 20px; cursor: pointer; display: flex; align-items: center; gap: 8px; border-radius: 8px;">
            <input type="file" id="faceInput" accept="image/*" style="display: none;" onchange="handleFaceFilter(this)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            <span id="faceFilterText">Tải ảnh lên</span>
          </label>
          <button class="btn btn-dark" style="padding: 10px 20px; display: flex; align-items: center; gap: 8px; border-radius: 8px;" onclick="startWebcam()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
            Chụp khuôn mặt
          </button>
          
          <button id="clearFilterBtn" class="btn btn-outline-dark" style="display: none; border-color: #dc3545; color: #dc3545; padding: 10px 20px; border-radius: 8px;" onclick="clearFilter()">
            ✖ Bỏ lọc
          </button>

          <a href="/customer/download-album/<%= album.id %>" target="_blank" onclick="handleDownload()" class="btn btn-dark submit-btn" style="padding: 10px 20px; display: flex; align-items: center; gap: 8px; border-radius: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            <span>Tải Toàn Bộ (Zip)</span>
          </a>

          <!-- Nút hướng dẫn -->
          <button class="btn pulse-guide-btn" onclick="document.getElementById('guideOverlay').style.display='flex'" title="Hướng dẫn sử dụng AI">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span style="font-size: 13px; font-weight: 600;">HƯỚNG DẪN</span>
          </button>
        </div>
      </div>
      
      <!-- Điều chỉnh độ chính xác -->
      <div id="thresholdControl" style="display: none; align-items: center; gap: 12px; margin-top: 20px; padding: 12px 16px; background: rgba(255,255,255,0.6); border: 1px solid var(--bone); border-radius: 8px; width: fit-content;">
        <span style="font-size: 0.85rem; color: var(--smoke); font-weight: 500;">Độ chính xác:</span>
        <input type="range" id="thresholdSlider" min="25" max="55" value="40" step="5" style="width: 120px;" oninput="document.getElementById('thresholdVal').innerText = (100 - this.value) + '%'; rerunFilter()">
        <span id="thresholdVal" style="font-size: 0.9rem; color: var(--ink); font-weight: 700;">60%</span>
      </div>
    </div>

    <!-- Add loading script -->
    <script>
      function handleDownload() {
        const btn = document.querySelector('.submit-btn span');
        const oldText = btn.innerText;
        btn.innerText = "Đang chuẩn bị file...";
        setTimeout(() => {
          btn.innerText = oldText;
          window.location.reload();
        }, 2000);
      }
    </script>

    <% if (photos && photos.length > 0) { %>
      <!-- Photo Grid -->
      <div class="cust-panel" style="padding: 0; background: transparent; border: none;">
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px;">
          <% photos.forEach(p => { %>
            <div class="photo-card" data-id="<%= p.id %>" style="position: relative; border-radius: 12px; overflow: hidden; background: var(--bone);">
              <input type="checkbox" class="photo-checkbox" value="<%= p.id %>" style="position: absolute; top: 12px; left: 12px; z-index: 10; width: 22px; height: 22px; cursor: pointer; accent-color: var(--avocado-cream);" onchange="toggleSelection()">
              
              <a href="<%= p.original_url %>" class="glightbox" data-gallery="album" data-title="<%= p.file_name %>">
                <img src="<%= p.thumbnail_url %>" alt="<%= p.file_name %>" style="width: 100%; aspect-ratio: 3/4; object-fit: cover; transition: transform 0.4s ease;" class="hover-zoom">
              </a>
              
              <a href="<%= p.original_url %>" download="<%= p.file_name %>" 
                 style="position: absolute; bottom: 12px; right: 12px; background: rgba(26,25,22,0.6); color: white; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%; backdrop-filter: blur(4px); transition: background 0.3s;"
                 onmouseover="this.style.background='var(--ink)'" onmouseout="this.style.background='rgba(26,25,22,0.6)'">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    <% } else { %>
      <div class="cust-empty">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        <h3>Album trống</h3>
        <p>Studio chưa upload ảnh cho album này. Vui lòng quay lại sau.</p>
      </div>
    <% } %>

  </main>
</div>

<!-- Sticky Action Bar for custom download -->
<div id="actionBar" style="position: fixed; bottom: 0; left: 0; right: 0; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); padding: 16px 0; border-top: 1px solid rgba(0,0,0,0.1); display: none; z-index: 1000; box-shadow: 0 -4px 20px rgba(0,0,0,0.05);">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
    <span style="font-family: var(--font-display); font-size: 18px;">Đã chọn <b id="selectedCount">0</b> ảnh</span>
    <form method="POST" action="/customer/albums/<%= album.id %>/download-selected" id="customDownloadForm" target="_blank">
      <input type="hidden" name="imageIds" id="imageIdsInput">
      <button type="submit" class="btn btn-dark" style="padding: 8px 24px; border-radius: 8px;" onclick="setTimeout(()=>window.location.reload(), 2000)">Tải Hình Đã Chọn</button>
    </form>
  </div>
</div>

<!-- Loading Overlay cho khách -->
<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 9999; flex-direction: column; align-items: center; justify-content: center; color: white;">
  <div style="width: 50px; height: 50px; border: 4px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20px;"></div>
  <h3 style="margin: 0; font-family: 'Outfit', sans-serif;">Đang phân tích khuôn mặt...</h3>
  <p style="color: #ccc; margin-top: 10px;">Vui lòng đợi trong giây lát</p>
</div>
<style>
  @keyframes spin { 100% { transform: rotate(360deg); } }
  
  /* Hiệu ứng nhấp nháy cho nút hướng dẫn */
  .pulse-guide-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 8px;
    border: 1px solid var(--mocha);
    background: transparent;
    color: var(--mocha);
    animation: pulse-border 2s infinite;
    transition: all 0.3s ease;
  }
  .pulse-guide-btn:hover {
    background: var(--mocha);
    color: #fff;
    animation: none;
  }
  @keyframes pulse-border {
    0% { box-shadow: 0 0 0 0 rgba(122, 92, 74, 0.4); }
    70% { box-shadow: 0 0 0 8px rgba(122, 92, 74, 0); }
    100% { box-shadow: 0 0 0 0 rgba(122, 92, 74, 0); }
  }
</style>

<!-- Webcam Overlay -->
<div id="webcamOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 10000; flex-direction: column; align-items: center; justify-content: center; color: white;">
  <h3 style="margin: 0 0 16px 0; font-family: 'Outfit', sans-serif;">Canh khuôn mặt của bạn vào khung hình</h3>
  <video id="webcamVideo" autoplay playsinline style="width: 100%; max-width: 400px; border-radius: 8px; transform: scaleX(-1); background: #000;"></video>
  <div style="display: flex; gap: 16px; margin-top: 24px;">
    <button class="btn" style="background: #dc3545; color: white; border: none; padding: 12px 24px; border-radius: 8px;" onclick="closeWebcam()">Hủy</button>
    <button class="btn" style="background: var(--avocado-cream); color: var(--ink); border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600;" onclick="captureWebcam()">📸 Chụp ngay</button>
  </div>
</div>

<!-- Guide Overlay Đẹp Mắt Hơn -->
<div id="guideOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.65); z-index: 10001; align-items: center; justify-content: center; backdrop-filter: blur(8px);">
  <div style="background: var(--vanilla, #FFF7E6); padding: 40px; border-radius: 24px; max-width: 550px; width: 90%; color: var(--ink); position: relative; box-shadow: 0 24px 60px rgba(0,0,0,0.2); border: 1px solid var(--bone);">
    <button style="position: absolute; top: 20px; right: 20px; background: rgba(122,92,74,0.1); border: none; width: 36px; height: 36px; border-radius: 50%; font-size: 16px; cursor: pointer; color: var(--mocha); display: flex; align-items: center; justify-content: center; transition: background 0.3s;" onclick="document.getElementById('guideOverlay').style.display='none'" onmouseover="this.style.background='rgba(122,92,74,0.2)'" onmouseout="this.style.background='rgba(122,92,74,0.1)'">✖</button>
    
    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
      <div style="width: 48px; height: 48px; background: var(--avocado-cream); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--ink);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
      </div>
      <h3 style="margin: 0; font-family: var(--font-display, serif); font-size: 1.8rem; font-weight: 500;">Công Nghệ Tìm Ảnh AI</h3>
    </div>
    
    <div style="font-size: 0.95rem; line-height: 1.6; color: var(--smoke);">
      <div style="display: flex; gap: 16px; margin-bottom: 20px;">
        <div style="flex-shrink: 0; width: 32px; height: 32px; background: var(--ink); color: var(--vanilla); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700;">1</div>
        <div>
          <h4 style="margin: 0 0 4px 0; color: var(--ink); font-weight: 600; font-size: 1.05rem;">Cung cấp khuôn mặt mẫu</h4>
          <p style="margin: 0;">Bấm <b>"Tải ảnh lên"</b> (chọn 1 bức ảnh rõ mặt bạn) hoặc <b>"Chụp khuôn mặt"</b> trực tiếp bằng camera trên thiết bị.</p>
        </div>
      </div>
      
      <div style="display: flex; gap: 16px; margin-bottom: 20px;">
        <div style="flex-shrink: 0; width: 32px; height: 32px; background: var(--ink); color: var(--vanilla); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700;">2</div>
        <div>
          <h4 style="margin: 0 0 4px 0; color: var(--ink); font-weight: 600; font-size: 1.05rem;">AI tự động tìm kiếm</h4>
          <p style="margin: 0;">Hệ thống sẽ quét hàng trăm bức ảnh trong tích tắc và lọc ra những bức ảnh có mặt bạn.</p>
          <div style="background: rgba(122,92,74,0.06); border-radius: 8px; padding: 12px; margin-top: 12px; font-size: 0.85rem; border-left: 3px solid var(--mocha);">
            💡 <b>Mẹo:</b> Dùng thanh "Độ chính xác" hiện ra sau đó để điều chỉnh kết quả. Kéo lên % cao nếu AI nhận nhầm, và kéo xuống % thấp nếu AI bỏ sót ảnh do góc nghiêng / che mặt.
          </div>
        </div>
      </div>
      
      <div style="display: flex; gap: 16px; margin-bottom: 12px;">
        <div style="flex-shrink: 0; width: 32px; height: 32px; background: var(--ink); color: var(--vanilla); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700;">3</div>
        <div>
          <h4 style="margin: 0 0 4px 0; color: var(--ink); font-weight: 600; font-size: 1.05rem;">Tải về máy</h4>
          <p style="margin: 0;">Kiểm tra các ảnh ưng ý và bấm <b>"Tải Hình Đã Chọn"</b> ở thanh công cụ dưới cùng.</p>
        </div>
      </div>
    </div>
    
    <div style="margin-top: 32px; text-align: center;">
      <button class="btn btn-dark" style="padding: 14px 32px; width: 100%; border-radius: 12px; font-weight: 600; font-size: 1rem;" onclick="document.getElementById('guideOverlay').style.display='none'">Tuyệt vời, tôi đã hiểu!</button>
    </div>
  </div>
</div>

<script>
  let _lastAllScores = {}; // cache {imageId: distance} for re-run
  let _stream = null;

  async function startWebcam() {
    try {
      _stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
      const video = document.getElementById('webcamVideo');
      video.srcObject = _stream;
      document.getElementById('webcamOverlay').style.display = 'flex';
    } catch (err) {
      alert("Không thể truy cập Camera: " + err.message);
    }
  }

  function closeWebcam() {
    if (_stream) {
      _stream.getTracks().forEach(t => t.stop());
      _stream = null;
    }
    document.getElementById('webcamOverlay').style.display = 'none';
  }

  function captureWebcam() {
    const video = document.getElementById('webcamVideo');
    const canvas = document.createElement('canvas');
    // Mặc định scale down để nhẹ ảnh
    const MAX = 640;
    const scale = Math.min(MAX / video.videoWidth, MAX / video.videoHeight, 1);
    canvas.width = Math.round(video.videoWidth * scale);
    canvas.height = Math.round(video.videoHeight * scale);
    const ctx = canvas.getContext('2d');
    
    // Lật ngược lại canvas vì video đang bị lật (mirror)
    ctx.translate(canvas.width, 0);
    ctx.scale(-1, 1);
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    
    canvas.toBlob(blob => {
      closeWebcam();
      sendToFaceFilterAPI(blob);
    }, 'image/jpeg', 0.85);
  }

  async function handleFaceFilter(input) {
    if (!input.files || !input.files[0]) return;
    document.getElementById('loadingOverlay').style.display = 'flex';

    // === Nén ảnh selfie xuống 640px ngay trên trình duyệt ===
    const file = input.files[0];
    let blob = file;
    try {
      const bmp = await createImageBitmap(file);
      const MAX = 640;
      const scale = Math.min(MAX / bmp.width, MAX / bmp.height, 1);
      const w = Math.round(bmp.width * scale);
      const h = Math.round(bmp.height * scale);
      const offscreen = new OffscreenCanvas ? new OffscreenCanvas(w, h) : document.createElement('canvas');
      offscreen.width = w; offscreen.height = h;
      const ctx = offscreen.getContext('2d');
      ctx.drawImage(bmp, 0, 0, w, h);
      blob = await new Promise(res => {
        if (offscreen.convertToBlob) {
          offscreen.convertToBlob({ type: 'image/jpeg', quality: 0.85 }).then(res);
        } else {
          offscreen.toBlob(res, 'image/jpeg', 0.85);
        }
      });
      bmp.close && bmp.close();
    } catch (e) {
      console.warn('Client compression skipped:', e);
      blob = file; // fallback: gửi file gốc
    }
    // ===================================================
    sendToFaceFilterAPI(blob);
  }

  async function sendToFaceFilterAPI(blob) {
    document.getElementById('loadingOverlay').style.display = 'flex';
    const formData = new FormData();
    formData.append('photo', blob, 'selfie.jpg');

    try {
      const res = await fetch(`/customer/albums/<%= album.id %>/filter-face`, {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      
      document.getElementById('loadingOverlay').style.display = 'none';

      if (data.success) {
        _lastAllScores = data.allScores || {};
        // Hiện thanh điều chỉnh và nút bỏ lọc
        document.getElementById('thresholdControl').style.display = 'flex';
        document.getElementById('clearFilterBtn').style.display = 'block';
        applyFilter(data.matchedIds, data.matchedIds.length);
        document.getElementById('faceFilterText').innerText = `✅ Đã tìm thấy ${data.matchedIds.length} ảnh`;
      } else {
        alert(data.message || "Không tìm thấy khuôn mặt nào.");
        document.getElementById('faceFilterText').innerText = "🔍 Tải ảnh lên";
      }
    } catch (e) {
      document.getElementById('loadingOverlay').style.display = 'none';
      alert("Lỗi khi xử lý ảnh. Thử lại sau.");
      document.getElementById('faceFilterText').innerText = "🔍 Tải ảnh lên";
    }
  }

  function applyFilter(matchedIds, count) {
    document.querySelectorAll('.photo-card').forEach(card => {
      const id = parseInt(card.dataset.id);
      const cb = card.querySelector('.photo-checkbox');
      if (matchedIds.includes(id)) {
        card.style.display = 'block';
        cb.checked = true;
      } else {
        card.style.display = 'none';
        cb.checked = false;
      }
    });
    const btnText = document.getElementById('faceFilterText');
    btnText.innerText = `✅ Tìm thấy ${count} ảnh`;
    toggleSelection();
  }

  function rerunFilter() {
    if (!Object.keys(_lastAllScores).length) return;
    const slider = document.getElementById('thresholdSlider');
    const threshold = parseInt(slider.value) / 100;
    const matchedIds = Object.entries(_lastAllScores)
      .filter(([id, dist]) => dist <= threshold)
      .map(([id]) => parseInt(id));
    applyFilter(matchedIds, matchedIds.length);
  }

  function clearFilter() {
    // Ẩn UI filter
    document.getElementById('thresholdControl').style.display = 'none';
    document.getElementById('clearFilterBtn').style.display = 'none';
    document.getElementById('faceFilterText').innerText = "🔍 Tải ảnh lên";
    document.getElementById('faceInput').value = ''; // reset input
    
    // Hiện lại tất cả ảnh
    document.querySelectorAll('.photo-card').forEach(card => {
      card.style.display = 'block';
      card.querySelector('.photo-checkbox').checked = false;
    });
    toggleSelection();
  }

  function toggleSelection() {
    const checkboxes = document.querySelectorAll('.photo-checkbox:checked');
    const count = checkboxes.length;
    const actionBar = document.getElementById('actionBar');
    const countSpan = document.getElementById('selectedCount');
    const idsInput = document.getElementById('imageIdsInput');
    
    if (count > 0) {
      actionBar.style.display = 'block';
      countSpan.innerText = count;
      const ids = Array.from(checkboxes).map(cb => cb.value);
      idsInput.value = ids.join(',');
    } else {
      actionBar.style.display = 'none';
    }
  }
</script>

<style>
.hover-zoom:hover { transform: scale(1.05); }
</style>
