<%
  pageCss = 'portfolio.css'; // Use portfolio grid styling
%>

<section style="padding-top: 120px; padding-bottom: 60px;">
  <div class="container">
    
    <div style="margin-bottom: 40px; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px;">
      <div>
        <a href="/customer/my-albums" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--smoke); margin-bottom: 16px; display: inline-block;">← Quay lại danh sách</a>
        <h1 class="section-heading reveal" style="font-size: clamp(28px, 4vw, 40px); margin-bottom: 8px;"><%= album.title %></h1>
        <p style="color: var(--smoke); font-size: 14px;">
          <%= photos.length %> ảnh | Ngày chụp: <%= album.shoot_date ? new Date(album.shoot_date).toLocaleDateString('vi-VN') : '—' %>
        </p>
      </div>

      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <!-- Face Filter Buttons -->
        <div style="display: flex; gap: 8px;">
          <label class="btn" style="border-color: var(--ink); color: var(--ink); padding: 12px 24px; cursor: pointer; display: flex; align-items: center; gap: 8px;">
            <input type="file" id="faceInput" accept="image/*" style="display: none;" onchange="handleFaceFilter(this)">
            <span id="faceFilterText">🔍 Tải ảnh lên</span>
          </label>
          <button class="btn" style="border-color: var(--ink); color: var(--ink); padding: 12px 24px; display: flex; align-items: center; gap: 8px;" onclick="startWebcam()">
            📸 Chụp trực tiếp
          </button>
          <!-- Nút hướng dẫn -->
          <button class="btn" style="border: none; background: transparent; padding: 12px; color: var(--smoke); display: flex; align-items: center; gap: 4px;" onclick="document.getElementById('guideOverlay').style.display='flex'">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            <span style="font-size: 13px; text-decoration: underline;">Hướng dẫn</span>
          </button>
        </div>
        
        <!-- Nút xóa lọc (ẩn mặc định) -->
        <button id="clearFilterBtn" class="btn" style="display: none; border-color: #dc3545; color: #dc3545; padding: 12px 24px;" onclick="clearFilter()">
          ✖ Bỏ lọc
        </button>
        
        <!-- Điều chỉnh độ chính xác -->
        <div id="thresholdControl" style="display: none; align-items: center; gap: 10px;">
          <span style="font-size: 11px; color: var(--smoke); white-space: nowrap;">Chính xác:</span>
          <input type="range" id="thresholdSlider" min="25" max="55" value="40" step="5"
            style="width: 100px;"
            oninput="document.getElementById('thresholdVal').innerText = (100 - this.value) + '%'; rerunFilter()">
          <span id="thresholdVal" style="font-size: 11px; color: var(--ink); font-weight: 600; white-space: nowrap;">60%</span>
        </div>
        
        <a href="/customer/download-album/<%= album.id %>" target="_blank" onclick="handleDownload()" class="btn btn-dark submit-btn" style="padding: 12px 24px;">
          <span>Tải Toàn Bộ (Zip) ↓</span>
        </a>
      </div>
    </div>

    <!-- Add loading script -->
    <script>
      function handleDownload() {
        // Change button text briefly to show action received
        const btn = document.querySelector('.submit-btn span');
        const oldText = btn.innerText;
        btn.innerText = "Đang chuẩn bị file...";
        setTimeout(() => {
          btn.innerText = oldText;
          window.location.reload();
        }, 2000);
      }
    </script>

    <% if (photos && photos.length > 0) { %>
      <!-- Photo Grid -->
      <div class="portfolio-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px;">
        <% photos.forEach(p => { %>
          <div class="portfolio-item reveal photo-card" data-id="<%= p.id %>" style="position: relative; overflow: hidden; border-radius: 4px; background: var(--bone);">
            <!-- Checkbox selection -->
            <input type="checkbox" class="photo-checkbox" value="<%= p.id %>" style="position: absolute; top: 12px; left: 12px; z-index: 10; width: 22px; height: 22px; cursor: pointer; accent-color: var(--ink);" onchange="toggleSelection()">
            <!-- Dùng GLightbox để xem full size siêu mượt -->
            <a href="<%= p.original_url %>" class="glightbox" data-gallery="album" data-title="<%= p.file_name %>">
              <img src="<%= p.thumbnail_url %>" alt="<%= p.file_name %>" style="width: 100%; height: 300px; object-fit: cover; transition: transform 0.3s ease;" class="hover-zoom">
            </a>
            
            <!-- Nút download lẻ -->
            <a href="<%= p.original_url %>" download="<%= p.file_name %>" 
               style="position: absolute; bottom: 12px; right: 12px; background: rgba(0,0,0,0.5); color: white; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 50%; backdrop-filter: blur(4px); transition: background 0.3s;"
               onmouseover="this.style.background='var(--ink)'" onmouseout="this.style.background='rgba(0,0,0,0.5)'">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            </a>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state" style="text-align: center; padding: 60px; background: var(--parchment);">
        Album này chưa có ảnh.
      </div>
    <% } %>

  </div>
</section>

<!-- Sticky Action Bar for custom download -->
<div id="actionBar" style="position: fixed; bottom: 0; left: 0; right: 0; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); padding: 16px 0; border-top: 1px solid rgba(0,0,0,0.1); display: none; z-index: 1000; box-shadow: 0 -4px 20px rgba(0,0,0,0.05);">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
    <span style="font-family: var(--font-display); font-size: 18px;">Đã chọn <b id="selectedCount">0</b> ảnh</span>
    <form method="POST" action="/customer/albums/<%= album.id %>/download-selected" id="customDownloadForm" target="_blank">
      <input type="hidden" name="imageIds" id="imageIdsInput">
      <button type="submit" class="btn btn-dark" style="padding: 8px 24px;" onclick="setTimeout(()=>window.location.reload(), 2000)">Tải Hình Đã Chọn</button>
    </form>
  </div>
</div>

<!-- Loading Overlay cho khách -->
<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 9999; flex-direction: column; align-items: center; justify-content: center; color: white;">
  <div style="width: 50px; height: 50px; border: 4px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20px;"></div>
  <h3 style="margin: 0; font-family: 'Outfit', sans-serif;">Đang phân tích khuôn mặt...</h3>
  <p style="color: #ccc; margin-top: 10px;">Vui lòng đợi trong giây lát</p>
</div>
<style>
  @keyframes spin { 100% { transform: rotate(360deg); } }
</style>

<!-- Webcam Overlay -->
<div id="webcamOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 10000; flex-direction: column; align-items: center; justify-content: center; color: white;">
  <h3 style="margin: 0 0 16px 0; font-family: 'Outfit', sans-serif;">Canh khuôn mặt của bạn vào khung hình</h3>
  <video id="webcamVideo" autoplay playsinline style="width: 100%; max-width: 400px; border-radius: 8px; transform: scaleX(-1); background: #000;"></video>
  <div style="display: flex; gap: 16px; margin-top: 24px;">
    <button class="btn" style="background: #dc3545; color: white; border: none; padding: 12px 24px;" onclick="closeWebcam()">Hủy</button>
    <button class="btn" style="background: #28a745; color: white; border: none; padding: 12px 24px;" onclick="captureWebcam()">📸 Chụp ngay</button>
  </div>
</div>

<!-- Guide Overlay -->
<div id="guideOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 10001; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
  <div style="background: white; padding: 32px; border-radius: 12px; max-width: 500px; width: 90%; color: var(--ink); position: relative;">
    <button style="position: absolute; top: 16px; right: 16px; background: none; border: none; font-size: 20px; cursor: pointer; color: var(--smoke);" onclick="document.getElementById('guideOverlay').style.display='none'">✖</button>
    
    <h3 style="margin-top: 0; margin-bottom: 16px; font-family: var(--font-display); font-size: 24px;">Cách tìm ảnh bằng khuôn mặt</h3>
    
    <div style="font-size: 14px; line-height: 1.6; color: #444;">
      <p style="margin-bottom: 12px;"><strong>Bước 1:</strong> Bấm <b>Tải ảnh lên</b> (chọn ảnh có rõ mặt bạn) hoặc <b>Chụp trực tiếp</b> bằng camera của điện thoại/máy tính.</p>
      
      <p style="margin-bottom: 12px;"><strong>Bước 2:</strong> Hệ thống AI sẽ tự động phân tích khuôn mặt của bạn và tìm ra tất cả các bức ảnh có sự xuất hiện của bạn trong album.</p>
      
      <p style="margin-bottom: 12px;"><strong>Thanh "Độ chính xác" (%):</strong>
        <ul style="margin-top: 4px; padding-left: 20px; margin-bottom: 12px;">
          <li>Mặc định AI lấy độ chính xác <b>60%</b>.</li>
          <li>Kéo thanh trượt lên <b>% cao hơn</b> (ví dụ 70-80%) nếu AI nhận nhầm người khác thành bạn (yêu cầu khuôn mặt cực kỳ giống ảnh mẫu).</li>
          <li>Kéo thanh trượt xuống <b>% thấp hơn</b> (ví dụ 40-50%) nếu AI bỏ sót ảnh của bạn (do bạn bị che mặt, quay nghiêng, hoặc nhắm mắt).</li>
        </ul>
      </p>
      
      <p style="margin-bottom: 0;"><strong>Bước 3:</strong> Bấm <b>Tải Hình Đã Chọn</b> ở dưới cùng màn hình để gom tất cả ảnh tìm được thành 1 file ZIP tải về máy.</p>
    </div>
    
    <div style="margin-top: 24px; text-align: center;">
      <button class="btn btn-dark" style="padding: 10px 24px;" onclick="document.getElementById('guideOverlay').style.display='none'">Đã hiểu</button>
    </div>
  </div>
</div>

<script>
  let _lastAllScores = {}; // cache {imageId: distance} for re-run
  let _stream = null;

  async function startWebcam() {
    try {
      _stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
      const video = document.getElementById('webcamVideo');
      video.srcObject = _stream;
      document.getElementById('webcamOverlay').style.display = 'flex';
    } catch (err) {
      alert("Không thể truy cập Camera: " + err.message);
    }
  }

  function closeWebcam() {
    if (_stream) {
      _stream.getTracks().forEach(t => t.stop());
      _stream = null;
    }
    document.getElementById('webcamOverlay').style.display = 'none';
  }

  function captureWebcam() {
    const video = document.getElementById('webcamVideo');
    const canvas = document.createElement('canvas');
    // Mặc định scale down để nhẹ ảnh
    const MAX = 640;
    const scale = Math.min(MAX / video.videoWidth, MAX / video.videoHeight, 1);
    canvas.width = Math.round(video.videoWidth * scale);
    canvas.height = Math.round(video.videoHeight * scale);
    const ctx = canvas.getContext('2d');
    
    // Lật ngược lại canvas vì video đang bị lật (mirror)
    ctx.translate(canvas.width, 0);
    ctx.scale(-1, 1);
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    
    canvas.toBlob(blob => {
      closeWebcam();
      sendToFaceFilterAPI(blob);
    }, 'image/jpeg', 0.85);
  }

  async function handleFaceFilter(input) {
    if (!input.files || !input.files[0]) return;
    document.getElementById('loadingOverlay').style.display = 'flex';

    // === Nén ảnh selfie xuống 640px ngay trên trình duyệt ===
    const file = input.files[0];
    let blob = file;
    try {
      const bmp = await createImageBitmap(file);
      const MAX = 640;
      const scale = Math.min(MAX / bmp.width, MAX / bmp.height, 1);
      const w = Math.round(bmp.width * scale);
      const h = Math.round(bmp.height * scale);
      const offscreen = new OffscreenCanvas ? new OffscreenCanvas(w, h) : document.createElement('canvas');
      offscreen.width = w; offscreen.height = h;
      const ctx = offscreen.getContext('2d');
      ctx.drawImage(bmp, 0, 0, w, h);
      blob = await new Promise(res => {
        if (offscreen.convertToBlob) {
          offscreen.convertToBlob({ type: 'image/jpeg', quality: 0.85 }).then(res);
        } else {
          offscreen.toBlob(res, 'image/jpeg', 0.85);
        }
      });
      bmp.close && bmp.close();
    } catch (e) {
      console.warn('Client compression skipped:', e);
      blob = file; // fallback: gửi file gốc
    }
    // ===================================================
    sendToFaceFilterAPI(blob);
  }

  async function sendToFaceFilterAPI(blob) {
    document.getElementById('loadingOverlay').style.display = 'flex';
    const formData = new FormData();
    formData.append('photo', blob, 'selfie.jpg');

    try {
      const res = await fetch(`/customer/albums/<%= album.id %>/filter-face`, {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      
      document.getElementById('loadingOverlay').style.display = 'none';

      if (data.success) {
        _lastAllScores = data.allScores || {};
        // Hiện thanh điều chỉnh và nút bỏ lọc
        document.getElementById('thresholdControl').style.display = 'flex';
        document.getElementById('clearFilterBtn').style.display = 'block';
        applyFilter(data.matchedIds, data.matchedIds.length);
        document.getElementById('faceFilterText').innerText = `✅ Đã tìm thấy ${data.matchedIds.length} ảnh`;
      } else {
        alert(data.message || "Không tìm thấy khuôn mặt nào.");
        document.getElementById('faceFilterText').innerText = "🔍 Tải ảnh lên";
      }
    } catch (e) {
      document.getElementById('loadingOverlay').style.display = 'none';
      alert("Lỗi khi xử lý ảnh. Thử lại sau.");
      document.getElementById('faceFilterText').innerText = "🔍 Tải ảnh lên";
    }
  }

  function applyFilter(matchedIds, count) {
    document.querySelectorAll('.photo-card').forEach(card => {
      const id = parseInt(card.dataset.id);
      const cb = card.querySelector('.photo-checkbox');
      if (matchedIds.includes(id)) {
        card.style.display = 'block';
        cb.checked = true;
      } else {
        card.style.display = 'none';
        cb.checked = false;
      }
    });
    const btnText = document.getElementById('faceFilterText');
    btnText.innerText = `✅ Tìm thấy ${count} ảnh`;
    toggleSelection();
  }

  function rerunFilter() {
    if (!Object.keys(_lastAllScores).length) return;
    const slider = document.getElementById('thresholdSlider');
    const threshold = parseInt(slider.value) / 100;
    const matchedIds = Object.entries(_lastAllScores)
      .filter(([id, dist]) => dist <= threshold)
      .map(([id]) => parseInt(id));
    applyFilter(matchedIds, matchedIds.length);
  }

  function clearFilter() {
    // Ẩn UI filter
    document.getElementById('thresholdControl').style.display = 'none';
    document.getElementById('clearFilterBtn').style.display = 'none';
    document.getElementById('faceFilterText').innerText = "🔍 Tải ảnh lên";
    document.getElementById('faceInput').value = ''; // reset input
    
    // Hiện lại tất cả ảnh
    document.querySelectorAll('.photo-card').forEach(card => {
      card.style.display = 'block';
      card.querySelector('.photo-checkbox').checked = false;
    });
    toggleSelection();
  }

  function toggleSelection() {
    const checkboxes = document.querySelectorAll('.photo-checkbox:checked');
    const count = checkboxes.length;
    const actionBar = document.getElementById('actionBar');
    const countSpan = document.getElementById('selectedCount');
    const idsInput = document.getElementById('imageIdsInput');
    
    if (count > 0) {
      actionBar.style.display = 'block';
      countSpan.innerText = count;
      const ids = Array.from(checkboxes).map(cb => cb.value);
      idsInput.value = ids.join(',');
    } else {
      actionBar.style.display = 'none';
    }
  }
</script>

<style>
.hover-zoom:hover { transform: scale(1.05); }
</style>
