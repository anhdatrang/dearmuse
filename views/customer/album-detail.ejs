<!-- SCRIPTS ĐIỀU KHIỂN CHUNG -->
<script>
  let _lastAllScores = {};
  let _stream = null;
  let activeTabName = 'original';

  // 1. Quản lý chuyển đổi các Tab
  function switchTab(tabName) {
    activeTabName = tabName;
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(content => content.style.display = 'none');
    
    document.getElementById('tab-btn-' + tabName).classList.add('active');
    document.getElementById('tab-content-' + tabName).style.display = 'block';

    // Style active tab
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.style.color = 'var(--smoke)';
      btn.style.borderBottomColor = 'transparent';
    });
    const activeBtn = document.getElementById('tab-btn-' + tabName);
    activeBtn.style.color = 'var(--ink)';
    activeBtn.style.borderBottomColor = 'var(--mocha)';
    
    // Quản lý hiển thị các Action Bar cố định
    const originalActionBar = document.getElementById('actionBar');
    const editActionBar = document.getElementById('editActionBar');
    
    if (tabName === 'original') {
      toggleSelection(); // hiện action bar tải ảnh gốc nếu có tích chọn
      editActionBar.style.display = 'none';
    } else if (tabName === 'select-edits') {
      originalActionBar.style.display = 'none';
      updateEditActionBarVisibility(); // hiện action bar gửi yêu cầu sửa ảnh nếu có tích
    } else {
      originalActionBar.style.display = 'none';
      editActionBar.style.display = 'none';
    }
  }

  // 2. Chụp khuôn mặt AI & Lọc ảnh gốc (Giữ nguyên tính năng cũ)
  async function startWebcam() {
    try {
      _stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
      const video = document.getElementById('webcamVideo');
      video.srcObject = _stream;
      document.getElementById('webcamOverlay').style.display = 'flex';
    } catch (err) {
      alert("Không thể truy cập Camera: " + err.message);
    }
  }

  function closeWebcam() {
    if (_stream) {
      _stream.getTracks().forEach(t => t.stop());
      _stream = null;
    }
    document.getElementById('webcamOverlay').style.display = 'none';
  }

  function captureWebcam() {
    const video = document.getElementById('webcamVideo');
    const canvas = document.createElement('canvas');
    const MAX = 640;
    const scale = Math.min(MAX / video.videoWidth, MAX / video.videoHeight, 1);
    canvas.width = Math.round(video.videoWidth * scale);
    canvas.height = Math.round(video.videoHeight * scale);
    const ctx = canvas.getContext('2d');
    
    ctx.translate(canvas.width, 0);
    ctx.scale(-1, 1);
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    
    canvas.toBlob(blob => {
      closeWebcam();
      sendToFaceFilterAPI(blob);
    }, 'image/jpeg', 0.85);
  }

  async function handleFaceFilter(input) {
    if (!input.files || !input.files[0]) return;
    const file = input.files[0];
    let blob = file;
    try {
      const bmp = await createImageBitmap(file);
      const MAX = 640;
      const scale = Math.min(MAX / bmp.width, MAX / bmp.height, 1);
      const w = Math.round(bmp.width * scale);
      const h = Math.round(bmp.height * scale);
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(bmp, 0, 0, w, h);
      blob = await new Promise(res => canvas.toBlob(res, 'image/jpeg', 0.85));
      bmp.close && bmp.close();
    } catch (e) {
      blob = file;
    }
    sendToFaceFilterAPI(blob);
  }

  async function sendToFaceFilterAPI(blob) {
    document.getElementById('loadingOverlay').style.display = 'flex';
    const formData = new FormData();
    formData.append('photo', blob, 'selfie.jpg');

    try {
      const res = await fetch(`/customer/albums/<%= album.id %>/filter-face`, {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      document.getElementById('loadingOverlay').style.display = 'none';

      if (data.success) {
        _lastAllScores = data.allScores || {};
        document.getElementById('thresholdControl').style.display = 'flex';
        document.getElementById('clearFilterBtn').style.display = 'block';
        applyFilter(data.matchedIds, data.matchedIds.length);
      } else {
        alert(data.message || "Không tìm thấy khuôn mặt nào.");
      }
    } catch (e) {
      document.getElementById('loadingOverlay').style.display = 'none';
      alert("Lỗi kết nối máy chủ.");
    }
  }

  function applyFilter(matchedIds, count) {
    document.querySelectorAll('.photo-card').forEach(card => {
      const id = parseInt(card.dataset.id);
      const cb = card.querySelector('.photo-checkbox');
      if (matchedIds.includes(id)) {
        card.style.display = 'block';
        cb.checked = true;
      } else {
        card.style.display = 'none';
        cb.checked = false;
      }
    });
    document.getElementById('faceFilterText').innerText = `✅ Đã tìm thấy ${count} ảnh`;
    toggleSelection();
  }

  function rerunFilter() {
    if (!Object.keys(_lastAllScores).length) return;
    const slider = document.getElementById('thresholdSlider');
    const threshold = parseInt(slider.value) / 100;
    const matchedIds = Object.entries(_lastAllScores)
      .filter(([id, dist]) => dist <= threshold)
      .map(([id]) => parseInt(id));
    applyFilter(matchedIds, matchedIds.length);
  }

  function clearFilter() {
    document.getElementById('thresholdControl').style.display = 'none';
    document.getElementById('clearFilterBtn').style.display = 'none';
    document.getElementById('faceFilterText').innerText = "🔍 Tải ảnh lên (AI)";
    document.getElementById('faceInput').value = '';
    
    document.querySelectorAll('.photo-card').forEach(card => {
      card.style.display = 'block';
      card.querySelector('.photo-checkbox').checked = false;
    });
    toggleSelection();
  }

  function toggleSelection() {
    if (activeTabName !== 'original') return;
    const checkboxes = document.querySelectorAll('.photo-checkbox:checked');
    const count = checkboxes.length;
    const actionBar = document.getElementById('actionBar');
    const countSpan = document.getElementById('selectedCount');
    const idsInput = document.getElementById('imageIdsInput');
    
    if (count > 0) {
      actionBar.style.display = 'block';
      countSpan.innerText = count;
      const ids = Array.from(checkboxes).map(cb => cb.value);
      idsInput.value = ids.join(',');
    } else {
      actionBar.style.display = 'none';
    }
  }

  // 3. Quản lý việc Chọn 10 Ảnh Chỉnh Sửa ở Tab 2
  let selectedEditPhotos = []; // Mảng chứa các đối tượng { imageId, note }

  function handleEditSelection(checkbox) {
    const imageId = checkbox.value;
    const isChecked = checkbox.checked;
    const card = document.getElementById('edit-card-' + imageId);
    const badge = document.getElementById('badge-' + imageId);
    const noteContainer = document.getElementById('note-container-' + imageId);

    if (isChecked) {
      // Giới hạn ảnh
      if (selectedEditPhotos.length >= <%= maxEditPhotos %>) {
        alert("Bạn chỉ được phép chọn tối đa <%= maxEditPhotos %> ảnh để chỉnh sửa.");
        checkbox.checked = false;
        return;
      }
      
      // Thêm vào mảng
      selectedEditPhotos.push({
        imageId: imageId,
        note: ''
      });

      // Hiển thị UI ghi chú & đường viền chọn
      card.style.borderColor = 'var(--mocha)';
      noteContainer.style.display = 'block';
      badge.style.display = 'inline-flex';
    } else {
      // Xoá khỏi mảng
      selectedEditPhotos = selectedEditPhotos.filter(item => item.imageId !== imageId);

      // Ẩn UI ghi chú & đường viền chọn
      card.style.borderColor = 'transparent';
      noteContainer.style.display = 'none';
      badge.style.display = 'none';
    }

    // Cập nhật lại số thứ tự huy hiệu (Badge Index #1, #2...)
    updateSelectionBadges();
    updateEditActionBarVisibility();
  }

  function updateSelectionBadges() {
    selectedEditPhotos.forEach((item, index) => {
      const badge = document.getElementById('badge-' + item.imageId);
      if (badge) badge.innerText = '#' + (index + 1);
    });
  }

  function updateEditActionBarVisibility() {
    const editActionBar = document.getElementById('editActionBar');
    const selectedCountSpan = document.getElementById('editSelectedCount');
    const count = selectedEditPhotos.length;

    if (count > 0 && activeTabName === 'select-edits') {
      editActionBar.style.display = 'block';
      selectedCountSpan.innerText = count;
    } else {
      editActionBar.style.display = 'none';
    }
  }

  // 4. Gửi yêu cầu chỉnh sửa lên Server
  async function submitPhotosToStudio() {
    if (selectedEditPhotos.length === 0) {
      alert("Vui lòng chọn ít nhất 1 ảnh.");
      return;
    }

    if (selectedEditPhotos.length > <%= maxEditPhotos %>) {
      alert("Bạn chỉ được chọn tối đa <%= maxEditPhotos %> ảnh.");
      return;
    }

    if (!confirm(`Bạn có chắc chắn muốn gửi yêu cầu chỉnh sửa cho ${selectedEditPhotos.length} ảnh này không? Bạn sẽ không thể thay đổi danh sách sau khi gửi.`)) {
      return;
    }

    // Đọc note hiện tại từ các textarea
    selectedEditPhotos.forEach(item => {
      const textarea = document.getElementById('note-' + item.imageId);
      if (textarea) {
        item.note = textarea.value.trim();
      }
    });

    try {
      const response = await fetch('/customer/albums/<%= album.id %>/submit-edit-request', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          selections: selectedEditPhotos
        })
      });

      const data = await response.json();
      if (data.success) {
        alert(data.message);
        window.location.reload();
      } else {
        alert(data.message || "Gửi thất bại, vui lòng kiểm tra lại.");
      }
    } catch (err) {
      console.error(err);
      alert("Lỗi hệ thống khi gửi yêu cầu.");
    }
  }

  function handleDownload() {
    const btn = document.querySelector('.submit-btn span');
    const oldText = btn.innerText;
    btn.innerText = "Đang chuẩn bị file...";
    setTimeout(() => {
      btn.innerText = oldText;
    }, 2000);
  }
</script>

