<% pageCss='concept-detail.css?v=3' ; %>

  <!-- Concept Detail Page -->
  <section class="concept-detail-section">
    <div class="container">

      <!-- Back to Services Button -->
      <div class="back-nav reveal">
        <a href="/services/<%= concept.id %>" class="btn-back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Bảng giá dịch vụ</span>
        </a>
      </div>

      <!-- Editorial Header -->
      <header class="concept-header reveal" data-delay="1">
        <span class="concept-category-label">
          <%= concept.categoryLabel %>
        </span>
        <h1 class="concept-title">
          <%= concept.name %>
        </h1>
        <p class="concept-subtitle">
          <%= concept.subtitle %>
        </p>
      </header>

      <!-- Hero Banner Image -->
      <div class="concept-hero-banner reveal" data-delay="2">
        <img src="<%= concept.coverImage %>" alt="<%= concept.name %>" loading="eager">
      </div>

      <!-- Editorial Story / Description -->
      <div class="concept-story-section reveal" data-delay="3">
        <div class="concept-story-grid">
          <div class="story-left">
            <blockquote class="editorial-quote">
              "Mỗi bức ảnh là một tác phẩm chứa đựng linh hồn, ánh sáng chân thực và cảm xúc tự nhiên nguyên bản nhất."
            </blockquote>
          </div>
          <div class="story-right">
            <p class="story-paragraph">
              <%= concept.description %>
            </p>
            <p class="story-paragraph">
              Với triết lý trân trọng những nét đẹp mộc mạc và chân thực, ekip Dear Musé sẽ luôn đồng hành và hỗ trợ bạn
              trong suốt quá trình chuẩn bị concept chụp. Chúng tôi tin rằng, khoảnh khắc đáng giá nhất chính là lúc bạn
              cảm thấy tự tin và tự nhiên nhất trước ống kính.
            </p>
          </div>
        </div>
      </div>

      <!-- Gallery Grid -->
      <section class="concept-gallery-section reveal" data-delay="4">
        <div class="text-center" style="margin-bottom: 48px;">
          <span class="section-label" style="justify-content: center;">Thư viện tác phẩm</span>
          <h2 class="section-heading" style="font-size: clamp(24px, 4vw, 36px);">Ảnh mẫu thực tế</h2>
        </div>

        <div class="concept-photo-grid">
          <% const gColCount=Math.min(3, Math.max(1, concept.gallery.length)); const gColumns=Array.from({length:
            gColCount}, ()=> []);
            concept.gallery.forEach((imgUrl, index) => {
            gColumns[index % gColCount].push({imgUrl, originalIndex: index});
            });
            %>
            <% gColumns.forEach((col, colIndex)=> { %>
              <div class="concept-photo-col">
                <% col.forEach(({imgUrl, originalIndex})=> { %>
                  <div class="gallery-photo-item">
                    <a href="<%= imgUrl %>" class="glightbox" data-gallery="concept-gallery"
                      aria-label="Xem ảnh phóng to">
                      <img src="<%= imgUrl %>" alt="<%= concept.name %> tác phẩm mẫu <%= originalIndex + 1 %>"
                        loading="lazy">
                      <div class="photo-overlay">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          <line x1="11" y1="8" x2="11" y2="14"></line>
                          <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                      </div>
                    </a>
                  </div>
                  <% }) %>
              </div>
              <% }) %>
        </div>
      </section>

      <% if (selectedPkg && selectedPkg.privileges && selectedPkg.privileges.length> 0) { %>
        <% const isPremium=selectedPkg.packageName.includes('Premium') || selectedPkg.packageName.includes('VIP') ||
          selectedPkg.packageName.includes('Gold') || selectedPkg.packageName.includes('Platinum') ||
          selectedPkg.packageName.includes('Siêu Thực'); %>
          
          <style>
            .mobile-break {
              display: none;
            }
            @media (max-width: 768px) {
              .concept-privileges-section .section-heading {
                font-size: 20px !important;
                line-height: 1.4 !important;
              }
              .mobile-break {
                display: block !important;
              }
              .concept-privileges-section {
                margin-top: 40px !important;
                padding: 0 15px !important;
              }
              .privileges-box {
                padding: 24px 16px !important;
                border-radius: 20px !important;
              }
            }
          </style>

          <!-- Customer Privileges Section -->
          <section class="concept-privileges-section reveal" data-delay="5"
            style="margin-top: 80px; margin-bottom: 40px;">
            <div class="container" style="max-width: 900px; margin: 0 auto;">
              <div class="text-center" style="margin-bottom: 48px;">
                <span class="section-label" style="justify-content: center; color: var(--logo-mocha);">
                  <%= isPremium ? 'Đặc Quyền Thượng Hạng' : 'Quyền Lợi Dành Cho Bạn' %>
                </span>
                <h2 class="section-heading"
                  style="font-size: clamp(24px, 4vw, 36px); font-family: var(--font-display); font-style: italic; color: var(--ink);">
                  <% if (isPremium) { %>
                    Quyền lợi vượt trội <br class="mobile-break"> so với gói Basic
                    <% } else { %>
                      Quyền lợi chi tiết <br class="mobile-break"> gói dịch vụ
                      <% } %>
                </h2>
                <% if (isPremium) { %>
                  <p style="font-family: var(--font-body); font-size: 14px; color: var(--smoke); margin-top: 8px;">
                    Khám phá những điểm khác biệt và nâng cấp đáng giá mà Dear Musé dành riêng cho gói <%=
                      selectedPkg.packageName %>
                  </p>
                  <% } %>
              </div>

              <div class="privileges-box"
                style="background: <%= isPremium ? 'rgba(253, 252, 247, 0.9)' : 'rgba(255, 255, 255, 0.4)' %>; border: <%= isPremium ? '2px solid rgba(201, 169, 110, 0.5)' : '1px solid rgba(26, 25, 22, 0.08)' %>; padding: 40px; border-radius: 24px; box-shadow: <%= isPremium ? '0 15px 40px rgba(201, 169, 110, 0.12)' : '0 10px 30px rgba(0,0,0,0.02)' %>;">
                <ul class="privileges-list"
                  style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 24px;">
                  <% selectedPkg.privileges.forEach(function(priv) { %>
                    <li style="display: flex; align-items: flex-start; gap: 16px;">
                      <div class="privilege-icon-wrap"
                        style="background: <%= isPremium ? '#F3EBDD' : 'rgba(26, 25, 22, 0.05)' %>; border-radius: 50%; padding: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 36px; height: 36px; margin-top: 2px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                          stroke="<%= isPremium ? '#c9a96e' : '#1a1916' %>" stroke-width="2" stroke-linecap="round"
                          stroke-linejoin="round">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      </div>
                      <span
                        style="font-family: var(--font-body); font-size: 15px; line-height: 1.7; color: var(--ink); font-weight: 300;">
                        <%- priv.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>' ) %>
                      </span>
                    </li>
                    <% }) %>
                </ul>
              </div>
            </div>
          </section>
          <% } %>

            <!-- Booking CTA -->
            <section class="concept-cta-section reveal" data-delay="6">
              <div class="cta-card">
                <h2 class="cta-heading">Cùng viết nên câu chuyện của riêng bạn</h2>
                <p class="cta-desc">Hãy chia sẻ với chúng tôi về những ý tưởng, trang phục hoặc bối cảnh bạn hằng mong
                  ước.
                  Đội ngũ Dear Musé sẽ liên hệ tư vấn chi tiết hoàn toàn miễn phí.</p>
                <div class="cta-actions">
                  <a href="/booking?service=<%= concept.id %>" class="btn btn-dark-filled">
                    <span>Đăng ký đặt lịch ngay →</span>
                  </a>
                  <a href="/contact" class="btn btn-outline-dark">
                    <span>Liên hệ tư vấn concept</span>
                  </a>
                </div>
              </div>
            </section>

    </div>
  </section>