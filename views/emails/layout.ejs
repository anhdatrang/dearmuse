<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      background-color: #f7f6f2; /* Beige nhẹ giống màu nền website */
      color: #1c1c1c;
      -webkit-font-smoothing: antialiased;
    }
    .wrapper {
      width: 100%;
      table-layout: fixed;
      background-color: #f7f6f2;
      padding-bottom: 60px;
    }
    .main {
      background-color: #ffffff;
      margin: 0 auto;
      width: 100%;
      max-width: 600px;
      border-spacing: 0;
      color: #1c1c1c;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      margin-top: 40px;
    }
    .header {
      padding: 40px 0 30px;
      text-align: center;
      background-color: #f2ede4; /* Màu be của website */
      color: #1c1c1c;            /* Chữ tối màu dễ đọc trên nền be */
      border-bottom: 1px solid #ede8df;
    }
    .header h1 {
      margin: 0;
      font-size: 28px;
      font-weight: 300;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .content {
      padding: 40px 40px 20px;
      line-height: 1.6;
    }
    .footer {
      text-align: center;
      padding: 30px 40px;
      font-size: 13px;
      color: #8c8c8c;
      background-color: #faf9f6;
      border-top: 1px solid #eeeeee;
    }
    .footer a {
      color: #1c1c1c;
      text-decoration: none;
      font-weight: 500;
    }
    .btn {
      display: inline-block;
      padding: 12px 30px;
      background-color: #1c1c1c;
      color: #ffffff !important;
      text-decoration: none;
      border-radius: 4px;
      font-weight: 500;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-size: 14px;
      margin-top: 20px;
    }
    .otp-box {
      background-color: #f7f6f2;
      padding: 20px;
      text-align: center;
      font-size: 32px;
      font-weight: 600;
      letter-spacing: 8px;
      color: #1c1c1c;
      border-radius: 6px;
      margin: 30px 0;
    }
  </style>
</head>
<body>
  <center class="wrapper">
    <table class="main" width="100%">
      <tr>
        <td class="header">
          <h1>Dear Musé</h1>
        </td>
      </tr>
      <tr>
        <td class="content">
          <%- body %>
        </td>
      </tr>
      <tr>
        <td class="footer">
          <p>© 2025 Dear Musé Studio. All rights reserved.</p>
          <p>Hà Nội, Việt Nam | <a href="https://dearmuse.com">dearmuse.com</a></p>
        </td>
      </tr>
    </table>
  </center>
</body>
</html>
