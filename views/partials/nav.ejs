<header class="site-header" id="site-header">
  <nav class="nav-inner">
    <!-- Nhóm trái -->
    <ul class="nav-left">
      <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Trang chủ</a></li>
      <li><a href="/services" class="<%= currentPath === '/services' ? 'active' : '' %>">Dịch vụ</a></li>
      <li><a href="/portfolio" class="<%= currentPath.startsWith('/portfolio') ? 'active' : '' %>">Portfolio</a></li>
      <li><a href="/blog" class="<%= currentPath.startsWith('/blog') ? 'active' : '' %>">TIN TỨC</a></li>
      <li><a href="/loyalty" class="<%= currentPath.startsWith('/loyalty') ? 'active' : '' %>">Tích điểm</a></li>
    </ul>

    <!-- Logo trung tâm -->
    <a href="/" class="nav-logo" aria-label="Trang chủ Dear Musé">
      <img src="/logo/logo.webp" alt="Dear Musé Photo Studio" height="64">
    </a>

    <!-- Nhóm phải -->
    <ul class="nav-right">
      <li><a href="/pricing" class="<%= currentPath === '/pricing' ? 'active' : '' %>">Bảng giá</a></li>
      <li><a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">Về chúng tôi</a></li>
      <li><a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Liên hệ</a></li>

      <!-- Chuông thông báo -->
      <li class="nav-notification-container" style="position: relative; display: flex; align-items: center;">
        <button id="notification-bell" aria-label="Thông báo" style="background: none; border: none; color: inherit; padding: 8px; display: flex; align-items: center; position: relative; transition: color 0.3s; outline: none; cursor: pointer;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="bell-svg">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
          <span class="bell-badge" style="display: none; position: absolute; top: 6px; right: 6px; width: 8px; height: 8px; background: #ef4444; border-radius: 50%; border: 1.5px solid white;"></span>
        </button>

        <!-- Dropdown panel -->
        <div id="notification-dropdown" style="display: none; position: absolute; top: 100%; right: 0; width: 340px; background: rgba(255, 255, 255, 0.98); border: 1px solid var(--bone); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); margin-top: 12px; z-index: 1000; overflow: hidden; animation: fadeIn 0.2s ease-out;">
          <div style="padding: 14px 16px; border-bottom: 1px solid var(--bone); display: flex; justify-content: space-between; align-items: center; background: rgba(122,92,74,0.02); border-top-left-radius: 12px; border-top-right-radius: 12px;">
            <span style="font-weight: 600; font-size: 14px; font-family: var(--font-body); color: var(--mocha);">Thông báo mới</span>
            <span id="unread-count-text" style="font-size: 11px; color: var(--smoke);">Chưa đọc</span>
          </div>
          <div id="notification-list" style="max-height: 320px; overflow-y: auto;">
            <div style="padding: 24px; text-align: center; color: var(--smoke); font-size: 13.5px;">Đang tải...</div>
          </div>
        </div>
      </li>

      <li>
        <a href="<%= typeof sessionUser !== 'undefined' && sessionUser ? '/customer/my-albums' : '/auth/login' %>" 
           class="<%= currentPath.startsWith('/auth') || currentPath.startsWith('/customer') ? 'active' : '' %>">
          <svg style="display:inline-block; vertical-align:middle; margin-right: 4px;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <%= typeof sessionUser !== 'undefined' && sessionUser ? 'Tài khoản' : 'Khách' %>
        </a>
      </li>
      <li><a href="/booking" class="nav-cta"><span>Đặt lịch</span></a></li>
    </ul>

    <!-- Hamburger (mobile) -->
    <button class="nav-hamburger" id="hamburger" aria-label="Mở menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>
</header>

<style>
  /* Bell shaking animation */
  @keyframes bell-ring {
    0%, 100% { transform: rotate(0); }
    10%, 30%, 50%, 70%, 90% { transform: rotate(8deg); }
    20%, 40%, 60%, 80% { transform: rotate(-8deg); }
  }
  .bell-svg {
    transition: transform 0.2s;
  }
  .nav-notification-container.active-unread .bell-svg {
    animation: bell-ring 1.8s ease-in-out infinite;
    transform-origin: top center;
    color: var(--mocha);
  }
  .nav-notification-container.active-unread .bell-badge {
    display: block !important;
    animation: pulse-badge 1.8s infinite;
  }
  @keyframes pulse-badge {
    0% { transform: scale(0.9); opacity: 0.9; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(0.9); opacity: 0.9; }
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  /* Notification Item Styling */
  .noti-item {
    padding: 14px 16px;
    border-bottom: 1px solid var(--bone);
    transition: background 0.2s;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
  }
  .noti-item:hover {
    background: rgba(122,92,74,0.03);
  }
  .noti-item.unread {
    background: rgba(212,219,116,0.08);
    border-left: 3px solid var(--mocha);
  }
  .noti-badge {
    font-size: 9px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
    display: inline-block;
    width: fit-content;
    letter-spacing: 0.05em;
  }
  .noti-badge.announcement {
    background: #fee2e2;
    color: #ef4444;
  }
  .noti-badge.personal {
    background: #dbeafe;
    color: #3b82f6;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const bellBtn = document.getElementById('notification-bell');
    const dropdown = document.getElementById('notification-dropdown');
    const container = document.querySelector('.nav-notification-container');
    const notiList = document.getElementById('notification-list');
    const unreadCountText = document.getElementById('unread-count-text');

    let allNotis = [];
    let isDropdownOpen = false;

    // Fetch notifications
    async function loadNotifications() {
      try {
        const res = await fetch('/customer/api/notifications');
        const data = await res.json();
        if (data.success) {
          allNotis = data.notifications;
          renderNotifications();
          checkUnreadStatus();
        }
      } catch (err) {
        console.error('Error loading notifications:', err);
      }
    }

    function checkUnreadStatus() {
      const lastReadTime = localStorage.getItem('last_read_announcement_time') || 0;
      let hasUnread = false;
      let unreadCount = 0;

      allNotis.forEach(n => {
        if (n.type === 'announcement') {
          if (new Date(n.created_at) > new Date(lastReadTime)) {
            hasUnread = true;
            unreadCount++;
          }
        } else if (n.type === 'personal') {
          if (!n.is_read) {
            hasUnread = true;
            unreadCount++;
          }
        }
      });

      if (hasUnread) {
        container.classList.add('active-unread');
        unreadCountText.innerText = `${unreadCount} chưa đọc`;
      } else {
        container.classList.remove('active-unread');
        unreadCountText.innerText = 'Không có thông báo mới';
      }
    }

    function formatRelativeTime(dateStr) {
      const date = new Date(dateStr);
      const diffMs = new Date() - date;
      const diffSec = Math.floor(diffMs / 1000);
      const diffMin = Math.floor(diffSec / 60);
      const diffHr = Math.floor(diffMin / 60);
      const diffDays = Math.floor(diffHr / 24);

      if (diffSec < 60) return 'Vừa xong';
      if (diffMin < 60) return `${diffMin} phút trước`;
      if (diffHr < 24) return `${diffHr} giờ trước`;
      return `${diffDays} ngày trước`;
    }

    function renderNotifications() {
      if (allNotis.length === 0) {
        notiList.innerHTML = `<div style="padding: 24px; text-align: center; color: var(--smoke); font-size: 13.5px;">Không có thông báo nào.</div>`;
        return;
      }

      const lastReadTime = localStorage.getItem('last_read_announcement_time') || 0;

      notiList.innerHTML = allNotis.map(n => {
        let isUnread = false;
        if (n.type === 'announcement') {
          isUnread = new Date(n.created_at) > new Date(lastReadTime);
        } else {
          isUnread = !n.is_read;
        }

        const badgeClass = n.type === 'announcement' ? 'announcement' : 'personal';
        const badgeLabel = n.type === 'announcement' ? 'Ưu đãi' : 'Cá nhân';

        return `
          <div class="noti-item ${isUnread ? 'unread' : ''}">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span class="noti-badge ${badgeClass}">${badgeLabel}</span>
              <span style="font-size: 11px; color: var(--smoke);">${formatRelativeTime(n.created_at)}</span>
            </div>
            <div style="font-weight: 600; font-size: 13px; color: var(--ink); margin-top: 4px;">${n.title}</div>
            <div style="font-size: 12.5px; color: var(--smoke); line-height: 1.4; margin-top: 2px; word-break: break-word;">${n.content}</div>
          </div>
        `;
      }).join('');
    }

    async function markAsRead() {
      // 1. Mark announcements read locally
      if (allNotis.length > 0) {
        const announcementsOnly = allNotis.filter(n => n.type === 'announcement');
        if (announcementsOnly.length > 0) {
          const latestTime = announcementsOnly[0].created_at;
          localStorage.setItem('last_read_announcement_time', latestTime);
        }
      }

      // 2. Mark personal read in DB
      const hasUnreadPersonal = allNotis.some(n => n.type === 'personal' && !n.is_read);
      if (hasUnreadPersonal) {
        try {
          await fetch('/customer/api/notifications/read', { method: 'POST' });
        } catch (err) {
          console.error(err);
        }
      }

      checkUnreadStatus();
    }

    // Toggle dropdown
    bellBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      isDropdownOpen = !isDropdownOpen;
      if (isDropdownOpen) {
        dropdown.style.display = 'block';
        loadNotifications().then(() => {
          markAsRead();
        });
      } else {
        dropdown.style.display = 'none';
      }
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target)) {
        dropdown.style.display = 'none';
        isDropdownOpen = false;
      }
    });

    // Initial load
    loadNotifications();
    // Refresh every 30 seconds
    setInterval(loadNotifications, 30000);
  });
</script>
