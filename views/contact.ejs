<%
  pageCss = 'booking.css';
%>

<!-- Contact Page -->
<section style="padding-top: 120px; padding-bottom: var(--section-gap);">
  <div class="container">

    <div style="max-width: 480px; margin-bottom: 64px;">
      <span class="section-label reveal">Liên hệ</span>
      <h1 class="section-heading reveal" style="font-size: clamp(32px, 4vw, 48px);">Hãy kể cho chúng tôi nghe</h1>
      <p class="body-text reveal" style="margin-top: 12px;">Bất kể là hỏi về giá, chia sẻ concept hay chỉ đơn giản muốn nói xin chào — chúng tôi đều muốn được nghe từ bạn.</p>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 400px; gap: 80px; align-items: start;">

      <!-- Form -->
      <div class="contact-form-section">
        <% if (sent) { %>
          <div style="background: var(--parchment); border-left: 2px solid var(--avocado-cream); padding: 28px 32px; margin-bottom: 40px;">
            <h3 style="font-family: var(--font-display); font-size: 22px; font-style: italic; color: var(--ink); margin-bottom: 8px;">Cảm ơn bạn! ✦</h3>
            <p class="body-text" style="font-size: 14px;">Tin nhắn đã được gửi. Chúng tôi sẽ phản hồi trong vòng 24 giờ.</p>
          </div>
        <% } %>

        <% if (errors.length > 0) { %>
          <ul class="error-list">
            <% errors.forEach(e => { %><li><%= e.msg %></li><% }) %>
          </ul>
        <% } %>

        <form method="POST" action="/contact" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Họ tên <span class="form-required">*</span></label>
              <input type="text" id="name" name="name"
                     value="<%= oldInput.name || '' %>"
                     placeholder="Nguyễn Văn A" required autocomplete="name">
            </div>
            <div class="form-group">
              <label for="phone">Số điện thoại</label>
              <input type="tel" id="phone" name="phone"
                     value="<%= oldInput.phone || '' %>"
                     placeholder="0912 345 678" autocomplete="tel">
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email"
                   value="<%= oldInput.email || '' %>"
                   placeholder="email@example.com" autocomplete="email">
          </div>

          <div class="form-group">
            <label for="subject">Tiêu đề</label>
            <input type="text" id="subject" name="subject"
                   value="<%= oldInput.subject || '' %>"
                   placeholder="Hỏi về dịch vụ portrait...">
          </div>

          <div class="form-group">
            <label for="message">Nội dung <span class="form-required">*</span></label>
            <textarea id="message" name="message" rows="5"
                      placeholder="Chia sẻ gì đó với chúng tôi..." required><%= oldInput.message || '' %></textarea>
          </div>

          <button type="submit" class="btn btn-dark submit-btn">
            Gửi tin nhắn →
          </button>
        </form>
      </div>

      <!-- Contact Info -->
      <aside style="position: sticky; top: 100px; display: flex; flex-direction: column; gap: 36px;">
        <div>
          <h3 style="font-family: var(--font-body); font-size: 11px; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--logo-taupe); margin-bottom: 16px;">Thông tin liên hệ</h3>
          <div style="display: flex; flex-direction: column; gap: 16px;">
            <div class="sidebar-info-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9C8474" stroke-width="1.5" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12.7 19.79 19.79 0 0 1 1.61 4.12 2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l1.27-.73a2 2 0 0 1 2.11.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <div>
                <strong style="display: block; font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--logo-taupe); margin-bottom: 2px;">Điện thoại</strong>
                <span style="font-size: 14px; font-weight: 300; color: var(--smoke);">Liên hệ qua Facebook / Instagram</span>
              </div>
            </div>
            <div class="sidebar-info-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9C8474" stroke-width="1.5" stroke-linecap="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              <div>
                <strong style="display: block; font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--logo-taupe); margin-bottom: 2px;">Facebook</strong>
                <a href="#" style="font-size: 14px; font-weight: 300; color: var(--smoke); text-decoration: none;">Dear Musé Studio</a>
              </div>
            </div>
            <div class="sidebar-info-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9C8474" stroke-width="1.5" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              <div>
                <strong style="display: block; font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--logo-taupe); margin-bottom: 2px;">Instagram</strong>
                <a href="#" style="font-size: 14px; font-weight: 300; color: var(--smoke); text-decoration: none;">@dearmuse.studio</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Note -->
        <div style="padding: 24px; background: var(--parchment); border-left: 2px solid var(--avocado-cream);">
          <p style="font-size: 13px; font-weight: 300; color: var(--smoke); line-height: 1.7;">
            Muốn đặt lịch trực tiếp?
            <a href="/booking" style="color: var(--logo-mocha); font-weight: 500;">Dùng form đặt lịch →</a>
          </p>
        </div>
      </aside>

    </div>
  </div>
</section>

<style>
.sidebar-info-item {
  display: flex;
  gap: 14px;
  align-items: flex-start;
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
@media (max-width: 1024px) {
  [style*="grid-template-columns: 1fr 400px"] {
    grid-template-columns: 1fr !important;
  }
  [style*="position: sticky"] {
    position: static !important;
  }
  .form-row {
    grid-template-columns: 1fr !important;
  }
}
</style>
