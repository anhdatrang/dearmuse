<% pageCss='concept-detail.css?v=2' ; %>

  <!-- Concept Detail Page -->
  <section class="concept-detail-section">
    <div class="container">

      <!-- Back to Services Button -->
      <div class="back-nav reveal">
        <a href="/services" class="btn-back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Danh sách dịch vụ</span>
        </a>
      </div>

      <!-- Editorial Header -->
      <header class="concept-header reveal" data-delay="1">
        <span class="concept-category-label">
          <%= concept.categoryLabel %>
        </span>
        <h1 class="concept-title">
          <%= concept.name %>
        </h1>
        <p class="concept-subtitle">
          <%= concept.subtitle %>
        </p>
      </header>



      <!-- Pricing Packages Table -->
      <section class="concept-pricing-section reveal" data-delay="5">
        <div class="text-center" style="margin-bottom: 64px;">
          <span class="section-label" style="justify-content: center;">Báo giá chi tiết</span>
          <h2 class="section-heading" style="font-size: clamp(24px, 4vw, 36px);">Các gói dịch vụ & quyền lợi</h2>
        </div>

        <!-- Packages Grid -->
        <div class="packages-grid">
          <% concept.pricing.forEach((pkg, index) => { %>
            <div class="package-detail-card">
              <div class="pkg-header">
                <h3 class="pkg-name">
                  <%= pkg.packageName %>
                </h3>
                <div class="pkg-price">
                  <%= pkg.price %>
                </div>
              </div>

              <div class="pkg-body">
                <h4 class="pkg-details-title">Chi tiết dịch vụ bao gồm:</h4>
                <ul class="pkg-inclusions">
                  <% pkg.inclusions.forEach(inc=> { %>
                    <li>
                      <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>
                        <%= inc %>
                      </span>
                    </li>
                    <% }) %>
                </ul>
                <div class="pkg-footer" style="margin-top: 24px; text-align: center;">
                  <a href="/services/<%= concept.id %>/details?pkg=<%= index %>" class="btn btn-outline-dark"
                    style="border-radius: 30px; font-size: 13px; padding: 10px 24px;"><span>Xem chi tiết concept</span></a>
                </div>
              </div>
            </div>
            <% }) %>
        </div>

        <!-- Addons Table (if exists) -->
        <% if (concept.addons && concept.addons.length> 0) { %>
          <div class="addons-container">
            <h3 class="addons-title">Dịch vụ & Tiện ích cộng thêm (Tùy chọn)</h3>
            <div class="addons-table-wrap">
              <table class="addons-table">
                <thead>
                  <tr>
                    <th>Hạng mục dịch vụ</th>
                    <th class="text-right">Mức chi phí</th>
                  </tr>
                </thead>
                <tbody>
                  <% concept.addons.forEach(addon=> { %>
                    <tr>
                      <td>
                        <%= addon.name %>
                      </td>
                      <td class="text-right highlight-price">
                        <%= addon.price %>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
            </div>
          </div>
          <% } %>
      </section>

      <!-- Booking CTA -->
      <section class="concept-cta-section reveal" data-delay="6">
        <div class="cta-card">
          <h2 class="cta-heading">Cùng viết nên câu chuyện của riêng bạn</h2>
          <p class="cta-desc">Hãy chia sẻ với chúng tôi về những ý tưởng, trang phục hoặc bối cảnh bạn hằng mong ước.
            Đội ngũ Dear Musé sẽ liên hệ tư vấn chi tiết hoàn toàn miễn phí.</p>
          <div class="cta-actions">
            <a href="/booking?service=<%= concept.id %>" class="btn btn-dark-filled">
              <span>Đăng ký đặt lịch ngay →</span>
            </a>
            <a href="/contact" class="btn btn-outline-dark">
              <span>Liên hệ tư vấn concept</span>
            </a>
          </div>
        </div>
      </section>

    </div>
  </section>