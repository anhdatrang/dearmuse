<% pageCss = 'concept-detail.css?v=2'; %>

<!-- Concept Detail Page -->
<section class="concept-detail-section">
  <div class="container">
    
    <!-- Back to Services Button -->
    <div class="back-nav reveal">
      <a href="/services" class="btn-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Danh sách dịch vụ</span>
      </a>
    </div>

    <!-- Editorial Header -->
    <header class="concept-header reveal" data-delay="1">
      <span class="concept-category-label"><%= concept.categoryLabel %></span>
      <h1 class="concept-title"><%= concept.name %></h1>
      <p class="concept-subtitle"><%= concept.subtitle %></p>
    </header>

    <!-- Hero Banner Image -->
    <div class="concept-hero-banner reveal" data-delay="2">
      <img src="<%= concept.coverImage %>" alt="<%= concept.name %>" loading="eager">
    </div>

    <!-- Editorial Story / Description -->
    <div class="concept-story-section reveal" data-delay="3">
      <div class="concept-story-grid">
        <div class="story-left">
          <blockquote class="editorial-quote">
            "Mỗi bức ảnh là một tác phẩm chứa đựng linh hồn, ánh sáng chân thực và cảm xúc tự nhiên nguyên bản nhất."
          </blockquote>
        </div>
        <div class="story-right">
          <p class="story-paragraph">
            <%= concept.description %>
          </p>
          <p class="story-paragraph">
            Với triết lý trân trọng những nét đẹp mộc mạc và chân thực, ekip Dear Musé sẽ luôn đồng hành và hỗ trợ bạn trong suốt quá trình chuẩn bị concept chụp. Chúng tôi tin rằng, khoảnh khắc đáng giá nhất chính là lúc bạn cảm thấy tự tin và tự nhiên nhất trước ống kính.
          </p>
        </div>
      </div>
    </div>

    <!-- Gallery Grid -->
    <section class="concept-gallery-section reveal" data-delay="4">
      <div class="text-center" style="margin-bottom: 48px;">
        <span class="section-label" style="justify-content: center;">Thư viện tác phẩm</span>
        <h2 class="section-heading" style="font-size: clamp(24px, 4vw, 36px);">Ảnh mẫu thực tế</h2>
      </div>

      <div class="concept-photo-grid">
        <% const gColCount = Math.min(3, Math.max(1, concept.gallery.length));
           const gColumns = Array.from({length: gColCount}, () => []);
           concept.gallery.forEach((imgUrl, index) => {
             gColumns[index % gColCount].push({imgUrl, originalIndex: index});
           });
        %>
        <% gColumns.forEach((col, colIndex) => { %>
          <div class="concept-photo-col">
            <% col.forEach(({imgUrl, originalIndex}) => { %>
              <div class="gallery-photo-item">
                <a href="<%= imgUrl %>" class="glightbox" data-gallery="concept-gallery" aria-label="Xem ảnh phóng to">
                  <img src="<%= imgUrl %>" alt="<%= concept.name %> tác phẩm mẫu <%= originalIndex + 1 %>" loading="lazy">
                  <div class="photo-overlay">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      <line x1="11" y1="8" x2="11" y2="14"></line>
                      <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                  </div>
                </a>
              </div>
            <% }) %>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Pricing Packages Table -->
    <section class="concept-pricing-section reveal" data-delay="5">
      <div class="text-center" style="margin-bottom: 64px;">
        <span class="section-label" style="justify-content: center;">Báo giá chi tiết</span>
        <h2 class="section-heading" style="font-size: clamp(24px, 4vw, 36px);">Các gói dịch vụ & quyền lợi</h2>
      </div>

      <!-- Packages Grid -->
      <div class="packages-grid">
        <% concept.pricing.forEach(pkg => { %>
          <div class="package-detail-card">
            <div class="pkg-header">
              <h3 class="pkg-name"><%= pkg.packageName %></h3>
              <div class="pkg-price"><%= pkg.price %></div>
            </div>
            
            <div class="pkg-body">
              <h4 class="pkg-details-title">Chi tiết dịch vụ bao gồm:</h4>
              <ul class="pkg-inclusions">
                <% pkg.inclusions.forEach(inc => { %>
                  <li>
                    <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span><%= inc %></span>
                  </li>
                <% }) %>
              </ul>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Addons Table (if exists) -->
      <% if (concept.addons && concept.addons.length > 0) { %>
        <div class="addons-container">
          <h3 class="addons-title">Dịch vụ & Tiện ích cộng thêm (Tùy chọn)</h3>
          <div class="addons-table-wrap">
            <table class="addons-table">
              <thead>
                <tr>
                  <th>Hạng mục dịch vụ</th>
                  <th class="text-right">Mức chi phí</th>
                </tr>
              </thead>
              <tbody>
                <% concept.addons.forEach(addon => { %>
                  <tr>
                    <td><%= addon.name %></td>
                    <td class="text-right highlight-price"><%= addon.price %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </section>

    <!-- Booking CTA -->
    <section class="concept-cta-section reveal" data-delay="6">
      <div class="cta-card">
        <h2 class="cta-heading">Cùng viết nên câu chuyện của riêng bạn</h2>
        <p class="cta-desc">Hãy chia sẻ với chúng tôi về những ý tưởng, trang phục hoặc bối cảnh bạn hằng mong ước. Đội ngũ Dear Musé sẽ liên hệ tư vấn chi tiết hoàn toàn miễn phí.</p>
        <div class="cta-actions">
          <a href="/booking?service=<%= concept.id %>" class="btn btn-dark-filled">
            <span>Đăng ký đặt lịch ngay →</span>
          </a>
          <a href="/contact" class="btn btn-outline-dark">
            <span>Liên hệ tư vấn concept</span>
          </a>
        </div>
      </div>
    </section>

  </div>
</section>
