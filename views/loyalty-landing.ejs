              <div class="biz-col-header">
                <div class="biz-col-badge biz-badge-lumiere">MUSÉ LUMIÈRE</div>
                <div class="biz-col-range">
                  <%= tierLimits.tier_limit_frame_lumiere.toLocaleString('vi-VN') %>+ Mảnh Sáng
