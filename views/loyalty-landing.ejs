                <div class="biz-voucher-item">
                  <div class="biz-pts">500</div>
                  <div class="biz-pts-sep">✦</div>
                  <div class="biz-benefit">Tặng 5 ảnh chỉnh màu bổ sung</div>
                </div>
                <div class="biz-voucher-item">
                  <div class="biz-pts">900</div>
                  <div class="biz-pts-sep">✦</div>
                  <div class="biz-benefit">Nâng cấp moodboard cơ bản cho campaign</div>
                </div>
              </div>
            </div>

            <!-- LUMIÈRE COLUMN -->
