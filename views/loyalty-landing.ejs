<%- contentFor('body') %>
  <link rel="stylesheet" href="/css/loyalty.css?v=15">

  <% if (sessionUser && sessionUser.type==='business' ) { %>
    <div class="loyalty-landing-page business-theme">
      <div class="container">
        <div class="loyalty-hero">
          <h1>The Musé Business Cards</h1>
          <p>Chương trình Khách Hàng Thân Thiết độc quyền dành cho Doanh&nbsp;Nghiệp. Tích luỹ Mảnh&nbsp;Sáng sau mỗi
            lần trải nghiệm để nâng&nbsp;hạng&nbsp;thẻ và nhận những đặc&nbsp;quyền doanh&nbsp;nghiệp
            cao&nbsp;cấp&nbsp;nhất.</p>

          <% if (!sessionUser) { %>
            <button class="btn-primary" onclick="window.location.href='/auth/login?redirect=/loyalty'">Đăng Nhập Để Mở
              Thẻ</button>
            <% } else { %>
              <button class="btn-primary" id="btn-open-card">Tạo Thẻ Thành Viên Ngay</button>
              <% } %>
        </div>

        <!-- Cards Showcase for Business -->
        <div class="cards-showcase" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
          <!-- FRAME -->
          <div class="v-card tier-frame">
            <div class="v-card-content">
              <div class="v-card-header">
                <div class="v-card-brand">
                  <div class="v-card-brand-name">Dear Musé</div>
                  <div class="v-card-brand-sub">Business · Member Card</div>
                </div>
                <div class="v-card-tier-badge">
                  <div class="v-card-tier-name">Frame</div>
                  <div class="v-card-tier-dots"><span></span><span></span><span></span></div>
                </div>
              </div>
              <div class="v-card-middle">
                <div class="v-card-chip"></div>
              </div>
              <div class="v-card-footer">
                <div class="v-card-number">DM26 •••• •••• 1001</div>
                <div class="v-card-footer-row">
                  <div>
                    <div class="v-card-holder-label">Doanh nghiệp</div>
                    <div class="v-card-name">
                      <%= sessionUser.name %>
                    </div>
                  </div>
                  <div class="v-card-tier-range">
                    <div class="v-card-tier-range-label">Mảnh Sáng</div>
                    <div class="v-card-tier-range-value">0 – <%= (tierLimits.tier_limit_frame_lumiere -
                        1).toLocaleString('vi-VN') %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- LUMIERE -->
          <div class="v-card tier-lumiere">
            <div class="v-card-content">
              <div class="v-card-header">
                <div class="v-card-brand">
                  <div class="v-card-brand-name">Dear Musé</div>
                  <div class="v-card-brand-sub">Business · Member Card</div>
                </div>
                <div class="v-card-tier-badge">
                  <div class="v-card-tier-name">Lumière</div>
                  <div class="v-card-tier-dots"><span></span><span></span><span></span></div>
                </div>
              </div>
              <div class="v-card-middle">
                <div class="v-card-chip"></div>
              </div>
              <div class="v-card-footer">
                <div class="v-card-number">DM26 •••• •••• 2002</div>
                <div class="v-card-footer-row">
                  <div>
                    <div class="v-card-holder-label">Doanh nghiệp</div>
                    <div class="v-card-name">
                      <%= sessionUser.name %>
                    </div>
                  </div>
                  <div class="v-card-tier-range">
                    <div class="v-card-tier-range-label">Mảnh Sáng</div>
                    <div class="v-card-tier-range-value">
                      <%= tierLimits.tier_limit_frame_lumiere.toLocaleString('vi-VN') %>+
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="loyalty-info">
          <h2>Cơ chế hoạt động đơn vị tích luỹ Mảnh Sáng</h2>
          <div class="table-responsive">
            <table class="loyalty-table">
              <thead>
                <tr>
                  <th>Hoạt động của doanh nghiệp</th>
                  <th class="text-right" style="white-space: nowrap;">Số Mảnh Sáng nhận được</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Mỗi 10.000 VNĐ chi tiêu</td>
                  <td class="text-right highlight">+1 Mảnh Sáng</td>
                </tr>
                <tr>
                  <td>Đặt dự án đầu tiên</td>
                  <td class="text-right highlight">+100 Mảnh Sáng</td>
                </tr>
                <tr>
                  <td>Chốt brief và đặt lịch trước ít nhất 7 ngày</td>
                  <td class="text-right highlight">+50 Mảnh Sáng</td>
                </tr>
                <tr>
                  <td>Feedback sau dự án</td>
                  <td class="text-right highlight">+50 Mảnh Sáng</td>
                </tr>
                <tr>
                  <td>Cho phép Dear Musé sử dụng hình ảnh làm case study/portfolio</td>
                  <td class="text-right highlight">+150 Mảnh Sáng</td>
                </tr>
                <tr>
                  <td>Ký gói hợp tác từ 2 dự án trở lên</td>
                  <td class="text-right highlight">+200 Mảnh Sáng</td>
                </tr>
                <tr>
                  <td>Gia hạn theo tháng/quý</td>
                  <td class="text-right highlight">+200 Mảnh Sáng</td>
                </tr>
                <tr>
                  <td>Giới thiệu doanh nghiệp khác booking thành công</td>
                  <td class="text-right highlight">+300 Mảnh Sáng</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="loyalty-note">
            * Điểm Mảnh Sáng có thể dùng để đổi các Voucher đặc quyền cho doanh nghiệp.<br>
            * Tích lũy thông qua các dự án chụp ảnh sản phẩm, lookbook hoặc sự kiện để nâng cấp moodboard, ưu tiên lịch
            chụp, v.v.
          </p>
        </div>

        <!-- ═══ VOUCHER REDEMPTION SECTION FOR BUSINESS ═══ -->
        <div class="voucher-redeem-section">
          <div class="voucher-redeem-header">
            <span class="section-eyebrow">Đặc quyền doanh nghiệp</span>
            <h2>Quy Đổi Voucher Theo Mảnh Sáng</h2>
            <p>Sử dụng Mảnh Sáng tích luỹ để đổi lấy các dịch vụ hỗ trợ nâng tầm hình&nbsp;ảnh thương&nbsp;hiệu.</p>
          </div>

          <div class="biz-voucher-grid">

            <!-- FRAME COLUMN -->
            <div class="biz-voucher-col biz-col-frame">
              <div class="biz-col-header">
                <div class="biz-col-badge biz-badge-frame">MUSÉ FRAME</div>
                <div class="biz-col-range">0 – <%= (tierLimits.tier_limit_frame_lumiere - 1).toLocaleString('vi-VN') %>
                    Mảnh Sáng</div>
              </div>
              <div class="biz-voucher-list">
                <div class="biz-voucher-item">
                  <div class="biz-pts">200</div>
                  <div class="biz-pts-sep">✦</div>
                  <div class="biz-benefit">Giảm 100.000 VNĐ cho dự án tiếp theo</div>
                </div>
                <div class="biz-voucher-item">
                  <div class="biz-pts">300</div>
                  <div class="biz-pts-sep">✦</div>
                  <div class="biz-benefit">Tặng 3 ảnh crop social media</div>
