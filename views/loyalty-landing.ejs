              </div>
              <div class="biz-voucher-list">
                <div class="biz-voucher-item">
                  <div class="biz-pts">500</div>
                  <div class="biz-pts-sep">✦</div>
                  <div class="biz-benefit">Giảm 300.000 VNĐ cho dự án sau khi nâng hạng</div>
                </div>
                <div class="biz-voucher-item">
                  <div class="biz-pts">700</div>
                  <div class="biz-pts-sep">✦</div>
                  <div class="biz-benefit">Tặng social crop pack 10 ảnh</div>
                </div>
                <div class="biz-voucher-item">
                  <div class="biz-pts">1.000</div>
                  <div class="biz-pts-sep">✦</div>
                  <div class="biz-benefit">Tặng moodboard + shotlist cho chiến dịch</div>
                </div>
                <div class="biz-voucher-item">
                  <div class="biz-pts">1.500</div>
                  <div class="biz-pts-sep">✦</div>
                  <div class="biz-benefit">Ưu tiên preview ảnh trong 24h</div>
                </div>
              </div>
            </div>

          </div>

          <style>
            .biz-voucher-grid {
              display: grid;
              grid-template-columns: 1fr 1fr;
              gap: 24px;
              margin-bottom: 40px;
            }

            @media (max-width: 700px) {
              .biz-voucher-grid {
                grid-template-columns: 1fr;
              }
            }

            .biz-voucher-col {
              border-radius: 20px;
              overflow: hidden;
              border: 1px solid var(--bone, #EDE8DF);
              box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
            }

            .biz-col-header {
              padding: 20px 24px 18px;
              display: flex;
              align-items: center;
              justify-content: space-between;
              gap: 12px;
            }

            .biz-col-frame .biz-col-header {
              background: linear-gradient(135deg, #c8d0da 0%, #d8dde5 100%);
            }

            .biz-col-lumiere .biz-col-header {
              background: linear-gradient(135deg, #22252c 0%, #2c3038 100%);
            }

            .biz-col-badge {
              font-family: var(--font-display, serif);
              font-size: 1.05rem;
              font-weight: 600;
              letter-spacing: 0.04em;
              text-transform: uppercase;
            }

            .biz-badge-frame {
              color: #1e2228;
            }

            .biz-badge-lumiere {
              color: #f5d97a;
            }

            .biz-col-range {
              font-size: 0.7rem;
              letter-spacing: 0.08em;
              text-transform: uppercase;
              padding: 4px 10px;
              border-radius: 20px;
              white-space: nowrap;
            }

            .biz-col-frame .biz-col-range {
              background: rgba(30, 34, 40, 0.12);
              color: #3a4255;
            }

            .biz-col-lumiere .biz-col-range {
              background: rgba(212, 175, 55, 0.2);
              color: #f5d97a;
            }

            .biz-voucher-list {
              padding: 8px 0;
              background: var(--vanilla, #FFF7E6);
            }

            .biz-voucher-item {
              display: flex;
              align-items: center;
              gap: 0;
              padding: 14px 24px;
              border-bottom: 1px solid rgba(237, 232, 223, 0.7);
              transition: background 0.2s;
            }

            .biz-voucher-item:last-child {
              border-bottom: none;
            }

            .biz-voucher-item:hover {
              background: rgba(237, 232, 223, 0.35);
            }

            .biz-pts {
              font-family: var(--font-display, serif);
              font-size: 1.6rem;
              font-weight: 400;
              color: var(--mocha, #7A5C4A);
              min-width: 72px;
              line-height: 1;
              flex-shrink: 0;
            }

            .biz-pts-sep {
              color: var(--bone, #C8BAA8);
              font-size: 0.6rem;
              margin: 0 12px;
              flex-shrink: 0;
            }

            .biz-benefit {
              font-size: 0.9rem;
              color: var(--ink, #1A1916);
              line-height: 1.5;
              flex: 1;
            }
          </style>
        </div>


        <!-- ═══ SEASONAL & OCCASIONS SECTION FOR BUSINESS ═══ -->
        <div class="occasions-section" style="margin-top: 60px;">
          <div class="occasions-header" style="text-align: center; margin-bottom: 30px;">
            <span class="section-eyebrow">Dành Cho Doanh Nghiệp</span>
            <h3 style="font-family: var(--font-display, serif); font-size: 2rem; font-weight: bold; color: var(--ink);">
              Hệ Thống Voucher Đặc Quyền</h3>
          </div>

          <div class="elegant-table-wrap">
            <table class="elegant-table" style="width: 100%; border-collapse: collapse;">
              <thead>
                <tr style="border-bottom: 1px solid var(--bone);">
                  <th style="padding: 16px; text-align: center; font-weight: bold; color: var(--mocha);">Voucher</th>
                  <th style="padding: 16px; text-align: center; font-weight: bold; color: var(--mocha);">Musé Frame</th>
                  <th style="padding: 16px; text-align: center; font-weight: bold; color: var(--mocha);">Musé Lumière</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid rgba(237, 232, 223, 0.6);">
                  <td style="padding: 16px;"><strong>Welcome Brand</strong></td>
                  <td style="padding: 16px;">Giảm 100.000 VNĐ cho dự án thứ 2</td>
                  <td style="padding: 16px;">Giảm 300.000 VNĐ khi nâng hạng hoặc quy đổi sang 300 MS</td>
                </tr>
                <tr style="border-bottom: 1px solid rgba(237, 232, 223, 0.6);">
                  <td style="padding: 16px;"><strong>Event/Anniversary Voucher</strong></td>
                  <td style="padding: 16px;">Giảm add-on hoặc tặng ảnh recap<br>Voucher 5% dịp sinh nhật/thành lập
                    thương hiệu</td>
                  <td style="padding: 16px;">Voucher 8% + brand gift luxury</td>
                </tr>
                <tr style="border-bottom: 1px solid rgba(237, 232, 223, 0.6);">
                  <td style="padding: 16px;"><strong>Retainer Voucher</strong></td>
                  <td style="padding: 16px;">+300 Mảnh Sáng khi giới thiệu doanh nghiệp khác</td>
                  <td style="padding: 16px;">+300 Mảnh Sáng khi giới thiệu doanh nghiệp khác và trả ảnh nhanh trong 48
                    giờ</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <p class="voucher-redeem-note" style="margin-top: 40px; text-align: center;">Để đổi voucher hoặc xác nhận ưu
          đãi, vui lòng liên hệ trực tiếp qua fanpage hoặc hotline Dear Musé.</p>
      </div>
    </div>
    <% } else { %>
      <div class="loyalty-landing-page">
        <div class="container">
          <div class="loyalty-hero">
            <h1>The Musé Cards</h1>
            <p>Chương trình Khách Hàng Thân Thiết độc quyền của Dear&nbsp;Musé. Tích luỹ Mảnh&nbsp;Sáng sau mỗi lần trải
              nghiệm để nâng&nbsp;hạng&nbsp;thẻ và nhận những đặc&nbsp;quyền cá&nbsp;nhân&nbsp;hóa
              cao&nbsp;cấp&nbsp;nhất.
            </p>

            <% if (!sessionUser) { %>
              <button class="btn-primary" onclick="window.location.href='/auth/login?redirect=/loyalty'">Đăng Nhập Để Mở
                Thẻ</button>
              <% } else { %>
                <button class="btn-primary" id="btn-open-card">Tạo Thẻ Thành Viên Ngay</button>
                <% } %>
          </div>

          <!-- Cards Showcase -->
          <div class="cards-showcase">

            <!-- PEARL -->
            <div class="v-card tier-pearl">
              <div class="v-card-content">
                <div class="v-card-header">
                  <div class="v-card-brand">
                    <div class="v-card-brand-name">Dear Musé</div>
                    <div class="v-card-brand-sub">Studio · Member Card</div>
                  </div>
                  <div class="v-card-tier-badge">
                    <div class="v-card-tier-name">Pearl</div>
                    <div class="v-card-tier-dots"><span></span><span></span><span></span></div>
                  </div>
                </div>
                <div class="v-card-middle">
                  <div class="v-card-chip"></div>
                </div>
                <div class="v-card-footer">
                  <div class="v-card-number">DM26 •••• •••• 1001</div>
                  <div class="v-card-footer-row">
                    <div>
                      <div class="v-card-holder-label">Chủ thẻ</div>
                      <div class="v-card-name">Member Name</div>
                    </div>
                    <div class="v-card-tier-range">
                      <div class="v-card-tier-range-label">Mảnh Sáng</div>
                      <div class="v-card-tier-range-value">0 – <%= (tierLimits.tier_limit_pearl_rose -
                          1).toLocaleString('vi-VN') %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- ROSE -->
            <div class="v-card tier-rose">
              <div class="v-card-content">
                <div class="v-card-header">
                  <div class="v-card-brand">
                    <div class="v-card-brand-name">Dear Musé</div>
                    <div class="v-card-brand-sub">Studio · Member Card</div>
                  </div>
                  <div class="v-card-tier-badge">
                    <div class="v-card-tier-name">Rose</div>
                    <div class="v-card-tier-dots"><span></span><span></span><span></span></div>
                  </div>
                </div>
                <div class="v-card-middle">
                  <div class="v-card-chip"></div>
                </div>
                <div class="v-card-footer">
                  <div class="v-card-number">DM26 •••• •••• 2002</div>
                  <div class="v-card-footer-row">
                    <div>
                      <div class="v-card-holder-label">Chủ thẻ</div>
                      <div class="v-card-name">Member Name</div>
                    </div>
                    <div class="v-card-tier-range">
                      <div class="v-card-tier-range-label">Mảnh Sáng</div>
                      <div class="v-card-tier-range-value">
                        <%= tierLimits.tier_limit_pearl_rose.toLocaleString('vi-VN') %> – <%=
                            (tierLimits.tier_limit_rose_gold - 1).toLocaleString('vi-VN') %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- GOLD -->
            <div class="v-card tier-gold">
              <div class="v-card-content">
                <div class="v-card-header">
                  <div class="v-card-brand">
                    <div class="v-card-brand-name">Dear Musé</div>
                    <div class="v-card-brand-sub">Studio · Member Card</div>
                  </div>
                  <div class="v-card-tier-badge">
                    <div class="v-card-tier-name">Gold</div>
                    <div class="v-card-tier-dots"><span></span><span></span><span></span></div>
                  </div>
                </div>
                <div class="v-card-middle">
