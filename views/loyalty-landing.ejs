<%- contentFor('body') %>
  <link rel="stylesheet" href="/css/loyalty.css?v=13">

  <div class="loyalty-landing-page">
    <div class="container">
      <div class="loyalty-hero">
        <h1>The Musé Cards</h1>
        <p>Chương trình Khách Hàng Thân Thiết độc quyền của Dear Musé. Tích luỹ Mảnh Sáng sau mỗi lần trải nghiệm để
          nâng hạng thẻ và nhận những đặc quyền cá nhân hóa cao cấp nhất.</p>

        <% if (!sessionUser) { %>
          <button class="btn-primary" onclick="window.location.href='/auth/login?redirect=/loyalty'">Đăng Nhập Để Mở
            Thẻ</button>
          <% } else { %>
            <button class="btn-primary" id="btn-open-card">Tạo Thẻ Thành Viên Ngay</button>
            <% } %>
      </div>

      <!-- Cards Showcase -->
      <div class="cards-showcase">

        <!-- PEARL -->
        <div class="v-card tier-pearl">
          <div class="v-card-content">
            <div class="v-card-header">
              <div class="v-card-brand">
                <div class="v-card-brand-name">Dear Musé</div>
                <div class="v-card-brand-sub">Studio · Member Card</div>
              </div>
              <div class="v-card-tier-badge">
                <div class="v-card-tier-name">Pearl</div>
                <div class="v-card-tier-dots"><span></span><span></span><span></span></div>
              </div>
            </div>
            <div class="v-card-middle">
              <div class="v-card-chip"></div>
            </div>
            <div class="v-card-footer">
              <div class="v-card-number">DM26 •••• •••• 1001</div>
              <div class="v-card-footer-row">
                <div>
                  <div class="v-card-holder-label">Chủ thẻ</div>
                  <div class="v-card-name">Member Name</div>
                </div>
                <div class="v-card-tier-range">
                  <div class="v-card-tier-range-label">Mảnh Sáng</div>
                  <div class="v-card-tier-range-value">0 – 299</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ROSE -->
        <div class="v-card tier-rose">
          <div class="v-card-content">
            <div class="v-card-header">
              <div class="v-card-brand">
                <div class="v-card-brand-name">Dear Musé</div>
                <div class="v-card-brand-sub">Studio · Member Card</div>
              </div>
              <div class="v-card-tier-badge">
                <div class="v-card-tier-name">Rose</div>
                <div class="v-card-tier-dots"><span></span><span></span><span></span></div>
              </div>
            </div>
            <div class="v-card-middle">
              <div class="v-card-chip"></div>
            </div>
            <div class="v-card-footer">
              <div class="v-card-number">DM26 •••• •••• 2002</div>
              <div class="v-card-footer-row">
                <div>
                  <div class="v-card-holder-label">Chủ thẻ</div>
                  <div class="v-card-name">Member Name</div>
                </div>
                <div class="v-card-tier-range">
                  <div class="v-card-tier-range-label">Mảnh Sáng</div>
                  <div class="v-card-tier-range-value">300 – 799</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- GOLD -->
        <div class="v-card tier-gold">
          <div class="v-card-content">
            <div class="v-card-header">
              <div class="v-card-brand">
                <div class="v-card-brand-name">Dear Musé</div>
                <div class="v-card-brand-sub">Studio · Member Card</div>
              </div>
              <div class="v-card-tier-badge">
                <div class="v-card-tier-name">Gold</div>
                <div class="v-card-tier-dots"><span></span><span></span><span></span></div>
              </div>
            </div>
            <div class="v-card-middle">
              <div class="v-card-chip"></div>
            </div>
            <div class="v-card-footer">
              <div class="v-card-number">DM26 •••• •••• 3003</div>
              <div class="v-card-footer-row">
                <div>
                  <div class="v-card-holder-label">Chủ thẻ</div>
                  <div class="v-card-name">Member Name</div>
                </div>
                <div class="v-card-tier-range">
                  <div class="v-card-tier-range-label">Mảnh Sáng</div>
                  <div class="v-card-tier-range-value">800 – 1.499</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- PRIVILEGE -->
        <div class="v-card tier-privilege">
          <div class="v-card-content">
            <div class="v-card-header">
              <div class="v-card-brand">
                <div class="v-card-brand-name">Dear Musé</div>
                <div class="v-card-brand-sub">Studio · Member Card</div>
              </div>
              <div class="v-card-tier-badge">
                <div class="v-card-tier-name">Privilege</div>
                <div class="v-card-tier-dots"><span></span><span></span><span></span></div>
              </div>
            </div>
            <div class="v-card-middle">
              <div class="v-card-chip"></div>
            </div>
            <div class="v-card-footer">
              <div class="v-card-number">DM26 •••• •••• 4004</div>
              <div class="v-card-footer-row">
                <div>
                  <div class="v-card-holder-label">Chủ thẻ</div>
                  <div class="v-card-name">Member Name</div>
                </div>
                <div class="v-card-tier-range">
                  <div class="v-card-tier-range-label">Mảnh Sáng</div>
                  <div class="v-card-tier-range-value">1.500+</div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <div class="loyalty-info">
        <h2>Cơ chế hoạt động đơn vị tích luỹ Mảnh Sáng</h2>

        <div class="table-responsive">
          <table class="loyalty-table">
            <thead>
              <tr>
                <th>Hoạt động của khách hàng</th>
                <th class="text-right">Số Mảnh Sáng nhận được</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Mở thẻ thành viên thành công</td>
                <td class="text-right highlight">+30 Mảnh Sáng</td>
              </tr>
              <tr>
                <td>Mỗi 10.000 VNĐ chi tiêu tại Dear Musé</td>
                <td class="text-right highlight">+1 Mảnh Sáng</td>
              </tr>
              <tr>
                <td>Đặt lịch chụp lần đầu</td>
                <td class="text-right highlight">+50 Mảnh Sáng</td>
              </tr>
              <tr>
                <td>Quay lại chụp lần thứ 2 trở đi</td>
                <td class="text-right highlight">+80 Mảnh Sáng / Lần</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="loyalty-note">
          * Điểm Mảnh Sáng có thể dùng để đổi các Voucher giảm giá trực tiếp cho lần chụp tiếp theo.<br>
          * Lưu ý: Trong trường hợp khách hàng hủy lịch / bỏ cọc, Dear Musé có quyền thu hồi lại số Mảnh Sáng tương ứng.
        </p>
      </div>

      <!-- ═══ VOUCHER REDEMPTION SECTION ═══ -->
      <div class="voucher-redeem-section">
        <div class="voucher-redeem-header">
          <span class="section-eyebrow">Đặc quyền thành viên</span>
          <h2>Quy Đổi Voucher Theo Mảnh Sáng</h2>
          <p>Sử dụng Mảnh Sáng tích luỹ để đổi lấy các voucher giảm giá giá trị. Quy đổi từng phần — không cần tích đủ.</p>
        </div>

        <!-- 4 card cơ bản -->
        <div class="voucher-cards-grid">

          <!-- Glow -->
          <div class="vc-card vc-glow">
            <div class="vc-card-inner">
              <div class="vc-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              </div>
              <div class="vc-tier-label">Glow Voucher</div>
              <div class="vc-cost"><span class="vc-cost-num">80</span><span class="vc-cost-unit">Mảnh Sáng</span></div>
              <div class="vc-divider"></div>
              <div class="vc-value">Giảm <strong>50.000đ</strong></div>
              <div class="vc-desc">Cho bất kỳ gói chụp nào</div>
            </div>
          </div>

          <!-- Rose -->
          <div class="vc-card vc-rose">
            <div class="vc-card-inner">
              <div class="vc-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M12 22s-8-5-8-11a8 8 0 0 1 16 0c0 6-8 11-8 11z"/></svg>
              </div>
              <div class="vc-tier-label">Rose Voucher</div>
              <div class="vc-cost"><span class="vc-cost-num">200</span><span class="vc-cost-unit">Mảnh Sáng</span></div>
              <div class="vc-divider"></div>
              <div class="vc-value">Giảm <strong>100.000đ</strong></div>
              <div class="vc-desc">Cho bất kỳ gói chụp nào</div>
            </div>
          </div>

          <!-- Gold -->
          <div class="vc-card vc-gold">
            <div class="vc-card-inner">
              <div class="vc-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <div class="vc-tier-label">Gold Voucher</div>
              <div class="vc-cost"><span class="vc-cost-num">400</span><span class="vc-cost-unit">Mảnh Sáng</span></div>
              <div class="vc-divider"></div>
              <div class="vc-value">Giảm <strong>200.000đ</strong></div>
              <div class="vc-desc">Cho bất kỳ gói chụp nào</div>
            </div>
          </div>

          <!-- Signature teaser card -->
          <div class="vc-card vc-signature vc-signature-teaser">
            <div class="vc-signature-shimmer"></div>
            <div class="vc-card-inner">
              <div class="vc-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.35L7 14.14 2 9.27l6.91-1.01L12 2z"/><circle cx="12" cy="12" r="3" stroke-width="1"/></svg>
              </div>
              <div class="vc-tier-label">Signature Voucher</div>
              <div class="vc-cost vc-cost-range"><span class="vc-cost-num">500 – 1.500</span><span class="vc-cost-unit">Mảnh Sáng</span></div>
              <div class="vc-divider"></div>
              <div class="vc-value">Giảm sâu &amp; nâng cấp</div>
              <div class="vc-desc">Trải nghiệm cá nhân hoá cao cấp</div>
              <button class="vc-expand-btn" onclick="toggleSignatureDetail()">
                Xem chi tiết
                <svg class="vc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
          </div>

        </div>

        <!-- Signature Voucher Detail Card (premium, riêng) -->
        <div class="vc-signature-detail" id="signatureDetail">
          <div class="vc-sig-header">
            <div class="vc-sig-crown">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><path d="M2 20h20M4 20l2-8 4 4 2-8 2 8 4-4 2 8"/></svg>
            </div>
            <div>
              <div class="vc-sig-title">Signature Voucher</div>
              <div class="vc-sig-subtitle">Đặc quyền cao cấp — 3 tầng giá trị</div>
            </div>
          </div>

          <div class="vc-sig-tiers">

            <!-- Tier I — 500 MS -->
            <div class="vc-sig-tier tier-i">
              <div class="vc-sig-tier-badge">Tier I</div>
              <div class="vc-sig-tier-cost">
                <span class="vc-sig-ms">500</span>
                <span class="vc-sig-ms-label">Mảnh Sáng</span>
              </div>
              <div class="vc-sig-tier-divider"></div>
              <div class="vc-sig-tier-info">
                <div class="vc-sig-value">Giảm <strong>300.000đ</strong></div>
                <div class="vc-sig-perks">
                  <span>✓ Áp dụng cho bất kỳ gói chụp</span>
                  <span>✓ Hiệu lực 180 ngày</span>
                </div>
              </div>
            </div>

            <!-- Tier II — 800 MS -->
            <div class="vc-sig-tier tier-ii">
              <div class="vc-sig-tier-badge">Tier II</div>
              <div class="vc-sig-tier-cost">
                <span class="vc-sig-ms">800</span>
                <span class="vc-sig-ms-label">Mảnh Sáng</span>
              </div>
              <div class="vc-sig-tier-divider"></div>
              <div class="vc-sig-tier-info">
                <div class="vc-sig-value">Giảm <strong>500.000đ</strong></div>
                <div class="vc-sig-perks">
                  <span>✓ Áp dụng cho bất kỳ gói chụp</span>
                  <span>✓ Tặng 1 ảnh retouch chuyên sâu thêm</span>
                  <span>✓ Hiệu lực 180 ngày</span>
                </div>
              </div>
            </div>

            <!-- Tier III — 1500 MS -->
            <div class="vc-sig-tier tier-iii">
              <div class="vc-sig-tier-badge">Tier III</div>
              <div class="vc-sig-tier-cost">
                <span class="vc-sig-ms">1.500</span>
                <span class="vc-sig-ms-label">Mảnh Sáng</span>
              </div>
              <div class="vc-sig-tier-divider"></div>
              <div class="vc-sig-tier-info">
                <div class="vc-sig-value">Giảm <strong>20%</strong> toàn bộ gói</div>
                <div class="vc-sig-perks">
                  <span>✓ Tư vấn concept cá nhân hoá riêng</span>
                  <span>✓ Ưu tiên lịch chụp cao nhất</span>
                  <span>✓ Tặng 2 ảnh retouch chuyên sâu</span>
                  <span>✓ Hiệu lực 180 ngày</span>
                </div>
              </div>
            </div>

          </div>

          <p class="vc-sig-note">* Signature Voucher được tính từng tầng độc lập — bạn chỉ cần đủ điểm cho tầng muốn đổi. Liên hệ studio để xác nhận và nhận mã.</p>
        </div>

        <!-- ═══ SEASONAL & OCCASIONS SECTION ═══ -->
        <div class="occasions-section">
          <div class="occasions-header">
            <span class="section-eyebrow">Dành Cho Mọi Khoảnh Khắc</span>
            <h3>Quy Đổi Voucher Theo Dịp Đặc Biệt</h3>
          </div>

          <div class="elegant-table-wrap">
            <table class="elegant-table">
              <thead>
                <tr>
                  <th>Dịp</th>
                  <th>Quyền lợi</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Sinh nhật khách hàng</td>
                  <td>Giảm 5–20% tùy hạng thẻ</td>
                </tr>
                <tr>
                  <td>Mùa tốt nghiệp</td>
                  <td>Tặng ảnh retouch hoặc voucher nhóm</td>
                </tr>
                <tr>
                  <td>8/3, 20/10, Valentine</td>
                  <td>Ưu đãi concept nàng thơ</td>
                </tr>
                <tr>
                  <td>Khai trương concept mới</td>
                  <td>Early access cho Muse Gold và Muse Signature</td>
                </tr>
                <tr>
                  <td>Kỷ niệm 1 năm đồng hành</td>
                  <td>Tặng voucher tri ân hoặc ảnh in</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- ═══ REFERRAL PROGRAM SECTION ═══ -->
        <div class="referral-program-section">
          <div class="referral-header">
            <span class="section-eyebrow">Lan Toả Yêu Thương</span>
            <h3>Voucher Giới Thiệu Người Quen</h3>
          </div>

          <div class="elegant-table-wrap">
            <table class="elegant-table">
              <thead>
                <tr>
                  <th>Đối tượng / Cột mốc</th>
                  <th>Quyền lợi</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Người giới thiệu</td>
                  <td>+100 Mảnh Sáng hoặc voucher 100.000 VNĐ</td>
                </tr>
                <tr>
                  <td>Người được giới thiệu</td>
                  <td>Giảm 5% cho lần chụp đầu tiên</td>
                </tr>
                <tr>
                  <td>Giới thiệu từ 3 người trở lên 1 tháng</td>
                  <td>Nhận thêm voucher nâng cấp concept hoặc ảnh retouch</td>
                </tr>
                <tr>
                  <td>Giới thiệu 7 người trở lên 1 quý</td>
                  <td>Nhận level up thẻ thành viên</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <p class="voucher-redeem-note">
          Để đổi voucher hoặc xác nhận các ưu đãi trên, vui lòng liên hệ trực tiếp qua <strong>Facebook</strong> hoặc <strong>Instagram</strong> của Dear Musé,
          hoặc nhắn tin qua phần <a href="/contact" style="color:inherit; text-decoration:underline;">Liên hệ</a>.
          Mã voucher sẽ được gửi về email/SĐT đã đăng ký thành viên.
        </p>
      </div>

    </div>
  </div>

  <!-- Modal Đăng Ký Thẻ -->
  <div class="loyalty-modal" id="loyalty-modal">
    <div class="loyalty-modal-content">
      <button class="close-modal" id="close-modal">&times;</button>
      <h3
        style="margin-bottom: 20px; color: var(--ink, #1A1916); font-family: var(--font-display, serif); font-size: 1.8rem; text-align: center; font-weight: 500;">
        Mở Thẻ Thành Viên</h3>
      <form id="loyalty-form" action="/customer/loyalty/create" method="POST">
        <div class="loyalty-form-group">
          <label for="full_name">Họ và tên trên thẻ</label>
          <input type="text" id="full_name" name="full_name" required placeholder="VD: Nguyễn Văn A">
        </div>
        <div class="loyalty-form-group">
          <label for="dob">Ngày sinh</label>
          <input type="date" id="dob" name="dob" required>
        </div>
        <button type="submit" class="btn-primary btn-block">Xác Nhận Mở Thẻ</button>
      </form>
    </div>
  </div>

  <style>
  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap');

  .loyalty-hero p {
    font-family: 'Quicksand', 'DM Sans', sans-serif;
    font-weight: 500;
    color: #000000;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .loyalty-info h2 {
    font-size: clamp(1.4rem, 2.5vw, 2.2rem);
    white-space: nowrap;
  }
  @media (max-width: 768px) {
    .loyalty-info {
      padding: 35px 24px;
    }
  }
  @media (max-width: 600px) {
    .loyalty-info h2 {
      white-space: normal;
      font-size: 1.45rem;
    }
  }

  /* ──────────────── VOUCHER REDEMPTION SECTION ──────────────── */
  .voucher-redeem-section {
    margin-top: 80px;
    padding-top: 60px;
    border-top: 0.5px solid var(--bone, #EDE8DF);
  }
  .voucher-redeem-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .section-eyebrow {
    display: inline-block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--logo-taupe, #9C8474);
    margin-bottom: 12px;
  }
  .voucher-redeem-header h2 {
    font-family: var(--font-display, serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    color: var(--ink, #1A1916);
    margin-bottom: 12px;
  }
  .voucher-redeem-header p {
    font-family: 'Quicksand', 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 15px;
    color: #000000;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* 4-card grid */
  .voucher-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }
  @media (max-width: 900px) {
    .voucher-cards-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .voucher-cards-grid { grid-template-columns: 1fr; }
  }

  /* Base card */
  .vc-card {
    border-radius: 16px;
    padding: 2px;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .vc-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.1);
  }
  .vc-card-inner {
    background: #fff;
    border-radius: 14px;
    padding: 28px 20px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    height: 100%;
