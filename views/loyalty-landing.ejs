                </div>
                <div class="v-card-footer">
                  <div class="v-card-number">DM26 •••• •••• 3003</div>
                  <div class="v-card-footer-row">
                    <div>
                      <div class="v-card-holder-label">Chủ thẻ</div>
                      <div class="v-card-name">Member Name</div>
                    </div>
                    <div class="v-card-tier-range">
                      <div class="v-card-tier-range-label">Mảnh Sáng</div>
