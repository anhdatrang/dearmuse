        <script>
          const btnOpen = document.getElementById('btn-open-card');
          const modal = document.getElementById('loyalty-modal');
          const btnClose = document.getElementById('close-modal');

          if (btnOpen) {
            btnOpen.addEventListener('click', () => {
              modal.classList.add('active');
            });
          }

          if (btnClose) {
            btnClose.addEventListener('click', () => {
              modal.classList.remove('active');
            });
          }

          window.addEventListener('click', (e) => {
            if (e.target === modal) {
              modal.classList.remove('active');
            }
          });

          // Signature Voucher toggle
          function toggleSignatureDetail() {
            const detail = document.getElementById('signatureDetail');
            const btn = document.querySelector('.vc-expand-btn');
            const isOpen = detail.classList.contains('open');
            detail.classList.toggle('open', !isOpen);
            if (btn) btn.classList.toggle('open', !isOpen);
            if (!isOpen) {
              detail.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        </script>