              { name: 'Kỷ Yếu', desc: 'Ghi lại cột mốc thanh xuân rực rỡ và những kỷ niệm đáng nhớ.', price: 'Từ 1.800.000đ', slug: 'portrait-ky-yeu', details: ['Chụp ngoại cảnh hoặc studio', 'Hỗ trợ trang phục kỷ yếu', 'Trả toàn bộ file gốc', 'Retouch 15 ảnh đặc sắc'] }
