            ]
          },
          {
            id: 'ca-nhan',
            name: 'Cá Nhân',
            subtitle: 'Lưu giữ câu chuyện bản sắc',
            class: 'category-center',
            num: '02',
            image: '/cdn/image?src=%2Fsource%2FC%C3%81%20NH%C3%82N%2FCONCEPT%2FSU207836(1).webp',
            services: [
              { name: 'Concept', desc: 'Thiết kế concept nghệ thuật độc bản, bay bổng hoặc Áo dài truyền thống tôn vinh nét duyên dáng thanh lịch.', price: 'Từ 1.800.000đ', slug: 'portrait-concept', details: ['Concept Áo Dài cổ điển (từ 1.800.000đ)', 'Concept Nghệ Thuật độc bản (từ 2.500.000đ)', 'Lên ý tưởng & moodboard riêng biệt', 'Hỗ trợ trang phục thơ mộng / cổ điển', 'Retouch nghệ thuật chuyên sâu'] },
