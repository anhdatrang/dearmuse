<% pageCss='services.css?v=4' ; %>

  <!-- Services Page -->
  <section class="svc-split-section">
    <div class="container">
      <div class="text-center" style="margin-bottom: 80px;">
        <span class="section-label reveal" style="justify-content: center;">Dịch vụ</span>
        <h1 class="section-heading reveal" style="font-size: clamp(40px, 6vw, 64px);">Những gì chúng tôi làm</h1>
      </div>

      <!-- Cinematic Podium Layout -->
      <div class="svc-podium-container has-active reveal" data-delay="1">

          <% categories.forEach(cat=> { %>
            <div class="svc-podium-column <%= cat.class %> <%= cat.id === 'ca-nhan' ? 'active' : '' %>"
              data-category="<%= cat.id %>">
              <div class="svc-pillar-image-wrap">
                <img src="<%= cat.image %>" alt="<%= cat.name %>" loading="eager">
              </div>
              <h2 class="svc-pillar-title">
                <%= cat.name %>
              </h2>
              <button class="svc-pillar-arrow-btn" aria-label="Xem dịch vụ <%= cat.name %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>
            <% }) %>
      </div>

      <!-- Services Details View -->
      <div class="svc-details-container reveal" data-delay="2">
        <% const premiumSlugs = ['event-premium', 'portrait-concept', 'concept-an']; %>
        <% categories.forEach(cat=> { %>
          <div class="svc-panel <%= cat.id === 'ca-nhan' ? 'active' : '' %>" id="svc-panel-<%= cat.id %>">
            <% cat.services.forEach(s=> { %>
              <% const isPremium = premiumSlugs.includes(s.slug); %>
              <div class="svc-detail-card <%= isPremium ? 'premium-card' : 'basic-card' %>">
                <!-- Thêm phần lò xo ở đầu trang sách -->
                <div class="notebook-rings">
                  <div class="ring"></div>
                  <div class="ring"></div>
                  <div class="ring"></div>
                </div>

                <% if (isPremium) { %>
                  <div class="premium-badge">Nổi Bật</div>
                <% } %>

                <div class="svc-card-header">
                  <h3 class="svc-card-title">
                    <%= s.name %>
                  </h3>
                  <p class="svc-card-desc">
                    <%= s.desc %>
                  </p>
                </div>

                <ul class="svc-card-features">
                  <% s.details.forEach(detail=> { %>
                    <li>
                      <%= detail %>
                    </li>
                    <% }) %>
                </ul>

                <div class="svc-card-footer" style="justify-content: center;">
                  <a href="/services/<%= s.slug %>" class="btn btn-outline-dark"
                    style="border-radius: 30px; font-size: 11px; padding: 10px 20px;"><span>Xem thêm</span></a>
                </div>
              </div>
              <% }) %>
          </div>
          <% }) %>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <div style="max-width: 800px; margin: 0 auto;">
        <div class="text-center" style="margin-bottom: 64px;">
          <span class="section-label reveal" style="justify-content: center; color: var(--avocado-cream);">FAQ</span>
          <h2 class="section-heading reveal" style="color: var(--vanilla-cream);">Câu hỏi thường gặp</h2>
        </div>

        <div class="faq-list">
          <% const faqs=[ { q: 'Buổi chụp diễn ra như thế nào?' ,
            a: 'Trước buổi chụp, chúng tôi sẽ trao đổi sâu về concept, trang phục và địa điểm để đảm bảo đúng tinh thần bạn mong muốn. Trong khi chụp, ekip sẽ hướng dẫn pose dáng và tạo không khí thoải mái nhất để bạn là chính mình trước ống kính.'
            }, { q: 'Sau bao lâu tôi nhận được hình ảnh?' ,
            a: 'Ảnh gốc sẽ được gửi ngay sau buổi chụp để bạn chọn lựa. Ảnh đã chỉnh sửa kỹ lưỡng (retouch) sẽ được gửi lại trong vòng 5–7 ngày làm việc. Đối với các dự án lớn, thời gian có thể kéo dài 10–14 ngày.'
            }, { q: 'Studio có hỗ trợ trang điểm và trang phục không?' ,
            a: 'Tùy vào gói dịch vụ, chúng tôi có các chuyên gia trang điểm đối tác và kho trang phục cao cấp có sẵn. Bạn có thể chọn gói bao gồm toàn bộ (All-in) để chúng tôi lo từ A đến Z.'
            }, { q: 'Chính sách hủy hoặc dời lịch chụp?' ,
            a: 'Bạn vui lòng thông báo dời/hủy lịch ít nhất 48 giờ trước ngày chụp. Cọc sẽ được bảo lưu trong vòng 3 tháng để bạn sắp xếp lại thời gian phù hợp.'
            }, ]; %>

            <% faqs.forEach((faq, i)=> { %>
              <div class="faq-item reveal" data-delay="<%= i + 1 %>">
                <button class="faq-q" aria-expanded="false">
                  <%= faq.q %>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                      stroke-linecap="round" class="faq-icon">
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
                <div class="faq-a">
                  <p>
                    <%= faq.a %>
                  </p>
                </div>
              </div>
              <% }) %>
        </div>
      </div>
    </div>
  </section>

  <!-- Thank You Section -->
  <section class="svc-thankyou" id="svc-thankyou">
    <div class="svc-thankyou-inner">

      <!-- Quote with line-reveal animation -->
      <div class="svc-quote-wrap" id="svc-quote-wrap">
        <span class="svc-quote-line" id="svc-quote-line"></span>
        <blockquote class="svc-quote-text" id="svc-quote-text">
          "Mỗi khung hình kể một câu chuyện của riêng bạn."
        </blockquote>
      </div>

      <!-- Thank you message -->
      <div class="svc-thankyou-msg reveal">
        <p>Cảm ơn bạn đã dành thời gian</p>
        <p>tìm hiểu về <em>Dear Musé</em></p>
      </div>

    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // --- Podium Category Selector Interaction ---
      const columns = document.querySelectorAll('.svc-podium-column');
      const panels = document.querySelectorAll('.svc-panel');
      const container = document.querySelector('.svc-podium-container');

      if (columns.length > 0 && panels.length > 0) {
        columns.forEach(column => {
          column.addEventListener('click', () => {
            const targetId = column.getAttribute('data-category');

            // Update active class on columns
            columns.forEach(c => c.classList.remove('active'));
            column.classList.add('active');

            // Ensure container has active helper class
            if (container) {
              container.classList.add('has-active');
            }

            // Toggle details panel active state with smooth fade
            panels.forEach(panel => {
              if (panel.id === `svc-panel-${targetId}`) {
                panel.classList.add('active');
              } else {
                panel.classList.remove('active');
              }
            });

            // Scroll smoothly to details panel container if not already fully visible on click
            const detailsContainer = document.querySelector('.svc-details-container');
            if (detailsContainer && window.innerWidth <= 768) {
              detailsContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          });
        });
      }

      // FAQ Accordion
      document.querySelectorAll('.faq-q').forEach(btn => {
        btn.addEventListener('click', () => {
          const item = btn.closest('.faq-item');
          const isOpen = item.classList.contains('open');

          document.querySelectorAll('.faq-item').forEach(el => el.classList.remove('open'));

          if (!isOpen) item.classList.add('open');
          btn.setAttribute('aria-expanded', !isOpen);
        });
      });

      // ─── Quote Reveal Animation ───────────────────────────
      const quoteWrap = document.getElementById('svc-quote-wrap');
      const quoteLine = document.getElementById('svc-quote-line');
      const quoteText = document.getElementById('svc-quote-text');

      if (quoteWrap && quoteLine && quoteText) {
        let animated = false;

        const runQuoteAnimation = () => {
          if (animated) return;
          animated = true;

          // Phase 1: Gold line sweeps from left across the full width (0.7s)
          const fullWidth = quoteWrap.offsetWidth;
          quoteLine.style.transition = 'width 0.7s cubic-bezier(0.76, 0, 0.24, 1)';
          quoteLine.style.width = fullWidth + 'px';

          // Phase 2: At ~60% of line animation, start revealing the text
          setTimeout(() => {
            quoteWrap.classList.add('revealed');
          }, 420);

          // Phase 3: After text is fully revealed, fade out the line
          setTimeout(() => {
            quoteLine.style.transition = 'opacity 0.5s ease';
            quoteLine.style.opacity = '0';
          }, 1400);
        };

        // Use IntersectionObserver to trigger when section enters viewport
        const quoteObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              // Small delay so it feels intentional
              setTimeout(runQuoteAnimation, 200);
              quoteObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.4 });

        quoteObserver.observe(quoteWrap);
      }
    });
  </script>

