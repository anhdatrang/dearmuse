<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= metaDescription %>">
  
  <!-- CSS -->
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/feedback.css">
</head>
<body>

  <%- include('partials/nav') %>

  <div class="feedback-page">

    <!-- Lớp sương mù mờ ảo tĩnh lặng phía trên -->
    <div class="fog-overlay"></div>

    <!-- 🌺 BỘ SƯU TẬP HOA LÁ VẼ NGHỆ THUẬT (Botanical SVG Defs) -->
    <svg width="0" height="0" style="position: absolute;" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Shadows cho hiệu ứng 3D nhẹ nhàng -->
        <filter id="leaf-shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="2" dy="4" stdDeviation="3" flood-color="#4a3e35" flood-opacity="0.25"/>
        </filter>
        <filter id="flower-shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="3" dy="5" stdDeviation="4" flood-color="#4a3e35" flood-opacity="0.3"/>
        </filter>

        <!-- Màu sắc tinh tế, mang hơi hướng vintage painting -->
        <linearGradient id="leaf-grad-1" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#bac2a3"/>
          <stop offset="100%" stop-color="#7a8c66"/>
        </linearGradient>
        <linearGradient id="leaf-grad-2" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#9aa888"/>
          <stop offset="100%" stop-color="#5f6e4d"/>
        </linearGradient>

        <linearGradient id="petal-grad-1" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#fae3e3"/>
          <stop offset="100%" stop-color="#b06363"/>
        </linearGradient>
        <linearGradient id="petal-grad-2" x1="1" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#fff0f0"/>
          <stop offset="100%" stop-color="#a85959"/>
        </linearGradient>
        <!-- Thêm radial gradient để tạo chiều sâu vùng lõi hoa -->
        <radialGradient id="petal-grad-inner" cx="0%" cy="0%" r="100%">
          <stop offset="0%" stop-color="#692222"/>
          <stop offset="100%" stop-color="#d68383"/>
        </radialGradient>

        <!-- Component: Chiếc lá đơn -->
        <g id="art-leaf">
          <path d="M0,0 Q20,-20 40,0 Q20,20 0,0" fill="url(#leaf-grad-1)" filter="url(#leaf-shadow)"/>
          <!-- Gân chính -->
          <path d="M0,0 Q15,-2 40,0" stroke="#465239" stroke-width="1.5" fill="none" opacity="0.8"/>
          <!-- Gân phụ -->
          <path d="M10,0 Q15,-5 20,-8 M15,0 Q20,5 25,8 M25,0 Q30,-4 35,-6" stroke="#465239" stroke-width="0.8" fill="none" opacity="0.6"/>
        </g>
        
        <!-- Component: Chiếc lá sẫm màu -->
        <g id="art-leaf-dark">
          <path d="M0,0 Q20,-15 35,0 Q15,15 0,0" fill="url(#leaf-grad-2)" filter="url(#leaf-shadow)"/>
          <!-- Gân chính -->
          <path d="M0,0 Q15,-2 35,0" stroke="#2c3621" stroke-width="1.5" fill="none" opacity="0.8"/>
          <!-- Gân phụ -->
          <path d="M10,0 L15,-6 M18,0 L25,5 M25,0 L30,-4" stroke="#2c3621" stroke-width="0.8" fill="none" opacity="0.6"/>
        </g>

        <!-- Component: Hoa (Rose/Peony) -->
        <g id="art-flower">
          <!-- Bóng lót dưới để cánh ngoài nổi hơn -->
          <circle cx="0" cy="0" r="14" fill="#a36363" opacity="0.3" filter="url(#flower-shadow)"/>
          
          <!-- Lớp cánh lớn bên ngoài -->
          <path d="M0,0 C15,-25 35,-5 18,12 C8,25 -5,15 0,0" fill="url(#petal-grad-1)"/>
          <path d="M0,0 C25,-10 30,15 15,25 C-5,35 -15,10 0,0" fill="url(#petal-grad-2)" transform="rotate(72)"/>
          <path d="M0,0 C15,-25 35,-5 20,15 C5,30 -15,10 0,0" fill="url(#petal-grad-1)" transform="rotate(144)"/>
          <path d="M0,0 C25,-10 30,15 15,25 C-5,35 -15,10 0,0" fill="url(#petal-grad-2)" transform="rotate(216)"/>
          <path d="M0,0 C15,-25 35,-5 20,15 C5,30 -15,10 0,0" fill="url(#petal-grad-1)" transform="rotate(288)"/>

          <!-- Lớp cánh nhỏ bên trong tạo độ sâu 3D thật -->
          <path d="M0,0 C10,-15 20,-2 12,8 C4,15 -2,8 0,0" fill="url(#petal-grad-inner)" transform="rotate(30)"/>
          <path d="M0,0 C15,-8 18,10 8,15 C-2,20 -8,5 0,0" fill="url(#petal-grad-inner)" transform="rotate(102)"/>
          <path d="M0,0 C10,-15 20,-2 12,8 C4,15 -2,8 0,0" fill="url(#petal-grad-inner)" transform="rotate(174)"/>
          <path d="M0,0 C15,-8 18,10 8,15 C-2,20 -8,5 0,0" fill="url(#petal-grad-inner)" transform="rotate(246)"/>
          <path d="M0,0 C10,-15 20,-2 12,8 C4,15 -2,8 0,0" fill="url(#petal-grad-inner)" transform="rotate(318)"/>

          <!-- Chi tiết nhụy hoa tỉ mỉ -->
          <circle cx="0" cy="0" r="5" fill="#4a2c16" filter="url(#flower-shadow)"/>
          <circle cx="-2" cy="-2" r="1.5" fill="#f5d662"/>
          <circle cx="2" cy="-1" r="1.5" fill="#e8bc3a"/>
          <circle cx="0" cy="2" r="1.5" fill="#f5d662"/>
          <circle cx="-1" cy="1" r="1" fill="#fff" opacity="0.6"/>
          <circle cx="1" cy="-3" r="1" fill="#e8bc3a"/>
        </g>
      </defs>
    </svg>

    <!-- 🌿 Cành hoa trang trí rìa trái -->
    <div class="botanical-margin margin-left">
      <svg viewBox="0 0 200 800" width="100%" height="100%">
        <path d="M 0,0 Q 80,150 40,300 T 60,600 T 20,800" fill="none" stroke="#7a8c66" stroke-width="2" filter="url(#leaf-shadow)" opacity="0.8"/>
        
        <use href="#art-leaf" transform="translate(40, 50) rotate(45) scale(1.5)"/>
        <use href="#art-leaf-dark" transform="translate(60, 120) rotate(160) scale(1.2)"/>
        <use href="#art-leaf" transform="translate(50, 200) rotate(20) scale(1.8)"/>
        <use href="#art-flower" transform="translate(70, 160) rotate(10) scale(1.2)"/>
        
        <use href="#art-leaf-dark" transform="translate(30, 300) rotate(190) scale(1.4)"/>
        <use href="#art-leaf" transform="translate(45, 400) rotate(-10) scale(1.6)"/>
        <use href="#art-flower" transform="translate(20, 350) rotate(-15) scale(1.5)"/>

        <use href="#art-leaf-dark" transform="translate(65, 500) rotate(140) scale(1.3)"/>
        <use href="#art-leaf" transform="translate(50, 600) rotate(30) scale(1.7)"/>
        <use href="#art-flower" transform="translate(80, 550) rotate(45) scale(1.3)"/>
        
        <use href="#art-leaf-dark" transform="translate(25, 700) rotate(-40) scale(1.5)"/>
      </svg>
    </div>

    <!-- 🌿 Cành hoa trang trí rìa phải -->
    <div class="botanical-margin margin-right">
      <svg viewBox="0 0 200 800" width="100%" height="100%">
        <path d="M 200,50 Q 120,200 160,350 T 140,650 T 180,800" fill="none" stroke="#7a8c66" stroke-width="2" filter="url(#leaf-shadow)" opacity="0.8"/>
        
        <use href="#art-leaf-dark" transform="translate(160, 100) rotate(-130) scale(1.4)"/>
        <use href="#art-leaf" transform="translate(140, 180) rotate(-20) scale(1.6)"/>
        <use href="#art-flower" transform="translate(120, 150) rotate(20) scale(1.4)"/>
        
        <use href="#art-leaf" transform="translate(170, 280) rotate(-170) scale(1.3)"/>
        <use href="#art-leaf-dark" transform="translate(150, 380) rotate(-40) scale(1.7)"/>
        <use href="#art-flower" transform="translate(180, 350) rotate(-10) scale(1.2)"/>

        <use href="#art-leaf" transform="translate(135, 480) rotate(-150) scale(1.5)"/>
        <use href="#art-leaf-dark" transform="translate(150, 580) rotate(-10) scale(1.4)"/>
        <use href="#art-flower" transform="translate(130, 540) rotate(15) scale(1.6)"/>
        
        <use href="#art-leaf" transform="translate(175, 720) rotate(-160) scale(1.6)"/>
      </svg>
    </div>

    <!-- 🌟 Hero Section -->
    <section class="feedback-hero">
      <span class="hero-stamp">Dear Musé</span>
      <h1 class="feedback-hero-title">Nơi Chia Sẻ Cảm Xúc</h1>
      <p class="feedback-hero-desc">
        Những trang viết tay, ảnh kẹp vội, và cả những đóa hoa ép trên trang giấy. 
        Mọi cảm xúc của bạn đều được chúng tôi trân quý cất giữ trong không gian này.
      </p>
    </section>

    <!-- 📝 Alerts -->
    <% if (successMsg) { %>
      <div class="feedback-alert">
        ✨ Cảm ơn bạn! Lá thư của bạn đã được dán vào sổ.
      </div>
    <% } %>

    <!-- 🖼️ Scrapbook Canvas -->
    <section class="scrapbook-canvas">
      
      <!-- Bụi sương lấp lánh (Glowing Dust) -->
      <% 
        for(let i = 0; i < 20; i++) { 
          const top = Math.floor(Math.random() * 100);
          const left = Math.floor(Math.random() * 100);
          const dur = (Math.random() * 10 + 10).toFixed(1); // 10s - 20s
          const xShift = Math.floor(Math.random() * 150) - 75; // -75px to 75px
          const op = (Math.random() * 0.5 + 0.3).toFixed(2); // 0.3 to 0.8
      %>
        <div class="glowing-dust" style="top: <%= top %>%; left: <%= left %>%; --dust-dur: <%= dur %>s; --dust-x: <%= xShift %>px; --dust-op: <%= op %>;"></div>
      <% } %>

      <% 
        const styles = ['note-polaroid', 'note-torn', 'note-postcard'];
        
        // Hàm sinh clip-path răng cưa xé giấy ngẫu nhiên độc bản cho mỗi lá thư
        function getUniqueTornClipPath(styleClass, isFirstInRow) {
          let maxJaggedness = styleClass === 'note-polaroid' ? 0.8 : 3.5;
          if (isFirstInRow) maxJaggedness = 4.5; // Xé giấy nhiều hơn cho card đầu tiên
          const points = [];
          for (let x = 0; x <= 100; x += 10) {
            const y = (Math.random() * maxJaggedness).toFixed(1);
            points.push(`${x}% ${y}%`);
          }
          for (let y = 10; y <= 90; y += 10) {
            const x = (100 - Math.random() * maxJaggedness).toFixed(1);
            points.push(`${x}% ${y}%`);
          }
          for (let x = 100; x >= 0; x -= 10) {
            const y = (100 - Math.random() * maxJaggedness).toFixed(1);
            points.push(`${x}% ${y}%`);
          }
          for (let y = 90; y >= 10; y -= 10) {
            const x = (Math.random() * maxJaggedness).toFixed(1);
            points.push(`${x}% ${y}%`);
          }
          return `clip-path: polygon(${points.join(', ')});`;
        }

        // Chia feedbacks thành các hàng, mỗi hàng tối đa 3 note trên desktop
        const chunkSize = 3;
        const feedbackRows = [];
        for (let i = 0; i < feedbacks.length; i += chunkSize) {
          feedbackRows.push(feedbacks.slice(i, i + chunkSize));
        }

        feedbackRows.forEach((rowCards, rowIndex) => {
          const isEvenRow = rowIndex % 2 === 0;
          // Đường dây thừng uốn lượn nhẹ nhàng, đi ngang qua mép trên của các note
          const pathD = isEvenRow 
            ? "M 0 30 Q 250 50, 500 30 T 1000 30" 
            : "M 0 30 Q 250 10, 500 30 T 1000 30";
      %>
        <div class="scrapbook-row">
          <!-- Sợi dây thừng chạy dọc theo hàng này -->
          <div class="scrapbook-string-wrapper">
            <svg class="scrapbook-string-svg" viewBox="0 0 1000 60" preserveAspectRatio="none">
              <path d="<%= pathD %>" fill="none" stroke="#a4816c" stroke-width="4" stroke-linecap="round" />
              <path d="<%= pathD %>" fill="none" stroke="#bd9b84" stroke-width="4" stroke-linecap="round" stroke-dasharray="10 10" />
            </svg>
            
            <!-- Hoa lá rải rác bám trên dây -->
            <% 
              const decoCount = Math.floor(Math.random() * 8) + 6; // 6-13 điểm trang trí mỗi dây (Mật độ lá dày đặc)
              for(let j=0; j<decoCount; j++) { 
                const leftPos = Math.floor(Math.random() * 80) + 10; // 10% - 90%
                
                // Tính tọa độ Y của dây tại vị trí x
                let x = leftPos * 10;
                let cY = 30;
                if(x <= 500) {
                  let t1 = x / 500;
                  let cpY = isEvenRow ? 50 : 10;
                  cY = (1-t1)*(1-t1)*30 + 2*t1*(1-t1)*cpY + t1*t1*30;
                } else {
                  let t2 = (x - 500) / 500;
                  let cpY = isEvenRow ? 10 : 50;
                  cY = (1-t2)*(1-t2)*30 + 2*t2*(1-t2)*cpY + t2*t2*30;
                }
                const topPos = cY; 
                
                const isFlower = Math.random() > 0.85; // Tỉ lệ 15% hoa, 85% lá để lá chiếm phần lớn
                const rot = Math.floor(Math.random() * 360);
                const scale = (Math.random() * 0.4 + 0.6).toFixed(2);
            %>
              <div class="string-botanical" style="left: <%= leftPos %>%; top: <%= topPos %>px;">
                <svg viewBox="-50 -50 100 100" width="80" height="80" style="overflow: visible;">
                  <use href="<%= isFlower ? '#art-flower' : (Math.random()>0.5 ? '#art-leaf' : '#art-leaf-dark') %>" 
                       transform="rotate(<%= rot %>) scale(<%= scale %>)" />
                </svg>
              </div>
            <% } %>

            <div class="string-tape tape-left"></div>
            <div class="string-tape tape-right"></div>
          </div>

          <% 
            rowCards.forEach((f, index) => { 
              const globalIndex = rowIndex * chunkSize + index;
              const styleClass = styles[globalIndex % styles.length];
              const clipPathStyle = getUniqueTornClipPath(styleClass, index === 0);
              
              const rotation = Math.floor(Math.random() * 8) - 4; // Giảm góc xoay để ngay ngắn hơn trên dây
              
              // Tính toán margin-top dựa trên độ cong của dây tại vị trí tương đối
              let curveY = 30; // middle
              if (index === 0) curveY = isEvenRow ? 39 : 21; // left (16.6%)
              if (index === 1) curveY = 30; // center (50%)
              if (index === 2) curveY = isEvenRow ? 21 : 39; // right (83.3%)
              
              // Để băng dính (tâm ở 3px) khớp với dây (20 + curveY)
              const mt = curveY - 38; 
              
              const mb = Math.floor(Math.random() * 20) + 15;
              
              // Xê dịch lớn hơn giữa các hàng (hàng chẵn lệch trái, hàng lẻ lệch phải) để phá vỡ cấu trúc cột dọc thẳng hàng
              const staggerOffset = isEvenRow ? -35 : 35; 
              const shiftX = Math.floor(Math.random() * 30) - 15 + staggerOffset; 
              const shiftY = 0; // Cố định chiều cao để giữ dính dây
              
              // Tape có một độ xoay ngẫu nhiên nhỏ (gần với phương ngang của dây)
              const tapeRotation = Math.floor(Math.random() * 10) - 5;
              const floatDelay = (Math.random() * 5).toFixed(1);
          %>
            
            <div class="scrapbook-item-wrapper" 
                 style="margin-top: <%= mt %>px; margin-bottom: <%= mb %>px; z-index: <%= Math.floor(Math.random() * 30) + 10 %>; --float-delay: -<%= floatDelay %>s; --shift-x: <%= shiftX %>px; --shift-y: <%= shiftY %>px;">
              
              <% if (styleClass === 'note-polaroid' || styleClass === 'note-postcard' || styleClass === 'note-torn') { %>
                <div class="tape" style="transform: translateX(-50%) rotate(<%= tapeRotation %>deg);"></div>
              <% } %>
              
              <div class="<%= styleClass %> <%= f.is_featured ? 'is-featured' : '' %>" style="--rot: <%= rotation %>deg; transform: rotate(<%= rotation %>deg); <%= clipPathStyle %>">
    
                <div class="card-header">
                  <h3 class="card-name"><%= f.maskedName %></h3>
                  <div class="card-stars">
                    <% f.starsArr.forEach(isFilled => { %>
                      <span class="<%= isFilled ? 'filled' : 'empty' %>">★</span>
                    <% }) %>
                  </div>
                </div>
                
                <div class="card-content">
                  <%= f.content %>
                </div>
                
                <div class="card-footer">
                  <span><%- (f.service_label || 'Dịch vụ').split(' & ').map(p => p.replace(/ /g, '&nbsp;')).join(' & ') %></span>
                  <span><%= f.monthYear %></span>
                </div>
                
              </div>
              
            </div>
            
          <% }) %>
        </div>
      <% }) %>
    </section>

    <!-- ✍️ Submit Form Section (The Blank Page) -->
    <section class="feedback-form-section">
      <div class="form-container">
        
        <% if (sessionUser) { %>
          <form class="editorial-form" action="/feedback" method="POST">

            <div class="form-header">
              <h2>Viết Thư Gửi Musé</h2>
              <p>Trang giấy còn trống này dành cho những dòng cảm nhận của riêng bạn...</p>
            </div>

            <div class="form-group" style="margin-top: 30px;">
              <label>Mức độ hài lòng</label>
              <div class="star-rating-input">
                <input type="radio" id="star5" name="rating" value="5" checked>
                <label for="star5">★</label>
                <input type="radio" id="star4" name="rating" value="4">
                <label for="star4">★</label>
                <input type="radio" id="star3" name="rating" value="3">
                <label for="star3">★</label>
                <input type="radio" id="star2" name="rating" value="2">
                <label for="star2">★</label>
                <input type="radio" id="star1" name="rating" value="1">
                <label for="star1">★</label>
              </div>
            </div>

            <div class="form-row" style="display: flex; gap: 30px; flex-wrap: wrap;">
              <div class="form-group" style="flex: 1; min-width: 200px;">
                <label>Bạn là...</label>
                <select name="customer_type">
                  <option value="individual" <%= sessionUser.user_type === 'individual' ? 'selected' : '' %>>Khách hàng cá nhân</option>
                  <option value="business" <%= sessionUser.user_type === 'business' ? 'selected' : '' %>>Đại diện doanh nghiệp</option>
                </select>
              </div>
              <div class="form-group" style="flex: 1; min-width: 200px;">
                <label>Trải nghiệm dịch vụ</label>
                <select name="service_label">
                  <% services.forEach(s => { %>
                    <option value="<%= s.name %>"><%= s.name %></option>
                  <% }) %>
                  <option value="Khác">Khác</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label>Câu chuyện của bạn</label>
              <textarea name="content" placeholder="Kể cho Dear Musé nghe về những khoảnh khắc đẹp nhất..." required></textarea>
            </div>

            <button type="submit" class="btn-submit">Dán Vào Sổ Nhật Ký</button>
            
            <p style="text-align: center; font-size: 12px; color: var(--smoke); margin-top: 20px; font-style: italic;">
              * Tên của bạn sẽ được viết tắt (VD: Nguyễn Thị A → Ng. T. A.) để giữ sự riêng tư trọn vẹn.
            </p>
          </form>
        <% } else { %>
          <div class="login-prompt">
            <p>Hãy lưu tên mình vào cuốn sổ này nhé.</p>
            <a href="/auth/login?redirect=/feedback" class="btn-login">Đăng Nhập Để Viết Thư</a>
          </div>
        <% } %>

      </div>
    </section>

  </div>

  <%- include('partials/footer') %>
  <%- include('partials/mobile-menu') %>
  
  <script src="/js/main.js"></script>
  <script>
    /* BỎ JS PARALLAX ĐỂ CHỐNG GIẬT LAG. HIỆU ỨNG THỞ (FLOATING) ĐƯỢC XỬ LÝ BẰNG CSS THUẦN! */

    /* Show errors từ URL */
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('error')) {
      const errorMsg = urlParams.get('error');
      let msgText = 'Đã có lỗi xảy ra. Vui lòng thử lại sau.';
      if (errorMsg === 'empty') msgText = 'Vui lòng nhập nội dung.';
      if (errorMsg === 'rating') msgText = 'Vui lòng đánh giá số sao.';
      
      const alert = document.createElement('div');
      alert.className = 'feedback-alert alert-error';
      alert.innerText = '⚠️ ' + msgText;
      document.body.appendChild(alert);
      
      window.history.replaceState({}, document.title, "/feedback");
    }
  </script>
</body>
</html>
