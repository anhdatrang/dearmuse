<%
  pageCss = 'booking.css';
%>

<section style="padding-top: 120px; padding-bottom: var(--section-gap);">
  <div class="container" style="max-width: 500px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 48px;">
      <span class="section-label reveal">Khôi phục</span>
      <h1 class="section-heading reveal" style="font-size: clamp(28px, 4vw, 40px);">Đặt Lại Mật Khẩu</h1>
      <p class="body-text reveal" style="margin-top: 12px;">Vui lòng nhập mã OTP được gửi đến <strong><%= email %></strong> và mật khẩu mới.</p>
    </div>

    <div class="contact-form-section">
      <!-- Error & Success Notifications at the top of the card -->
      <% if (typeof error !== 'undefined' && error.length > 0) { %>
        <div class="error-list" style="margin-bottom: 24px;">
          <ul style="margin: 0; padding: 0; list-style: none;">
            <li><%= error[0] %></li>
          </ul>
        </div>
      <% } %>
      <% if (typeof success !== 'undefined' && success.length > 0) { %>
        <div class="flash-success" style="border-radius: 8px; margin-bottom: 24px; padding: 12px 16px; font-size: 13.5px;">
          <%= success[0] %>
        </div>
      <% } %>
      
      <!-- Client-side validation error box (hidden by default) -->
      <div class="error-list" id="client-error-box" style="display: none; margin-bottom: 24px;">
        <ul id="client-error-messages" style="margin: 0; padding: 0; list-style: none;">
        </ul>
      </div>

      <form method="POST" action="/auth/reset-password" novalidate>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= email %>" readonly style="background-color: rgba(0,0,0,0.02);">
        </div>

        <div class="form-group">
          <label for="otp">Mã OTP (6 chữ số) <span class="form-required">*</span></label>
          <input type="text" id="otp" name="otp" placeholder="123456" required autocomplete="off" maxlength="6" style="letter-spacing: 4px; text-align: center; font-size: 20px; font-weight: 500;">
        </div>
        
        <div class="form-group">
          <label for="password">Mật khẩu mới <span class="form-required">*</span></label>
          <input type="password" id="password" name="password" placeholder="••••••••" required minlength="6">
        </div>

        <button type="submit" class="btn btn-dark submit-btn" style="width: 100%; margin-top: 24px;">
          <span>Cập nhật mật khẩu →</span>
        </button>
      </form>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');
        const otpInput = document.getElementById('otp');
        const passwordInput = document.getElementById('password');
        const errorBox = document.getElementById('client-error-box');
        const errorList = document.getElementById('client-error-messages');
        
        [otpInput, passwordInput].forEach(input => {
          if (input) {
            input.addEventListener('input', function() {
              this.style.borderColor = '';
              hideErrorsIfEmpty();
            });
          }
        });

        function hideErrorsIfEmpty() {
          if (otpInput.style.borderColor === '' && passwordInput.style.borderColor === '') {
            errorBox.style.display = 'none';
          }
        }

        form.addEventListener('submit', function(e) {
          let errors = [];
          otpInput.style.borderColor = '';
          passwordInput.style.borderColor = '';
          
          const otpValue = otpInput.value.trim();
          if (!otpValue) {
            errors.push('Vui lòng nhập mã OTP.');
            otpInput.style.borderColor = '#ef4444';
          } else if (otpValue.length !== 6 || !/^\d+$/.test(otpValue)) {
            errors.push('Mã OTP phải gồm 6 chữ số.');
            otpInput.style.borderColor = '#ef4444';
          }
          
          const passwordValue = passwordInput.value;
          if (!passwordValue) {
            errors.push('Vui lòng nhập mật khẩu mới.');
            passwordInput.style.borderColor = '#ef4444';
          } else if (passwordValue.length < 6) {
            errors.push('Mật khẩu mới phải có ít nhất 6 ký tự.');
            passwordInput.style.borderColor = '#ef4444';
          }
          
          if (errors.length > 0) {
            e.preventDefault();
            errorList.innerHTML = '';
            errors.forEach(msg => {
              const li = document.createElement('li');
              li.textContent = msg;
              errorList.appendChild(li);
            });
            errorBox.style.display = 'block';
            errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        });
      });
    </script>

  </div>
</section>
