<%
  pageCss = 'booking.css';
%>

<section style="padding-top: 120px; padding-bottom: var(--section-gap);">
  <div class="container" style="max-width: 500px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 48px;">
      <span class="section-label reveal">Khôi phục</span>
      <h1 class="section-heading reveal" style="font-size: clamp(28px, 4vw, 40px);">Đặt Lại Mật Khẩu</h1>
      <p class="body-text reveal" style="margin-top: 12px;">Vui lòng nhập mã OTP được gửi đến <strong><%= email %></strong> và mật khẩu mới.</p>
    </div>

    <div class="contact-form-section">
      <form method="POST" action="/auth/reset-password" novalidate>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= email %>" readonly style="background-color: rgba(0,0,0,0.02);">
        </div>

        <div class="form-group">
          <label for="otp">Mã OTP (6 chữ số) <span class="form-required">*</span></label>
          <input type="text" id="otp" name="otp" placeholder="123456" required autocomplete="off" maxlength="6" style="letter-spacing: 4px; text-align: center; font-size: 20px; font-weight: 500;">
        </div>
        
        <div class="form-group">
          <label for="password">Mật khẩu mới <span class="form-required">*</span></label>
          <input type="password" id="password" name="password" placeholder="••••••••" required minlength="6">
        </div>

        <button type="submit" class="btn btn-dark submit-btn" style="width: 100%; margin-top: 24px;">
          <span>Cập nhật mật khẩu →</span>
        </button>
      </form>
    </div>

  </div>
</section>
